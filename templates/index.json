          "type": "faq",
          "settings": {
            "question": "What is Coastline?",
            "answer": "Coastline is a complete longevity supplement with 13 science-backed ingredients delivered in three daily steps: a morning blend, daily softgels, and evening capsules."
          }
        },
        "faq_yyj4kx": {
          "type": "faq",
          "settings": {
            "question": "How do I take it?",
            "answer": "Morning: mix one scoop of the Morning Blend with 8-12 oz of water. Take 1 softgel with your first meal. Evening: take 2 capsules 30-60 minutes before bed."
          }
        },
        "faq_Hydfyh": {
          "type": "faq",
          "settings": {
            "question": "When will I feel a difference?",
            "answer": "Most members notice improved energy and focus within the first 2-3 weeks. Sleep improvements often come sooner. Full benefits build over 60-90 days of consistent use."
          }
        },
        "faq_xtQtUB": {
          "type": "faq",
          "settings": {
            "question": "Is it safe to take with other supplements?",
            "answer": "Coastline is formulated in NSF certified facilities with well-studied ingredients at safe doses. However, we recommend consulting your healthcare provider if you take prescription medications."
          }
        },
        "faq_QT79aJ": {
          "type": "faq",
          "settings": {
            "question": "Can I cancel my subscription?",
            "answer": "Yes, cancel anytime with one click from your account dashboard. No penalties, no fees, no questions asked."
          }
        },
        "faq_FeDmVr": {
          "type": "faq",
          "settings": {
            "question": "Is Coastline vegan?",
            "answer": "Yes. All ingredients are vegan-friendly, including our glucosamine which is derived from a non-shellfish source."
          }
        },
        "faq_qNMFfU": {
          "type": "faq",
          "settings": {
            "question": "Do you offer a guarantee?",
            "answer": "Yes. We offer a 60-day money-back guarantee. If you do not notice a difference, contact us for a full refund."
          }
        },
        "faq_bFg8Aa": {
          "type": "faq",
          "settings": {
            "question": "How is Coastline different from AG1 or other greens?",

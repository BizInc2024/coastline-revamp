<style>
  .cc-pricing-db .cc-flavor-row, .cc-pricing-db .cc-plan-row { margin-top: 28px; }
  @media (min-width: 768px) {
    .cc-pricing-db .cc-pricing-layout { align-items: start !important; }
    .cc-pricing-db .cc-pricing-image { margin-top: 0 !important; align-self: start; }
  }
  .cc-pricing-db .cc-product-tabs { display: grid; grid-template-columns: 1fr 1fr; gap: 6px; margin: 0 0 28px; }
  .cc-pricing-db .cc-product-tabs button { font-family: 'Space Grotesk', sans-serif; font-weight: 500; font-size: 12px; letter-spacing: .12em; text-transform: uppercase; color: #062F3D; background: transparent; border: 1px solid rgba(6,47,61,.35); padding: 14px 8px; cursor: pointer; transition: opacity .2s ease; }

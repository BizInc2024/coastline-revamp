{%- liquid
  assign anchor = anchor | default: 'pricing-apr26'
  assign form_id = form_id | default: anchor | append: '-cart-form'
  assign pad_top = pad_top | default: 80
  assign pad_bottom = pad_bottom | default: 80
  assign label = label | default: section.settings.pricing_label
  assign headline = headline | default: section.settings.pricing_headline | default: 'Start Your System'
  assign trust_1 = trust_1 | default: section.settings.pricing_trust_1 | default: 'Free shipping. Cancel anytime.'
  assign trust_2 = trust_2 | default: section.settings.pricing_trust_2 | default: '60-day money-back guarantee.'
-%}

{%- comment -%}
  cc-pricing-db: deep-blue homepage pricing with a product selector.
  Complete System / Morning Blend / SoftGels / Evening Capsules.
  Variants, selling plans (ReCharge via Shopify selling plans) and prices are read live from Shopify.
{%- endcomment -%}
{%- liquid
  assign handles = 'coastline-welcome-pack,coastline-creatine,coastline-morning-softgels,coastline-evening-capsules' | split: ','
  assign keys = 'system,morning,softgels,evening' | split: ','
-%}
<script type="application/json" id="{{ anchor }}-data">
{
{%- for h in handles -%}
  {%- assign p = all_products[h] -%}
  {%- assign k = keys[forloop.index0] -%}
  "{{ k }}": {
    "handle": {{ h | json }},
    "variants": [
      {%- for v in p.variants -%}
      { "id": {{ v.id }}, "title": {{ v.title | json }}, "price": {{ v.price | money_without_trailing_zeros | json }},
        "plans": [
          {%- for a in v.selling_plan_allocations -%}
          { "id": {{ a.selling_plan.id }}, "name": {{ a.selling_plan.name | json }}, "price": {{ a.price | money_without_trailing_zeros | json }},
            "pct": {%- assign pct = 0 -%}{%- for adj in a.selling_plan.price_adjustments -%}{%- if adj.value_type == 'percentage' -%}{%- assign pct = adj.value -%}{%- endif -%}{%- endfor -%}{{ pct }} }{%- unless forloop.last -%},{%- endunless -%}
          {%- endfor -%}
        ] }{%- unless forloop.last -%},{%- endunless -%}
      {%- endfor -%}
    ],
    "images": [
      {%- for img in p.images limit: 10 -%}
      { "src": {{ img | image_url: width: 1000 | json }}, "alt": {{ img.alt | default: p.title | json }} }{%- unless forloop.last -%},{%- endunless -%}
      {%- endfor -%}
    ]
  }{%- unless forloop.last -%},{%- endunless -%}
{%- endfor -%}
}
</script>

<section id="{{ anchor }}" class="cc-pricing-apr26 cc-pricing-db" style="overflow:hidden !important;contain:layout paint !important;position:relative !important;z-index:0 !important;background-color:#E7FF56;padding-top:{{ pad_top }}px;padding-bottom:{{ pad_bottom }}px;"
  x-data="{
    data: JSON.parse(document.getElementById('{{ anchor }}-data').textContent),
    product: 'system',
    flavor: 0,
    plan: 'monthly',
    active: 0,
    copy: {
      system:   { name: 'Complete System',  headline: {{ headline | json | escape }}, sub: '30-day supply of Morning Blend, Softgels, and Evening Capsules', gift: true },
      morning:  { name: 'Morning Blend',    headline: 'Morning Blend',    sub: 'Mix with water and take with your first meal.', gift: false },
      softgels: { name: 'SoftGels',         headline: 'Morning SoftGels', sub: 'Take 1 SoftGel daily with your first meal.', gift: false },
      evening:  { name: 'Evening Capsules', headline: 'Evening Capsules', sub: 'Take 1 hour before bed.', gift: false }
    },
    systemImages: [
      { src: '{{ 'cc-welcome-box-vertical.png' | asset_url }}', alt: 'Coastline Welcome Pack' },
      { src: '{{ 'cc-sell-mb-card.jpg' | asset_url }}', alt: 'Morning Blend ingredients' },
      { src: '{{ 'cc-sell-sg-card.jpg' | asset_url }}', alt: 'Softgels ingredients' },
      { src: '{{ 'cc-sell-ec-card.jpg' | asset_url }}', alt: 'Evening Capsules ingredients' },
      { src: '{{ 'cc-sell-am-lifestyle.jpg' | asset_url }}', alt: 'AM routine' },
      { src: '{{ 'cc-sell-pm-lifestyle.jpg' | asset_url }}', alt: 'PM routine' },
      { src: '{{ 'cc-sell-ugc-brooke.jpg' | asset_url }}', alt: 'Customer review' },
      { src: '{{ 'cc-sell-pollock-quote.jpg' | asset_url }}', alt: 'Dr. Christopher Pollock, Senior Science Advisor' },
      { src: '{{ 'cc-sell-benefits.jpg' | asset_url }}', alt: 'Short and long-term benefits' },
      { src: '{{ 'cc-sell-standards.jpg' | asset_url }}', alt: 'Safest standards' },
      { src: '{{ 'cc-sell-clinical-proof.jpg' | asset_url }}', alt: 'Clinical proof' },
      { src: '{{ 'cc-sell-guarantee.jpg' | asset_url }}', alt: '60-day money-back guarantee' }
    ],
    pick(k) { this.product = k; this.flavor = 0; this.active = 0; if (this.plan !== 'onetime' && !this.planFor(this.plan)) this.plan = this.planFor('monthly') ? 'monthly' : 'onetime'; },
    get p() { return this.data[this.product]; },
    get v() { return this.p.variants[this.flavor] || this.p.variants[0]; },
    get images() { return this.product === 'system' ? this.systemImages : (this.p.images.length ? this.p.images : this.systemImages); },
    planFor(kind) {
      const ps = this.v.plans || [];
      if (kind === 'bimonthly') return ps.find(x => /2[ -]?month/i.test(x.name)) || null;
      if (kind === 'monthly') return ps.find(x => /1[ -]?month|monthly/i.test(x.name) && !/2[ -]?month/i.test(x.name)) || null;
      return null;
    },
    priceFor(kind) { const pl = this.planFor(kind); return kind === 'onetime' ? this.v.price : (pl ? pl.price : ''); },
    saveFor(kind) { const pl = this.planFor(kind); return pl && pl.pct ? 'Save ' + pl.pct + '%' : ''; },
    get sellingPlanId() { const pl = this.planFor(this.plan); return this.plan === 'onetime' || !pl ? null : pl.id; },
    get currentPrice() { return this.priceFor(this.plan) + (this.plan === 'onetime' ? '' : this.plan === 'bimonthly' ? ' every 2 months' : '/mo'); },
    get buttonText() { return 'ADD TO CART - ' + this.currentPrice; }
  }">
  <div class="cc-pricing-layout" style="max-width:1100px;margin:0 auto;padding:0 24px;">

    {%- comment -%} ── Image column ── {%- endcomment -%}
    <div class="cc-pricing-image">
      <div class="cc-sell-hero">
        <img :src="images[active] && images[active].src" :alt="images[active] && images[active].alt" width="1000" height="1000" style="width:100%;height:100%;object-fit:cover;display:block;" loading="lazy">
      </div>
      <div class="cc-sell-thumbs">
        <template x-for="(img, i) in images" :key="product + i">
          <button type="button" @click="active = i" :aria-pressed="active === i ? 'true' : 'false'" :class="active === i ? 'cc-thumb is-active' : 'cc-thumb'">
            <img :src="img.src" :alt="img.alt" width="1000" height="1000" style="width:100%;height:100%;object-fit:cover;display:block;" loading="lazy">
          </button>
        </template>
      </div>
    </div>

    {%- comment -%} ── Form column ── {%- endcomment -%}
    <div class="cc-pricing-form" style="text-align:center;">

      <div class="cc-product-tabs" role="tablist" aria-label="Choose a product">
        <button type="button" role="tab" @click="pick('system')" :aria-selected="product === 'system'" :class="product === 'system' && 'is-active'">Complete System</button>
        <button type="button" role="tab" @click="pick('morning')" :aria-selected="product === 'morning'" :class="product === 'morning' && 'is-active'">Morning Blend</button>
        <button type="button" role="tab" @click="pick('softgels')" :aria-selected="product === 'softgels'" :class="product === 'softgels' && 'is-active'">SoftGels</button>
        <button type="button" role="tab" @click="pick('evening')" :aria-selected="product === 'evening'" :class="product === 'evening' && 'is-active'">Evening Capsules</button>
      </div>

      {%- if label != blank -%}<span class="cc-pricing-eyebrow">{{ label }}</span>{%- endif -%}
      <h2 class="cc-pricing-headline" x-text="copy[product].headline">{{ headline }}</h2>
      <p class="cc-pricing-sub" x-text="copy[product].sub">30-day supply of Morning Blend, Softgels, and Evening Capsules</p>
      <p class="cc-pricing-sub cc-pricing-bonus" x-show="copy[product].gift">+ Glass Shaker WELCOME GIFT</p>

      <div class="cc-flavor-row" x-show="p.variants.length > 1">
        <p class="cc-selector-label">Choose your flavor</p>
        <div class="cc-flavor-buttons">
          <button type="button" @click="flavor = 0" :class="flavor === 0 ? 'cc-flavor-unflavored-active' : 'cc-flavor-unflavored-idle'" class="cc-flavor-btn">Unflavored Blend</button>
          <button type="button" @click="flavor = 1" :class="flavor === 1 ? 'cc-flavor-lemonade-active' : 'cc-flavor-lemonade-idle'" class="cc-flavor-btn">Coastal Lemonade</button>
        </div>
      </div>

      <div class="cc-plan-row">
        <p class="cc-selector-label">Select your plan</p>

        <div x-show="planFor('monthly')" @click="plan = 'monthly'" :class="plan === 'monthly' ? 'cc-plan-active' : 'cc-plan-idle'" class="cc-plan-card" style="margin-bottom:10px;position:relative;">
          <span class="cc-plan-flag" x-show="product === 'system'">LIMITED TIME OFFER</span>
          <div class="cc-plan-body">
            <div>
              <span class="cc-plan-label">Monthly subscription</span>
              <span class="cc-plan-save" x-text="saveFor('monthly')"></span>
              <span class="cc-plan-terms" style="display:block;font-size:12px;color:#6B6B6B;margin-top:4px;font-weight:400;letter-spacing:0;">Auto-renews — cancel anytime.</span>
            </div>
            <div class="cc-plan-price-col">
              <span class="cc-plan-price" x-text="priceFor('monthly')"></span>
              <span class="cc-plan-cadence">/month</span>
            </div>
          </div>
        </div>

        <div x-show="planFor('bimonthly')" @click="plan = 'bimonthly'" :class="plan === 'bimonthly' ? 'cc-plan-active' : 'cc-plan-idle'" class="cc-plan-card" style="margin-bottom:10px;">
          <div class="cc-plan-body">
            <div>
              <span class="cc-plan-label">Every 2 months</span>
              <span class="cc-plan-save" x-text="saveFor('bimonthly')"></span>
              <span class="cc-plan-terms" style="display:block;font-size:12px;color:#6B6B6B;margin-top:4px;font-weight:400;letter-spacing:0;">Auto-renews — cancel anytime.</span>
            </div>
            <div class="cc-plan-price-col">
              <span class="cc-plan-price" x-text="priceFor('bimonthly')"></span>
              <span class="cc-plan-cadence">every 2 months</span>
            </div>
          </div>
        </div>

        <div @click="plan = 'onetime'" :class="plan === 'onetime' ? 'cc-plan-active' : 'cc-plan-idle'" class="cc-plan-card">
          <div class="cc-plan-body">
            <div>
              <span class="cc-plan-label">One-time purchase</span>
              <span class="cc-plan-save cc-plan-save--muted">No subscription</span>
            </div>
            <div class="cc-plan-price-col">
              <span class="cc-plan-price" x-text="priceFor('onetime')"></span>
              <span class="cc-plan-cadence">one-time</span>
            </div>
          </div>
        </div>
      </div>

      <div x-show="plan !== 'onetime'" class="cc-atc-disclaimer" style="border:1px solid #D8D6CE;background:rgba(255,255,255,0.55);padding:14px 18px;margin:0 auto 14px;max-width:560px;font-family:'Inter',sans-serif;font-size:12px;line-height:1.5;color:#4A4A4A;text-align:left;">
        By subscribing you agree to recurring billing of <span x-text="currentPrice"></span> until you cancel. Cancel anytime in one click from your account — no fees, no penalties.
      </div>

      <div class="cc-atc-wrap">
        <form id="{{ form_id }}" action="/cart/add" method="post" is="product-form" data-type="add-to-cart-form">
          <input type="hidden" name="id" :value="v.id" />
          <template x-if="sellingPlanId">
            <input type="hidden" name="selling_plan" :value="sellingPlanId" />
          </template>
          <button type="submit" class="cc-atc-btn">
            <span class="btn-text"><span x-text="buttonText"></span></span>
          </button>
        </form>
      </div>

      <div class="cc-trust-lines">
        <p>{{ trust_1 }}</p>
        <p>{{ trust_2 }}</p>
      </div>

      <div class="cc-trust-meta">
        <p>VEGAN, SUGAR-FREE, CAFFEINE-FREE</p>
      </div>

      <div class="cc-trust-badges">
        <div class="cc-trust-badge"><img src="https://cdn.shopify.com/s/files/1/0619/6861/3445/files/istockphoto-1279030031-612x612_1.png?v=1767983702" alt="Third-party tested" loading="lazy"></div>
        <div class="cc-trust-badge"><img src="https://cdn.shopify.com/s/files/1/0619/6861/3445/files/download_1.png?v=1767983648" alt="GMP Certified" loading="lazy"></div>
        <div class="cc-trust-badge cc-trust-badge--large"><img src="{{ 'cc-made-in-usa.png' | asset_url }}" alt="Made in USA" loading="lazy"></div>
      </div>

    </div>
  </div>
</section>


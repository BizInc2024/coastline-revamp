{% comment %}
  CC-DEPS: Shared dependencies for custom Coastline sections
  Loads Google Fonts, Tailwind CSS, and Alpine.js
  Safe to render multiple times — each resource only loads once per page
{% endcomment %}

{% unless cc_deps_loaded %}
  {% assign cc_deps_loaded = true %}

  <!-- Google Fonts: Space Grotesk + Inter -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500&family=Space+Grotesk:wght@400;500;600&display=swap" rel="stylesheet">

  <!-- Tailwind CSS (compiled, only classes used in cc-* sections) -->
  {{ 'cc-tailwind.css' | asset_url | stylesheet_tag }}

  <!-- Alpine x-cloak: hide elements until Alpine initializes -->
  <style>[x-cloak] { display: none !important; }</style>

  <!-- Brand CSS variables for apr26 sections. The monolithic sections
       define these inside their own scoped blocks; apr26 sections need
       them defined once at the .cc-apr26 wrapper. Without this, calls
       like background:var(--parchment) silently fall back (e.g. the
       Final CTA button rendered transparent on dark Ocean). -->
  <style>
    .cc-apr26 {
      --parchment: #FAF9F6;
      --deep-ink: #0A0A0A;
      --warm-gray: #6B6B6B;
      --light-gray: #E8E8E8;
      --forest: #1A3A2F;
      --forest-light: #2D5A47;
      --ocean: #062F3D;
      --acid-lime: #E7FF56;
      --mist: #CCD7DA;
      --coastal-blue: #A3C7D0;
      --snow: #F7F7F7;
    }
  </style>

  <!-- Scroll-reveal (apr26 extracted sections only). Do NOT add
       .cc-homepage here: the monolith's reveal elements have no
       x-data ancestor, so x-intersect never fires and sections get
       stuck at opacity:0. -->
  <style>
    .cc-apr26 .reveal {
      opacity: 0;
      transform: translateY(24px);
      transition: opacity 0.8s ease, transform 0.8s ease;
    }
    .cc-apr26 .reveal.visible {
      opacity: 1;
      transform: translateY(0);
    }
  </style>

  <!-- Loading state for add-to-cart buttons -->
  <style>
    [is="product-form"] button[type="submit"][aria-busy="true"] .btn-text {
      visibility: hidden;
    }
    [is="product-form"] button[type="submit"][aria-busy="true"] {
      position: relative;
      pointer-events: none;
      opacity: 0.7;
    }
    [is="product-form"] button[type="submit"][aria-busy="true"]::after {
      content: '';
      position: absolute;
      top: 50%;
      left: 50%;
      width: 20px;
      height: 20px;
      margin: -10px 0 0 -10px;
      border: 2px solid rgba(250,249,246,0.3);
      border-top-color: #FAF9F6;
      border-radius: 50%;
      animation: cc-spin 0.6s linear infinite;
    }
    @keyframes cc-spin {
      to { transform: rotate(360deg); }
    }
  </style>

  <!-- Alpine.js — JS guard ensures only the first cc-deps render loads scripts.
       Uses async=false so plugins execute in order before Alpine initializes. -->
  <script>
    if (!window.__ccAlpineLoaded) {
      window.__ccAlpineLoaded = true;
      [
        'https://cdn.jsdelivr.net/npm/@alpinejs/intersect@3.x.x/dist/cdn.min.js',
        'https://cdn.jsdelivr.net/npm/@alpinejs/collapse@3.x.x/dist/cdn.min.js',
        'https://cdn.jsdelivr.net/npm/alpinejs@3.x.x/dist/cdn.min.js'
      ].forEach(function(src) {
        var s = document.createElement('script');
        s.async = false; s.src = src;
        document.head.appendChild(s);
      });
    }
  </script>

  {%- comment -%}
    Vanilla IntersectionObserver fallback for .cc-apr26 .reveal elements.
    Many apr26 sections wrap content in .reveal but don't have an x-data
    ancestor, so Alpine's x-intersect never registers and elements stick
    at opacity:0. This observer runs independently and reliably toggles
    .visible whenever a .reveal enters the viewport.
  {%- endcomment -%}
  <script>
    (function() {
      function initRevealObserver() {
        var nodes = document.querySelectorAll('.cc-apr26 .reveal:not(.visible), .cc-apr26 .reveal-stagger:not(.visible)');
        if (!nodes.length) return;
        if (!('IntersectionObserver' in window)) {
          nodes.forEach(function(n) { n.classList.add('visible'); });
          return;
        }
        var io = new IntersectionObserver(function(entries) {
          entries.forEach(function(e) {
            if (e.isIntersecting) {
              e.target.classList.add('visible');
              io.unobserve(e.target);
            }
          });
        }, { rootMargin: '0px 0px -10% 0px', threshold: 0.01 });
        nodes.forEach(function(n) { io.observe(n); });
      }
      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', initRevealObserver);
      } else {
        initRevealObserver();
      }
      // Re-run after Alpine boots in case sections are inserted late.
      window.addEventListener('load', initRevealObserver);
    })();
  </script>
{% endunless %}

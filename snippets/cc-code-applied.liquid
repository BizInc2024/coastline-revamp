{%- comment -%} Shows a slim bar when a discount code (e.g. from an email link) is saved on the cart. {%- endcomment -%}
<div id="cc-code-applied" hidden style="background:#E7FF56;color:#062F3D;font:600 13px/1.4 Helvetica,Arial,sans-serif;text-align:center;padding:9px 16px;letter-spacing:.02em;position:relative;z-index:50;">
  <span>&#10003; <strong id="cc-code-applied-code"></strong> applied: <span id="cc-code-applied-msg">50% off your first order. You'll see it in your cart and at checkout.</span></span>
</div>
<script>
(function(){
  var bar=document.getElementById('cc-code-applied');
  if(!bar) return;
  document.body.insertBefore(bar, document.body.firstChild);
  function check(){
    fetch('/cart.js',{credentials:'same-origin'}).then(function(r){return r.json()}).then(function(c){
      var codes=(c.discount_codes||[]).filter(function(d){return d && d.code});
      if(!codes.length){bar.hidden=true;return;}
      var code=codes[0].code.toUpperCase();
      document.getElementById('cc-code-applied-code').textContent=code;
      if(code.indexOf('50')===-1){document.getElementById('cc-code-applied-msg').textContent="your discount will show in your cart and at checkout.";}
      bar.hidden=false;
    }).catch(function(){});
  }
  check();
  document.addEventListener('visibilitychange',function(){if(!document.hidden)check();});
})();
</script>

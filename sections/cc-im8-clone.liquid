{% comment %}
  cc-vs-ag1-apr26 -- Coastline vs IM8 narrative section
  Extracted from sections/cc-landingpage-v6-ag1.liquid (Apr 26 rebuild).
  Pairs with cc-pricing-product-apr26 (cart) + cc-email-capture-apr26 inside
  templates/product.lp-ag1-apr26.json. Live LP (page.cc-landingpage-v6-ag1)
  remains untouched.
{% endcomment %}

{% render 'cc-deps' %}

<style>
    html { scroll-behavior: smooth; }
    .cc-vs-ag1-apr26 p { max-width: none !important; }
    .cc-vs-ag1-apr26 h1, .cc-vs-ag1-apr26 h2 { text-wrap: balance; }

    .editorial-divider { width: 60px; height: 1px; background: #0A0A0A; }
    .section-counter { font-family: 'Inter', sans-serif; font-size: 11px; font-weight: 400; letter-spacing: 0.15em; text-transform: uppercase; color: #6B6B6B; }

    .accordion-content { max-height: 0; overflow: hidden; transition: max-height 0.5s cubic-bezier(0.4, 0, 0.2, 1); }
    .accordion-content.open { max-height: 2000px; }

    .cc-vs-ag1-apr26 footer .cc-v6-footer-cta {
        display: inline-block !important; width: auto !important; min-width: 0 !important; min-height: 0 !important;
        padding: 20px 48px !important; margin: 0 !important; box-shadow: none !important; border-radius: 0 !important; border: none !important; box-sizing: border-box !important;
    }

    .v6-blockquote { font-family: 'Space Grotesk', sans-serif; font-size: clamp(28px, 5vw, 48px); font-weight: 500; line-height: 1.2; letter-spacing: -0.02em; color: #FAF9F6; }
    .v6-study-card { background: rgba(255,255,255,0.05); border: 1px solid rgba(255,255,255,0.1); padding: 32px; margin-top: 40px; }
    .v6-study-card li { display: flex; align-items: flex-start; gap: 12px; padding: 10px 0; font-size: 15px; color: #E0DED9; line-height: 1.55; }

    .v6-table-scroll { overflow-x: auto; display: block; }
    .v6-comparison-table { width: 100%; border-collapse: collapse; }
    .v6-comparison-table th, .v6-comparison-table td { padding: 16px 12px; text-align: left; border-bottom: 1px solid #E8E8E8; font-size: 14px; }
    .v6-comparison-table th { font-weight: 500; color: #0A0A0A; font-family: 'Space Grotesk', sans-serif; font-size: 12px; letter-spacing: 0.1em; text-transform: uppercase; }
    .v6-comparison-table td:first-child { color: #6B6B6B; min-width: 140px; }
    .v6-comparison-table .v6-check { color: #2D5A47; font-weight: 600; }
    .v6-comparison-table .v6-x { color: #C0392B; font-weight: 600; }

    .v6-star-table { width: 100%; border-collapse: collapse; }
    .v6-star-table th, .v6-star-table td { padding: 16px 12px; text-align: center; border-bottom: 1px solid #E8E8E8; }
    .v6-star-table th { font-weight: 500; font-family: 'Space Grotesk', sans-serif; font-size: 12px; letter-spacing: 0.1em; text-transform: uppercase; color: #0A0A0A; }
    .v6-star-table td:first-child { text-align: left; color: #6B6B6B; font-size: 14px; }
    .v6-star-table .v6-stars { letter-spacing: 2px; font-size: 16px; color: #0A0A0A; }
    .v6-star-table-dark th, .v6-star-table-dark td { border-bottom-color: rgba(250,249,246,0.1); }
    .v6-star-table-dark th { color: rgba(250,249,246,0.5); }
    .v6-star-table-dark td:first-child { color: rgba(250,249,246,0.6); }
    .v6-star-table-dark .v6-stars { color: #FAF9F6; }

    .v6-ingredient-card { border: 1px solid #E8E8E8; padding: 20px; text-align: center; }
    .v6-ingredient-card p:first-of-type { font-family: 'Space Grotesk', sans-serif; font-weight: 500; font-size: 15px; color: #0A0A0A; margin-bottom: 4px; }
    .v6-ingredient-card p:last-of-type { font-size: 12px; color: #6B6B6B; }

    .cc-vs-ag1-apr26 .btn-primary {
        display: inline-block;
        background-color: #0A0A0A;
        color: #FAF9F6;
        font-family: 'Space Grotesk', sans-serif;
        font-weight: 500;
        font-size: 12px;
        letter-spacing: 0.18em;
        text-transform: uppercase;
        padding: 20px 48px;
        text-decoration: none;
        transition: opacity 0.3s ease;
        cursor: pointer;
        border: none;
    }
    .cc-vs-ag1-apr26 .btn-primary:hover { opacity: 0.8; }

    /* Flavor selector active state */
    .cc-vs-ag1-apr26 .v6-flavor-btn { border: 1px solid #E8E8E8; padding: 16px; text-align: center; cursor: pointer; transition: all 0.2s ease; }
    .cc-vs-ag1-apr26 .v6-flavor-btn.active { border-color: #0A0A0A; box-shadow: 0 0 0 2px #0A0A0A; }

    /* Plan selector active state */
    .cc-vs-ag1-apr26 .v6-plan-btn { width: 100%; text-align: left; cursor: pointer; transition: all 0.2s ease; border: 1px solid #E8E8E8; padding: 16px; }
    .cc-vs-ag1-apr26 .v6-plan-btn.active { border: 2px solid #0A0A0A; }

    @media (prefers-reduced-motion: reduce) { .reveal { opacity: 1; transform: none; } }
</style>

<div class="cc-apr26 cc-vs-ag1-apr26" x-data="{ visibleReviews: 3 }">
    <!-- SECTION 1: EDITORIAL HERO -->
    <section id="hero" class="pt-2 pb-12 lg:pt-4 lg:pb-16 bg-parchment">
        <div class="max-w-3xl mx-auto px-6 sm:px-8 text-center">
            <div class="reveal" x-init="setTimeout(() => $el.classList.add('visible'), 100)" x-intersect="$el.classList.add('visible')">
                <p class="section-counter mb-6">{{ section.settings.hero_eyebrow | default: "SUPPLEMENT COMPARISON - UPDATED APRIL 2026" }}</p>
                <div class="editorial-divider mx-auto mb-10"></div>
                <h1 class="text-3xl md:text-4xl lg:text-5xl xl:text-6xl font-grotesk font-medium mb-8 leading-tight text-deep-ink">
                    {{ section.settings.hero_headline | default: 'Coastline vs IM8 Longevity: the trending molecules, or the proven ones?' }}
                </h1>

                <!-- Side-by-side product images -->
                <div class="grid grid-cols-2 gap-8 mb-10 max-w-2xl mx-auto items-end" style="min-height: 0;">
                    <div>
                        <img src="{% if section.settings.hero_coastline_image != blank %}{{ section.settings.hero_coastline_image | image_url: width: 600 }}{% else %}{{ 'cc-coastline-family-cutout.png' | asset_url }}{% endif %}" alt="Coastline" class="mx-auto block" style="max-height: 135px; object-fit: contain; object-position: bottom; margin-bottom: 28px;" loading="lazy">
                        <p class="text-xs tracking-widest uppercase text-deep-ink mt-4">Coastline</p>
                        <p class="text-xs text-warm-gray mt-1">13 clinical-dose ingredients</p>
                    </div>
                    <div>
                        <img src="{% if section.settings.hero_im8_image != blank %}{{ section.settings.hero_im8_image | image_url: width: 600 }}{% else %}{{ 'cc-im8-longevity-box.png' | asset_url }}{% endif %}" alt="IM8 Longevity" class="mx-auto block" style="max-height: 150px; max-width: 100%; object-fit: contain; object-position: bottom; margin-bottom: 13px;" loading="lazy">
                        <p class="text-xs tracking-widest uppercase text-warm-gray mt-4">IM8 Longevity</p>
                        <p class="text-xs text-warm-gray mt-1">10 trending molecules &middot; $119/mo</p>
                    </div>
                </div>

                <p class="text-lg lg:text-xl text-warm-gray mb-8 max-w-2xl mx-auto leading-relaxed">
                    {{ section.settings.hero_subheadline | default: "We don't chase longevity trends. We formulate around what's proven in humans -- and here's the side-by-side." }}
                </p>
                <div class="flex flex-col items-center gap-4 mt-6">
                    <a href="#v6-comparison-table" class="btn-primary">{{ section.settings.hero_cta_text | default: 'See the Full Comparison' }}</a>
                    <a href="#v6-comparison" class="link-underline" style="font-size:12px; color:var(--warm-gray);">SKIP TO PRICE COMPARISON</a>
                </div>
            </div>
        </div>
    </section>

    <!-- Bridge: setup the central idea (trendy vs proven) → IM8 Clinical Evidence -->
    <section class="py-12 lg:py-16 bg-white">
        <div class="max-w-2xl mx-auto px-6 sm:px-8">
            <div class="reveal" x-init="setTimeout(() => $el.classList.add('visible'), 100)" x-intersect="$el.classList.add('visible')">
                <h3 class="font-grotesk text-2xl lg:text-3xl font-medium text-deep-ink mb-8">{{ section.settings.bridge_1_headline | default: "Trendy isn't the same as proven." }}</h3>
                <p class="text-warm-gray text-lg leading-relaxed mb-6">
                    {{ section.settings.bridge_1_p1 | default: "IM8 Longevity is built on the molecules longevity marketing has hyped for a decade -- NMN, resveratrol, fisetin, spermidine. To their credit, IM8 discloses every dose. The problem isn't transparency. It's the evidence." }}
                </p>
                <p class="text-deep-ink text-lg leading-relaxed font-medium">
                    {{ section.settings.bridge_1_p3 | default: "Here's what the human research on those molecules actually shows." }}
                </p>
            </div>
        </div>
    </section>

    <!-- SECTION 3a: CLINICAL EVIDENCE (white) -->
    <section class="py-12 lg:py-20 bg-white">
        <div class="max-w-3xl mx-auto px-6 sm:px-8">
            <div class="reveal" x-init="setTimeout(() => $el.classList.add('visible'), 100)" x-intersect="$el.classList.add('visible')">
                <p class="section-counter mb-6">The Clinical Evidence</p>
                <div class="editorial-divider mb-10"></div>
                <p class="text-xs tracking-widest uppercase mb-6 text-warm-gray">{{ section.settings.study_label | default: "On IM8 Longevity's headline molecules:" }}</p>
                <ul class="space-y-4" style="border-top:1px solid #E8E8E8; padding-top:24px;">
                    <li class="flex gap-3 text-deep-ink leading-relaxed" style="font-size:17px;"><span style="color:#C0392B;flex-shrink:0;font-weight:600;">&#10007;</span> <span>{{ section.settings.study_1 | default: "NMN (300mg) -- a 2025 meta-analysis of 10 human trials found no benefit to strength, muscle, or physical function." }}</span></li>
                    <li class="flex gap-3 text-deep-ink leading-relaxed" style="font-size:17px;"><span style="color:#C0392B;flex-shrink:0;font-weight:600;">&#10007;</span> <span>{{ section.settings.study_2 | default: "Resveratrol (250mg) -- notoriously poor absorption; human longevity outcomes still unproven after 20 years of study." }}</span></li>
                    <li class="flex gap-3 text-deep-ink leading-relaxed" style="font-size:17px;"><span style="color:#C0392B;flex-shrink:0;font-weight:600;">&#10007;</span> <span>{{ section.settings.study_3 | default: "Fisetin, quercetin, spermidine -- senolytics with promising mouse data; human evidence is early-stage and mostly preclinical." }}</span></li>
                    <li class="flex gap-3 text-deep-ink leading-relaxed" style="font-size:17px;"><span style="color:#C0392B;flex-shrink:0;font-weight:600;">&#10007;</span> <span>{{ section.settings.study_4 | default: "Every dose is disclosed. What's missing is the human proof these molecules deliver the longevity they're sold on." }}</span></li>
                    <li class="flex gap-3 text-deep-ink leading-relaxed" style="font-size:17px;"><span style="color:#C0392B;flex-shrink:0;font-weight:600;">&#10007;</span> <span>{{ section.settings.study_5 | default: "$119/month -- for a formula built on promise, not proof." }}</span></li>
                </ul>
            </div>
        </div>
    </section>

    <!-- SECTION 3b: DAVID BECKHAM (dark) -->
    <section class="py-20 lg:py-28" style="background-color: #0A0A0A;">
        <div class="max-w-3xl mx-auto px-6 sm:px-8">
            <div class="reveal" x-init="setTimeout(() => $el.classList.add('visible'), 100)" x-intersect="$el.classList.add('visible')">
                <div class="flex flex-col md:flex-row items-center gap-8 md:gap-12" style="padding: 32px; background: rgba(255,255,255,0.03); border: 1px solid rgba(250,249,246,0.08); border-radius: 4px;">
                    <div class="flex-shrink-0">
                        <img src="{% if section.settings.bj_portrait != blank %}{{ section.settings.bj_portrait | image_url: width: 400 }}{% else %}{{ 'cc-v12-im8-beckham-portrait.webp' | asset_url }}{% endif %}" alt="David Beckham" class="w-20 h-20 md:w-24 md:h-24 rounded-full object-cover" style="border: 2px solid rgba(250,249,246,0.15);" loading="lazy">
                    </div>
                    <div>
                        <blockquote class="font-grotesk font-medium text-xl md:text-2xl leading-snug mb-4" style="color: #FAF9F6; text-wrap: balance;">
                            {{ section.settings.bj_quote | default: "When the formula doesn't have the evidence, the brand pays for endorsement&nbsp;instead." }}
                        </blockquote>
                        <p class="text-sm" style="color: rgba(250,249,246,0.5);">
                            {{ section.settings.bj_attribution | default: "-- David Beckham was reportedly paid an eight-figure sum plus co-founder equity to put his face on IM8. The longevity molecules inside are trending -- but most have no human trial showing they work at the doses used." }}
                        </p>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- COMMON GROUND (navy) — condensed, with ingredient images -->
    <section class="py-14 lg:py-20" style="background-color: #062F3D;">
        <div class="max-w-4xl mx-auto px-6 sm:px-8 reveal" x-init="setTimeout(() => $el.classList.add('visible'), 100)" x-intersect="$el.classList.add('visible')">
            <div class="text-center mb-10">
                <p class="text-xs tracking-widest uppercase mb-5" style="color: rgba(250,249,246,0.55);">Common Ground</p>
                <h2 class="text-2xl lg:text-3xl font-grotesk font-medium mb-3" style="color:#FAF9F6;">{{ section.settings.common_headline | default: 'Where the two formulas overlap' }}</h2>
                <p class="text-base max-w-lg mx-auto leading-relaxed" style="color:rgba(250,249,246,0.7);">{{ section.settings.common_intro | default: "Three ingredients appear in both. Look at the doses -- we formulate to the amounts used in the research." }}</p>
            </div>
            <div class="grid grid-cols-3 gap-3 sm:gap-5 max-w-3xl mx-auto">
                <div style="border:1px solid rgba(250,249,246,0.15); padding:16px 10px; text-align:center;">
                    <img src="https://cdn.shopify.com/s/files/1/0619/6861/3445/files/CL-13IngredientImages-v1_16_2.png?v=1767986425" alt="Taurine" style="width:44px;height:44px;object-fit:cover;margin:0 auto 8px;" loading="lazy">
                    <p class="font-grotesk" style="color:#FAF9F6; font-weight:500; font-size:15px;">Taurine</p>
                    <p style="font-size:13px; margin-top:6px; color:rgba(250,249,246,0.6);"><span style="color:#FAF9F6; font-weight:600;">3.05g</span> vs 2g</p>
                    <p style="color:#E7FF56; font-size:12px; margin-top:4px; font-weight:600;">~50% more</p>
                </div>
                <div style="border:1px solid rgba(250,249,246,0.15); padding:16px 10px; text-align:center;">
                    <img src="https://cdn.shopify.com/s/files/1/0619/6861/3445/files/CL-13IngredientImages-v1_2_2.png?v=1767987227" alt="Glycine" style="width:44px;height:44px;object-fit:cover;margin:0 auto 8px;" loading="lazy">
                    <p class="font-grotesk" style="color:#FAF9F6; font-weight:500; font-size:15px;">Glycine</p>
                    <p style="font-size:13px; margin-top:6px; color:rgba(250,249,246,0.6);"><span style="color:#FAF9F6; font-weight:600;">5g</span> vs 3g</p>
                    <p style="color:#E7FF56; font-size:12px; margin-top:4px; font-weight:600;">~65% more</p>
                </div>
                <div style="border:1px solid rgba(250,249,246,0.15); padding:16px 10px; text-align:center;">
                    <img src="https://cdn.shopify.com/s/files/1/0619/6861/3445/files/CL-13IngredientImages-v1_8_2.png?v=1767987168" alt="Astaxanthin" style="width:44px;height:44px;object-fit:cover;margin:0 auto 8px;" loading="lazy">
                    <p class="font-grotesk" style="color:#FAF9F6; font-weight:500; font-size:15px;">Astaxanthin</p>
                    <p style="font-size:13px; margin-top:6px; color:rgba(250,249,246,0.6);"><span style="color:#FAF9F6; font-weight:600;">6mg</span> vs 6mg</p>
                    <p style="color:rgba(250,249,246,0.55); font-size:12px; margin-top:4px;">Matched</p>
                </div>
            </div>
        </div>
    </section>


    <!-- SECTION 4: COMPARISON BREAKDOWN -->
    <section id="v6-comparison" class="py-20 lg:py-28 bg-white">
        <div class="max-w-5xl mx-auto px-6 sm:px-8">

            <!-- 5A: PRICE COMPARISON -->
            <div class="text-center mb-16 reveal" x-init="setTimeout(() => $el.classList.add('visible'), 100)" x-intersect="$el.classList.add('visible')">
                <p class="section-counter mb-6">Price Comparison</p>
                <div class="editorial-divider mx-auto mb-10"></div>
                <h2 class="text-3xl lg:text-4xl font-grotesk font-medium mb-4">{{ section.settings.price_headline | default: "What you're actually paying for" }}</h2>
            </div>

            <div class="grid md:grid-cols-2 gap-6 mb-20 reveal" x-init="setTimeout(() => $el.classList.add('visible'), 100)" x-intersect="$el.classList.add('visible')">
                <!-- Coastline Card -->
                <div class="border-2 border-deep-ink p-6 relative bg-parchment">
                    <span style="position: absolute; top: -12px; left: 16px; background: var(--forest-light); color: white; font-size: 10px; font-weight: 500; letter-spacing: 0.08em; padding: 4px 10px;">BETTER VALUE</span>
                    <div style="height: 230px; display: flex; align-items: flex-end; justify-content: center;" class="mb-4">
                        <img src="{% if section.settings.coastline_product_image != blank %}{{ section.settings.coastline_product_image | image_url: width: 600 }}{% else %}{{ 'cc-coastline-family-cutout.png' | asset_url }}{% endif %}" alt="Coastline" style="max-height: 210px; max-width: 100%; object-fit: contain; object-position: bottom; margin-bottom: 0;" loading="lazy">
                    </div>
                    <p class="text-xs tracking-widest uppercase text-warm-gray mb-2">Coastline</p>
                    <p class="text-4xl font-grotesk font-medium text-deep-ink mb-4">$99<span class="text-lg text-warm-gray">/month</span></p>
                    <div class="border-t border-light-gray pt-4 space-y-2 text-sm text-warm-gray">
                        <p>13 ingredients at clinical doses</p>
                        <p>~$7.62 per ingredient per month</p>
                        <p>$3.30/day</p>
                        <p>$1,188/year</p>
                        <p class="text-xs pt-2" style="color: #2D5A47;">Backed by human clinical evidence</p>
                    </div>
                </div>
                <!-- IM8 Card -->
                <div class="border border-light-gray p-6 bg-parchment">
                    <div style="height: 230px; display: flex; align-items: flex-end; justify-content: center; overflow: hidden;" class="mb-4">
                        <img src="{% if section.settings.ag1_product_image != blank %}{{ section.settings.ag1_product_image | image_url: width: 600 }}{% else %}{{ 'cc-im8-longevity-box.png' | asset_url }}{% endif %}" alt="IM8 Longevity" style="max-height: 200px; max-width: 100%; object-fit: contain; object-position: bottom; margin-bottom: 0;" loading="lazy">
                    </div>
                    <p class="text-xs tracking-widest uppercase text-warm-gray mb-2">IM8 Longevity</p>
                    <p class="text-4xl font-grotesk font-medium text-deep-ink mb-4">$119<span class="text-lg text-warm-gray">/month</span></p>
                    <div class="border-t border-light-gray pt-4 space-y-2 text-sm text-warm-gray">
                        <p>10 trending longevity molecules</p>
                        <p>~$11.90 per ingredient per month</p>
                        <p>$3.97/day</p>
                        <p>$1,428/year</p>
                        <p class="text-xs pt-2" style="color: #C0392B;">Unproven in humans -- promise over proof</p>
                    </div>
                </div>
            </div>

            <div class="text-center mb-20">
                <p class="text-warm-gray text-lg max-w-xl mx-auto leading-relaxed">
                    {{ section.settings.price_framing | default: "$0.67 a day less -- for ingredients with the human evidence to back them. You're not paying for trending molecules or a celebrity's face. You're paying for what's proven to work." }}
                </p>
            </div>

            <!-- 5B: INGREDIENT COMPARISON GRID -->
            <div id="v6-comparison-table" class="mb-20 reveal" style="scroll-margin-top: 80px;" x-init="setTimeout(() => $el.classList.add('visible'), 100)" x-intersect="$el.classList.add('visible')">
                <div class="text-center mb-12">
                    <p class="section-counter mb-6">Ingredient Comparison</p>
                    <div class="editorial-divider mx-auto mb-10"></div>
                    <h2 class="text-3xl lg:text-4xl font-grotesk font-medium">{{ section.settings.ingredient_comparison_headline | default: 'Side by side' }}</h2>
                </div>

                <div class="v6-table-scroll">
                    <table class="v6-comparison-table" style="min-width: 520px;">
                        <thead>
                            <tr>
                                <th style="min-width:160px;"></th>
                                <th style="text-align:center;">Coastline</th>
                                <th style="text-align:center;">IM8 Longevity</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr><td>Human evidence on lead actives</td><td class="v6-check" style="text-align:center;">&#10003; Established</td><td class="v6-x" style="text-align:center;">&#10007; Early / preclinical</td></tr>
                            <tr><td>Foundational actives</td><td class="v6-check" style="text-align:center;">Creatine, CoQ10 + 11 more</td><td class="v6-x" style="text-align:center;">Not in the formula</td></tr>
                            <tr><td>Built for morning &amp; night</td><td class="v6-check" style="text-align:center;">&#10003; AM + PM system</td><td class="v6-x" style="text-align:center;">&#10007; One morning sachet</td></tr>
                            <tr><td>Celebrity co-founder</td><td class="v6-check" style="text-align:center;">&#10003; None</td><td class="v6-x" style="text-align:center;">&#10007; Reported 8-figure deal</td></tr>
                            <tr><td>Price per month</td><td style="text-align:center; color:#0A0A0A; font-weight:600;">$99</td><td style="text-align:center; color:#6B6B6B;">$119</td></tr>
                        </tbody>
                    </table>
                </div>
            </div>

            <!-- 5C: EFFECTIVENESS -->
            <div class="grid md:grid-cols-2 gap-8 reveal" x-init="setTimeout(() => $el.classList.add('visible'), 100)" x-intersect="$el.classList.add('visible')">
                <div class="border border-light-gray p-8">
                    <p class="text-xs tracking-widest uppercase text-warm-gray mb-4">IM8 Longevity</p>
                    <ul class="space-y-3 text-warm-gray leading-relaxed text-sm">
                        <li class="flex gap-2"><span class="flex-shrink-0" style="color: #C0392B;">&#10007;</span> <span>Built around trending longevity molecules - NMN, resveratrol, fisetin, spermidine</span></li>
                        <li class="flex gap-2"><span class="flex-shrink-0" style="color: #C0392B;">&#10007;</span> <span>NMN (300mg) - no benefit to strength, muscle, or function in a 2025 meta-analysis of 10 human trials</span></li>

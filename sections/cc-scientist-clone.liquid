          <p class="exp-name">Dr. Nicolas Verhoeven, PhD</p>
          <p class="exp-role">Senior Formulation Advisor</p>
        </div>
        <div class="exp">
          <img class="exp-photo" src="https://cdn.shopify.com/s/files/1/0619/6861/3445/files/CL-ChrisP-Scientist.webp" alt="Dr. Christopher Pollock, MD" loading="lazy">

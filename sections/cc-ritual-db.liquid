{%- comment -%}
  cc-ritual-db — "Two moments a day" (Deep Blue homepage, Nov 2026).
  Two looping video cards: Morning (Blend + SoftGel) and Evening (Capsules).
  Directions copy is taken from the live PDPs; do not add doses that aren't there.
{%- endcomment -%}

{% render 'cc-deps' %}

<section class="cc-ritual-db" id="{{ section.settings.anchor | default: 'cc-ritual' }}">
  <div class="cc-ritual-db__inner">
    <p class="cc-ritual-db__eyebrow">{{ section.settings.eyebrow }}</p>
    <h2 class="cc-ritual-db__headline">{{ section.settings.headline }}</h2>
    <div class="cc-ritual-db__grid">
      {%- for block in section.blocks -%}
        <a class="cc-ritual-db__card" href="{{ block.settings.link | default: '#' }}" {{ block.shopify_attributes }}>
          <div class="cc-ritual-db__media">
            {%- if block.settings.video != blank -%}
              {{ block.settings.video | video_tag: autoplay: true, loop: true, muted: true, playsinline: true, controls: false, preload: 'metadata', image_size: '1280x' }}
            {%- elsif block.settings.poster != blank -%}
              <img src="{{ block.settings.poster | asset_url }}" alt="{{ block.settings.title | escape }}" width="1280" height="720" loading="lazy">
            {%- endif -%}
          </div>
          <div class="cc-ritual-db__copy">
            <p class="cc-ritual-db__when">{{ block.settings.when }}</p>
            <h3 class="cc-ritual-db__title">{{ block.settings.title }}</h3>
            <p class="cc-ritual-db__body">{{ block.settings.body }}</p>
            {%- if block.settings.link_text != blank -%}<span class="cc-ritual-db__more">{{ block.settings.link_text }}</span>{%- endif -%}
          </div>
        </a>
      {%- endfor -%}
    </div>
  </div>
</section>

<style>
  .cc-ritual-db { background: #F3EEE5 url({{ 'cc-sand-ripple.jpg' | asset_url }}) center / cover no-repeat; color: #062F3D; padding: 96px 24px; }
  .cc-ritual-db__inner { max-width: 1280px; margin: 0 auto; }
  .cc-ritual-db__eyebrow { font-family: 'Inter', sans-serif; font-size: 11px; letter-spacing: .2em; text-transform: uppercase; color: rgba(6,47,61,.7); margin: 0 0 16px; }
  .cc-ritual-db__headline { font-family: 'Space Grotesk', system-ui, sans-serif; font-weight: 500; font-size: clamp(30px, 4vw, 52px); letter-spacing: -.02em; line-height: 1.1; margin: 0 0 48px; color: #062F3D; }
  .cc-ritual-db__grid { display: grid; grid-template-columns: 1fr; gap: 40px; }
  .cc-ritual-db__card { display: block; text-decoration: none; color: inherit; }
  .cc-ritual-db__media { aspect-ratio: 16 / 9; overflow: hidden; background: #0b1820; }
  .cc-ritual-db__media video, .cc-ritual-db__media img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .cc-ritual-db__copy { padding-top: 20px; }
  .cc-ritual-db__when { font-family: 'Inter', sans-serif; font-size: 11px; letter-spacing: .2em; text-transform: uppercase; color: rgba(6,47,61,.6); margin: 0 0 8px; }
  .cc-ritual-db__title { font-family: 'Space Grotesk', sans-serif; font-weight: 500; font-size: 24px; letter-spacing: -.01em; margin: 0 0 8px; color: #062F3D; }
  .cc-ritual-db__body { font-family: 'Inter', sans-serif; font-size: 15px; line-height: 1.7; color: rgba(10,10,10,.75); margin: 0 0 14px; max-width: 460px; }
  .cc-ritual-db__more { font-family: 'Space Grotesk', sans-serif; font-size: 12px; letter-spacing: .15em; text-transform: uppercase; color: #062F3D; border-bottom: 1px solid rgba(6,47,61,.5); padding-bottom: 3px; }
  .cc-ritual-db__card:hover .cc-ritual-db__more { opacity: .75; }
  @media (min-width: 768px) {
    .cc-ritual-db { padding: 160px 64px; }
    .cc-ritual-db__grid { grid-template-columns: 1fr 1fr; gap: 32px; }
  }
  @media (prefers-reduced-motion: reduce) { .cc-ritual-db video { display: none; } }
</style>

{% schema %}
{
  "name": "Ritual videos (deep blue)",
  "tag": "section",
  "class": "section-cc-ritual-db",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "THE DAILY RITUAL" },
    { "type": "text", "id": "headline", "label": "Headline", "default": "Two moments a day." },
    { "type": "text", "id": "anchor", "label": "Section id", "default": "cc-ritual" }
  ],
  "blocks": [
    {
      "type": "moment",
      "name": "Moment",
      "settings": [
        { "type": "video", "id": "video", "label": "Video (16:9 loop)" },
        { "type": "text", "id": "poster", "label": "Poster (theme asset)" },
        { "type": "text", "id": "when", "label": "Label", "default": "MORNING" },
        { "type": "text", "id": "title", "label": "Title" },
        { "type": "textarea", "id": "body", "label": "Body" },
        { "type": "text", "id": "link_text", "label": "Link text" },
        { "type": "url", "id": "link", "label": "Link" }
      ]
    }
  ],
  "max_blocks": 4,
  "presets": [{ "name": "Ritual videos (deep blue)", "category": "Coastline" }]
}
{% endschema %}

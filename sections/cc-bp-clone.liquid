                        <p>~$7.62 per ingredient per month</p>
                        <p>$3.30/day</p>
                        <p>$1,188/year</p>
                        <p class="text-xs pt-2" style="color: #2D5A47;">Full transparency -- every dose disclosed</p>
                    </div>
                </div>
            </div>

            <div class="text-center mb-20">
                <p class="text-warm-gray text-lg max-w-xl mx-auto leading-relaxed">
                    {{ section.settings.price_framing | default: "Coastline costs $262/month less than the full Blueprint stack ($99 vs $361) and is built entirely from ingredients with strong human clinical evidence at clinical doses." }}
                </p>
            </div>

            <!-- 5B: INGREDIENT COMPARISON GRID -->

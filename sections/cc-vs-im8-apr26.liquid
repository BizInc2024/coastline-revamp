{% comment %}
  cc-vs-im8-apr26 — Coastline vs IM8 narrative section
  Extracted from sections/cc-landingpage-v6-ag1.liquid (Apr 26 rebuild).
  Pairs with cc-pricing-product-apr26 (cart) + cc-email-capture-apr26 inside
  templates/product.lp-ag1-apr26.json. Live LP (page.cc-landingpage-v6-ag1)
  remains untouched.
{% endcomment %}

{% render 'cc-deps' %}

<style>
    html { scroll-behavior: smooth; }
    .cc-vs-im8-apr26 p { max-width: none !important; }
    .cc-vs-im8-apr26 h1, .cc-vs-im8-apr26 h2 { text-wrap: balance; }

    .editorial-divider { width: 60px; height: 1px; background: #0A0A0A; }
    .section-counter { font-family: 'Inter', sans-serif; font-size: 11px; font-weight: 400; letter-spacing: 0.15em; text-transform: uppercase; color: #6B6B6B; }

    .accordion-content { max-height: 0; overflow: hidden; transition: max-height 0.5s cubic-bezier(0.4, 0, 0.2, 1); }
    .accordion-content.open { max-height: 2000px; }

    .cc-vs-im8-apr26 footer .cc-v6-footer-cta {
        display: inline-block !important; width: auto !important; min-width: 0 !important; min-height: 0 !important;
        padding: 20px 48px !important; margin: 0 !important; box-shadow: none !important; border-radius: 0 !important; border: none !important; box-sizing: border-box !important;
    }

    .v6-blockquote { font-family: 'Space Grotesk', sans-serif; font-size: clamp(28px, 5vw, 48px); font-weight: 500; line-height: 1.2; letter-spacing: -0.02em; color: #FAF9F6; }
    .v6-study-card { background: rgba(255,255,255,0.05); border: 1px solid rgba(255,255,255,0.1); padding: 32px; margin-top: 40px; }
    .v6-study-card li { display: flex; align-items: flex-start; gap: 12px; padding: 10px 0; font-size: 15px; color: #9A9A9A; }

    .v6-table-scroll { overflow-x: auto; display: block; }
    .v6-comparison-table { width: 100%; border-collapse: collapse; }
    .v6-comparison-table th, .v6-comparison-table td { padding: 16px 12px; text-align: left; border-bottom: 1px solid #E8E8E8; font-size: 14px; }
    .v6-comparison-table th { font-weight: 500; color: #0A0A0A; font-family: 'Space Grotesk', sans-serif; font-size: 12px; letter-spacing: 0.1em; text-transform: uppercase; }
    .v6-comparison-table td:first-child { color: #6B6B6B; min-width: 140px; }
    .v6-comparison-table .v6-check { color: #2D5A47; font-weight: 600; }
    .v6-comparison-table .v6-x { color: #C0392B; font-weight: 600; }

    .v6-star-table { width: 100%; border-collapse: collapse; }
    .v6-star-table th, .v6-star-table td { padding: 16px 12px; text-align: center; border-bottom: 1px solid #E8E8E8; }
    .v6-star-table th { font-weight: 500; font-family: 'Space Grotesk', sans-serif; font-size: 12px; letter-spacing: 0.1em; text-transform: uppercase; color: #0A0A0A; }
    .v6-star-table td:first-child { text-align: left; color: #6B6B6B; font-size: 14px; }
    .v6-star-table .v6-stars { letter-spacing: 2px; font-size: 16px; color: #0A0A0A; }
    .v6-star-table-dark th, .v6-star-table-dark td { border-bottom-color: rgba(250,249,246,0.1); }
    .v6-star-table-dark th { color: rgba(250,249,246,0.5); }
    .v6-star-table-dark td:first-child { color: rgba(250,249,246,0.6); }
    .v6-star-table-dark .v6-stars { color: #FAF9F6; }

    .v6-ingredient-card { border: 1px solid #E8E8E8; padding: 20px; text-align: center; }
    .v6-ingredient-card p:first-of-type { font-family: 'Space Grotesk', sans-serif; font-weight: 500; font-size: 15px; color: #0A0A0A; margin-bottom: 4px; }
    .v6-ingredient-card p:last-of-type { font-size: 12px; color: #6B6B6B; }

    .cc-vs-im8-apr26 .btn-primary {
        display: inline-block;
        background-color: #0A0A0A;
        color: #FAF9F6;
        font-family: 'Space Grotesk', sans-serif;
        font-weight: 500;
        font-size: 12px;
        letter-spacing: 0.18em;
        text-transform: uppercase;
        padding: 20px 48px;
        text-decoration: none;
        transition: opacity 0.3s ease;
        cursor: pointer;
        border: none;
    }
    .cc-vs-im8-apr26 .btn-primary:hover { opacity: 0.8; }

    /* Flavor selector active state */
    .cc-vs-im8-apr26 .v6-flavor-btn { border: 1px solid #E8E8E8; padding: 16px; text-align: center; cursor: pointer; transition: all 0.2s ease; }
    .cc-vs-im8-apr26 .v6-flavor-btn.active { border-color: #0A0A0A; box-shadow: 0 0 0 2px #0A0A0A; }

    /* Plan selector active state */
    .cc-vs-im8-apr26 .v6-plan-btn { width: 100%; text-align: left; cursor: pointer; transition: all 0.2s ease; border: 1px solid #E8E8E8; padding: 16px; }
    .cc-vs-im8-apr26 .v6-plan-btn.active { border: 2px solid #0A0A0A; }

    @media (prefers-reduced-motion: reduce) { .reveal { opacity: 1; transform: none; } }
</style>

<div class="cc-apr26 cc-vs-im8-apr26" x-data="{ visibleReviews: 3 }">
    <!-- SECTION 1: EDITORIAL HERO -->
    <section id="hero" class="pt-2 pb-12 lg:pt-4 lg:pb-16 bg-parchment">
        <div class="max-w-3xl mx-auto px-6 sm:px-8 text-center">
            <div class="reveal" x-init="setTimeout(() => $el.classList.add('visible'), 100)" x-intersect="$el.classList.add('visible')">
                <p class="section-counter mb-6">{{ section.settings.hero_eyebrow | default: 'SUPPLEMENT COMPARISON - UPDATED APRIL 2026' }}</p>
                <div class="editorial-divider mx-auto mb-10"></div>
                <h1 class="text-3xl md:text-4xl lg:text-5xl xl:text-6xl font-grotesk font-medium mb-8 leading-tight text-deep-ink">
                    {{ section.settings.hero_headline | default: 'Coastline vs IM8: 92 Ingredients, or 13 You Can Actually Feel?' }}
                </h1>
                <p class="text-lg lg:text-xl text-warm-gray mb-8 max-w-2xl mx-auto leading-relaxed">
                    {{ section.settings.hero_subheadline | default: 'IM8 is Beckham-backed, $154 a month, and 92 ingredients deep — most of them hidden behind proprietary blends. We compared the formulas, the doses, the price, and what 13 clinical-dose ingredients actually delivers.' }}
                </p>
                <div class="flex flex-col items-center gap-4 mt-6">
                    <a href="#v6-comparison" class="btn-primary">{{ section.settings.hero_cta_text | default: 'See the Full Comparison' }}</a>
                    <a href="#v6-takeaways" class="link-underline" style="font-size:12px; color:var(--warm-gray);">SKIP TO THE KEY TAKEAWAYS</a>
                </div>

                <!-- Side-by-side product images -->
                <div class="grid grid-cols-2 gap-8 mt-16 max-w-2xl mx-auto items-end">
                    <div>
                        <img src="{% if section.settings.hero_coastline_image != blank %}{{ section.settings.hero_coastline_image | image_url: width: 600 }}{% else %}https://cdn.shopify.com/s/files/1/0619/6861/3445/files/Family_Vert_-_CL_2_20aeec91-5477-425f-84e0-5ea21f9239ad.png?v=1769186113{% endif %}" alt="Coastline" class="mx-auto" style="max-height: 240px; object-fit: contain;" loading="lazy">
                        <p class="text-xs tracking-widest uppercase text-deep-ink mt-4">Coastline</p>
                        <p class="text-xs text-warm-gray mt-1">13 clinical-dose ingredients</p>
                    </div>
                    <div>
                        <img src="{% if section.settings.hero_im8_image != blank %}{{ section.settings.hero_im8_image | image_url: width: 600 }}{% else %}{{ 'cc-v12-im8-product.webp' | asset_url }}{% endif %}" alt="IM8" class="mx-auto" style="max-height: 240px; object-fit: contain;" loading="lazy">
                        <p class="text-xs tracking-widest uppercase text-warm-gray mt-4">IM8</p>
                        <p class="text-xs text-warm-gray mt-1">92 ingredients, doses undisclosed</p>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- SECTION 2: NEUTRAL INTRO -->
    <section class="pt-2 pb-12 lg:pt-4 lg:pb-16 bg-parchment">
        <div class="max-w-2xl mx-auto px-6 sm:px-8">
            <div class="reveal" x-init="setTimeout(() => $el.classList.add('visible'), 100)" x-intersect="$el.classList.add('visible')">
                <p class="text-warm-gray text-lg leading-relaxed">
                    {{ section.settings.intro_body_1 | default: "IM8 launched with a billion-dollar marketing engine and a David Beckham endorsement. Promising 92+ ingredients, all 12 hallmarks of aging, and \"engineered greatness\" in every scoop. We compared it side by side with Coastline -- a science-first longevity system built around 13 fully-disclosed ingredients at clinical doses. We looked at what's actually inside, what each ingredient does at its labeled dose, and what you're paying $154 a month for." }}
                </p>
            </div>
        </div>
    </section>

    <!-- Bridge: Intro → IM8 Clinical Evidence -->
    <section class="py-12 lg:py-16 bg-white">
        <div class="max-w-2xl mx-auto px-6 sm:px-8">
            <div class="reveal" x-init="setTimeout(() => $el.classList.add('visible'), 100)" x-intersect="$el.classList.add('visible')">
                <h3 class="font-grotesk text-2xl lg:text-3xl font-medium text-deep-ink mb-8">{{ section.settings.bridge_1_headline | default: "What's actually in your $154 scoop?" }}</h3>
                <p class="text-warm-gray text-lg leading-relaxed mb-6">
                    {{ section.settings.bridge_1_p1 | default: "IM8 launched on Beckham's name. The marketing is everywhere -- football pitches, Instagram, premium magazines. It became a supplement people bought because the man who sold it to them looked great in a kit." }}
                </p>
                <p class="text-warm-gray text-lg leading-relaxed mb-6">
                    {{ section.settings.bridge_1_p2 | default: "But here's what gets harder to find: the doses. IM8 lists 92+ ingredients on the label, then groups most of them into proprietary blends. You see a total milligram count for the blend -- never the amount of any single ingredient inside it." }}
                </p>
                <p class="text-deep-ink text-lg leading-relaxed font-medium">
                    {{ section.settings.bridge_1_p3 | default: "And that matters. Because every clinical study on these ingredients tested a specific dose. If your scoop doesn't hit it, you're not getting the benefit -- no matter how many ingredients are listed." }}
                </p>
            </div>
        </div>
    </section>

    <!-- CTA: After bridge 1 -->
    <div class="py-8 text-center bg-white">
        <a href="#pricing-product-apr26" style="display:inline-block;font-family:'Space Grotesk',sans-serif;font-size:12px;letter-spacing:0.1em;text-transform:uppercase;text-decoration:underline;text-underline-offset:4px;color:#6B6B6B;transition:opacity 0.3s ease;" onmouseover="this.style.opacity='0.6'" onmouseout="this.style.opacity='1'">SKIP TO PRICING</a>
    </div>

    <!-- Divider Image -->
    <div class="w-full">
        <img src="{% if section.settings.breaker_image_pre_bj != blank %}{{ section.settings.breaker_image_pre_bj | image_url: width: 1600 }}{% else %}https://cdn.shopify.com/s/files/1/0619/6861/3445/files/canon-beach-haystack_1.png?v=1764011837{% endif %}" alt="" class="w-full" style="max-height: 40vh; object-fit: cover;" loading="lazy">
    </div>

    <!-- SECTION 3: IM8 CLINICAL EVIDENCE -->
    <section class="py-20 lg:py-32" style="background-color: #0A0A0A;">
        <div class="max-w-3xl mx-auto px-6 sm:px-8">
            <div class="reveal" x-init="setTimeout(() => $el.classList.add('visible'), 100)" x-intersect="$el.classList.add('visible')">
                <p class="text-xs tracking-widest uppercase mb-8" style="color: rgba(250,249,246,0.4);">What IM8 Doesn't Show You</p>
                <div style="width:60px; height:1px; background:rgba(250,249,246,0.2); margin-bottom:40px;"></div>

                <!-- What's hidden behind the label -->
                <div class="v6-study-card mb-12">
                    <p class="text-xs tracking-widest uppercase mb-6" style="color: rgba(250,249,246,0.5);">{{ section.settings.study_label | default: "On IM8's Daily Ultimate Label:" }}</p>
                    <ul>
                        <li><span style="color: #C0392B; flex-shrink: 0;">&#10007;</span> {{ section.settings.study_1 | default: 'Most ingredients hidden inside proprietary blends -- individual doses not disclosed' }}</li>
                        <li><span style="color: #C0392B; flex-shrink: 0;">&#10007;</span> {{ section.settings.study_2 | default: '92+ active compounds split across one daily scoop -- single-digit milligrams each' }}</li>
                        <li><span style="color: #C0392B; flex-shrink: 0;">&#10007;</span> {{ section.settings.study_3 | default: 'No published clinical trial showing the formula outperforms placebo' }}</li>
                        <li><span style="color: #C0392B; flex-shrink: 0;">&#10007;</span> {{ section.settings.study_4 | default: 'Headline ingredients (CaAKG, NMN, spermidine) at unverifiable amounts' }}</li>
                        <li><span style="color: #C0392B; flex-shrink: 0;">&#10007;</span> {{ section.settings.study_5 | default: '$154/month for the bundle -- premium pricing, premium opacity' }}</li>
                    </ul>
                </div>

                <!-- Marketing-first vs science-first framing -->
                <div class="flex flex-col md:flex-row items-center gap-8 md:gap-12 mt-12 mb-12" style="padding: 32px; background: rgba(255,255,255,0.03); border: 1px solid rgba(250,249,246,0.08); border-radius: 4px;">
                    <div class="flex-shrink-0">
                        <img src="{% if section.settings.bj_portrait != blank %}{{ section.settings.bj_portrait | image_url: width: 400 }}{% else %}{{ 'cc-v12-im8-beckham-portrait.webp' | asset_url }}{% endif %}" alt="David Beckham, IM8 co-founder" class="w-20 h-20 md:w-24 md:h-24 rounded-full object-cover" style="border: 2px solid rgba(250,249,246,0.15);" loading="lazy">
                    </div>
                    <div>
                        <blockquote class="font-grotesk font-medium text-xl md:text-2xl leading-snug mb-4" style="color: #FAF9F6;">
                            {{ section.settings.bj_quote | default: "&ldquo;A celebrity face doesn't make a clinical formula.&rdquo;" }}
                        </blockquote>
                        <p class="text-sm" style="color: rgba(250,249,246,0.5);">
                            {{ section.settings.bj_attribution | default: '-- David Beckham fronts and co-founded IM8. He is not a researcher.' }}
                        </p>
                    </div>
                </div>

                <div>
                    <h3 class="font-grotesk font-medium text-xl mb-4" style="color: #FAF9F6;">{{ section.settings.pixie_dust_headline | default: 'The pixie dusting problem' }}</h3>
                    <p class="leading-relaxed mb-8" style="color: #9A9A9A; font-size: 16px;">
                        {{ section.settings.pixie_dust_body | default: "IM8 lists 92+ ingredients in a single scoop. That sounds impressive until you do the math. Picture pouring one glass of water across 92 cups -- each gets drops. That is what happens when you cram 92 ingredients into one serving: most are present in trace amounts, far below what any clinical trial actually used. \"Pixie dusting\" lets a brand list an ingredient on the panel without paying for an effective dose." }}
                    </p>
                </div>
            </div>
        </div>
    </section>

    <!-- CTA: After clinical evidence -->
    <div class="py-10 text-center bg-parchment">
        <a href="#pricing-product-apr26" style="display:inline-block;background:#0A0A0A;color:#FAF9F6;font-family:'Space Grotesk',sans-serif;font-weight:500;font-size:12px;letter-spacing:0.18em;text-transform:uppercase;padding:20px 48px;text-decoration:none;transition:opacity 0.3s ease;" onmouseover="this.style.opacity='0.8'" onmouseout="this.style.opacity='1'">START MY LONGEVITY SYSTEM</a>
    </div>

    <!-- Bridge: David Beckham → Comparison -->
    <section class="py-16 lg:py-20 bg-parchment">
        <div class="max-w-2xl mx-auto px-6 sm:px-8">
            <div class="reveal" x-init="setTimeout(() => $el.classList.add('visible'), 100)" x-intersect="$el.classList.add('visible')">
                <h3 class="font-grotesk text-2xl lg:text-3xl font-medium text-deep-ink mb-8">{{ section.settings.bridge_2_headline | default: "So we pulled the data" }}</h3>
                <p class="text-warm-gray text-lg leading-relaxed mb-6">
                    {{ section.settings.bridge_2_p1 | default: "That is a lot to take in. A product fronted by one of the most recognizable athletes in the world, sold at a premium price, and the doses inside most of its 92+ ingredients are hidden behind proprietary blends." }}
                </p>
                <p class="text-warm-gray text-lg leading-relaxed mb-6">
                    {{ section.settings.bridge_2_p2 | default: "So we did what any rational person would do. We pulled the publicly available labels on both IM8 and Coastline and laid them side by side. Not marketing claims. Just the ingredients, the doses (where disclosed), and the price." }}
                </p>
                <p class="text-deep-ink text-lg leading-relaxed font-medium mb-8">
                    {{ section.settings.bridge_2_p3 | default: "Here is exactly what we found when we compared them head to head." }}
                </p>
                <div class="text-center">
                    <a href="#pricing-product-apr26" class="link-underline" style="font-size:12px; color:var(--warm-gray);">SKIP AHEAD TO PRICING</a>
                </div>
            </div>
        </div>
    </section>

    <!-- SECTION 4: COMPARISON BREAKDOWN -->
    <section id="v6-comparison" class="py-20 lg:py-28 bg-white">
        <div class="max-w-5xl mx-auto px-6 sm:px-8">

            <!-- 5A: PRICE COMPARISON -->
            <div class="text-center mb-16 reveal" x-init="setTimeout(() => $el.classList.add('visible'), 100)" x-intersect="$el.classList.add('visible')">
                <p class="section-counter mb-6">Price Comparison</p>
                <div class="editorial-divider mx-auto mb-10"></div>
                <h2 class="text-3xl lg:text-4xl font-grotesk font-medium mb-4">{{ section.settings.price_headline | default: "What you're actually paying for" }}</h2>
            </div>

            <div class="grid md:grid-cols-2 gap-8 mb-20 reveal" x-init="setTimeout(() => $el.classList.add('visible'), 100)" x-intersect="$el.classList.add('visible')">
                <!-- IM8 Card -->
                <div class="border border-light-gray p-8">
                    <img src="{% if section.settings.ag1_product_image != blank %}{{ section.settings.ag1_product_image | image_url: width: 400 }}{% else %}{{ 'cc-v12-im8-product.webp' | asset_url }}{% endif %}" alt="IM8" class="mx-auto mb-6" style="max-height: 120px; object-fit: contain;" loading="lazy">
                    <p class="text-xs tracking-widest uppercase text-warm-gray mb-2">IM8</p>
                    <p class="text-4xl font-grotesk font-medium text-deep-ink mb-4">$154<span class="text-lg text-warm-gray">/month</span></p>
                    <div class="border-t border-light-gray pt-4 space-y-3 text-sm text-warm-gray">
                        <p>92 ingredients at trace amounts</p>
                        <p>~$1.67 per ingredient per month</p>
                        <p>$5.13/day</p>
                        <p>$1,848/year</p>
                        <p class="text-xs pt-2" style="color: #C0392B;">Proprietary blends -- doses undisclosed</p>
                    </div>
                </div>
                <!-- Coastline Card -->
                <div class="border-2 border-deep-ink p-8 relative">
                    <span style="position: absolute; top: -12px; left: 16px; background: var(--forest-light); color: white; font-size: 10px; font-weight: 500; letter-spacing: 0.08em; padding: 4px 10px;">$55 LESS / MONTH</span>
                    <img src="{% if section.settings.coastline_product_image != blank %}{{ section.settings.coastline_product_image | image_url: width: 400 }}{% else %}https://cdn.shopify.com/s/files/1/0619/6861/3445/files/Family_Vert_-_CL_2_20aeec91-5477-425f-84e0-5ea21f9239ad.png?v=1769186113{% endif %}" alt="Coastline" class="mx-auto mb-6" style="max-height: 120px; object-fit: contain;" loading="lazy">
                    <p class="text-xs tracking-widest uppercase text-warm-gray mb-2">Coastline</p>
                    <p class="text-4xl font-grotesk font-medium text-deep-ink mb-4">$99<span class="text-lg text-warm-gray">/month</span></p>
                    <div class="border-t border-light-gray pt-4 space-y-3 text-sm text-warm-gray">
                        <p>13 ingredients at clinical doses</p>
                        <p>~$7.62 per ingredient per month</p>
                        <p>$3.30/day</p>
                        <p>$1,188/year</p>
                        <p class="text-xs pt-2" style="color: #2D5A47;">Full transparency -- every dose disclosed</p>
                    </div>
                </div>
            </div>

            <div class="text-center mb-20">
                <p class="text-warm-gray text-lg max-w-xl mx-auto leading-relaxed">
                    {{ section.settings.price_framing | default: "Coastline costs $55/month less than IM8 — and shows you exactly what you're paying for. You are not paying for ingredient count. You are paying for ingredient doses that actually work." }}
                </p>
            </div>

            <!-- 5B: INGREDIENT COMPARISON GRID -->
            <div class="mb-20 reveal" x-init="setTimeout(() => $el.classList.add('visible'), 100)" x-intersect="$el.classList.add('visible')">
                <div class="text-center mb-12">
                    <p class="section-counter mb-6">Ingredient Comparison</p>
                    <div class="editorial-divider mx-auto mb-10"></div>
                    <h2 class="text-3xl lg:text-4xl font-grotesk font-medium">{{ section.settings.ingredient_comparison_headline | default: 'Side by side' }}</h2>
                </div>

                <div class="v6-table-scroll">
                    <table class="v6-comparison-table" style="min-width: 520px;">
                        <thead>
                            <tr>
                                <th style="min-width:160px;"></th>
                                <th style="text-align:center;">Coastline</th>
                                <th style="text-align:center;">IM8</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr><td>Clinical dosing</td><td class="v6-check" style="text-align:center;">&#10003; Full transparency</td><td class="v6-x" style="text-align:center;">&#10007; Proprietary blends</td></tr>
                            <tr><td>Ingredient count</td><td style="text-align:center; color:#0A0A0A;">13 (precision)</td><td style="text-align:center; color:#6B6B6B;">92+ (pixie dusting)</td></tr>
                            <tr><td>Inulin dose</td><td class="v6-check" style="text-align:center;">4g (clinical dose)</td><td class="v6-x" style="text-align:center;">Undisclosed</td></tr>
                            <tr><td>Creatine</td><td class="v6-check" style="text-align:center;">5.25g</td><td class="v6-x" style="text-align:center;">None</td></tr>
                            <tr><td>CoQ10</td><td class="v6-check" style="text-align:center;">200mg</td><td class="v6-x" style="text-align:center;">None</td></tr>
                            <tr><td>Taurine</td><td class="v6-check" style="text-align:center;">3.05g</td><td class="v6-x" style="text-align:center;">None</td></tr>
                            <tr><td>AM/PM timing</td><td class="v6-check" style="text-align:center;">&#10003; Yes</td><td class="v6-x" style="text-align:center;">&#10007; No</td></tr>
                            <tr><td>Hallmarks of aging</td><td style="text-align:center; color:#0A0A0A;">All 12</td><td style="text-align:center; color:#6B6B6B;">~3-4</td></tr>
                            <tr><td>Body systems</td><td style="text-align:center; color:#0A0A0A;">11</td><td style="text-align:center; color:#6B6B6B;">6</td></tr>

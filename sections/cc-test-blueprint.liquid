{% render 'cc-deps' %}
<div class="cc-apr26 cc-test-blueprint" style="padding:80px 24px; background:#062F3D; color:#FAF9F6; text-align:center;">
  <h1 style="font-family:'Space Grotesk',sans-serif; font-size:48px; margin:0 0 16px;">BLUEPRINT TEST PAGE</h1>
  <p style="font-size:18px; opacity:0.8;">If you see this red text, the section is rendering. If you see the default product page instead, Shopify is rejecting this filename for unknown reasons.</p>
</div>

{% schema %}
{
  "name": "Test Blueprint",
  "tag": "section",
  "class": "cc-test-blueprint",
  "settings": [],
  "presets": [{ "name": "Test Blueprint", "category": "Coastline" }],
  "enabled_on": { "templates": ["product"] }
}
{% endschema %}

{%- comment -%}
  cc-hero-apr26 — homepage hero section
  Extracted from cc-homepage.liquid "SECTION 1: HERO" (Apr 26 rebuild).
  Scoped to .cc-hero-apr26 so it's portable across templates.
{%- endcomment -%}

{% render 'cc-deps' %}

<section id="{{ section.settings.anchor | default: 'cc-home-hero' }}" class="cc-hero-apr26{% if section.settings.hero_scrim %} cc-hero-apr26--cliff{% endif %}">

  {%- assign cc_hero_alt = section.settings.hero_alt | default: 'Coastline hero' -%}
  {%- if section.settings.hero_desktop_asset != blank and section.settings.hero_mobile_asset != blank -%}
    {%- comment -%} Asset-based hero (homepage cliff hero, Oct 2026) {%- endcomment -%}
    {%- assign cc_d = section.settings.hero_desktop_asset -%}
    {%- assign cc_m = section.settings.hero_mobile_asset -%}
    <img src="{{ cc_d | asset_img_url: '2560x' }}"
         srcset="{{ cc_d | asset_img_url: '1280x' }} 1280w, {{ cc_d | asset_img_url: '1920x' }} 1920w, {{ cc_d | asset_img_url: '2560x' }} 2560w"
         sizes="100vw" alt="{{ cc_hero_alt | escape }}" class="cc-hero-apr26__img-desktop" loading="eager" fetchpriority="high">
    <img src="{{ cc_m | asset_img_url: '1080x' }}"
         srcset="{{ cc_m | asset_img_url: '750x' }} 750w, {{ cc_m | asset_img_url: '1080x' }} 1080w"
         sizes="100vw" alt="{{ cc_hero_alt | escape }}" class="cc-hero-apr26__img-mobile" loading="eager">
  {%- else -%}
  {%- comment -%} Desktop hero image {%- endcomment -%}
  {%- if section.settings.hero_image != blank -%}
    <img src="{{ section.settings.hero_image | image_url: width: 2560 }}" alt="{{ cc_hero_alt | escape }}" class="cc-hero-apr26__img-desktop" loading="eager">
  {%- else -%}
    <img src="{{ 'cc-hero-desktop-apr.jpg' | asset_url }}" alt="{{ cc_hero_alt | escape }}" class="cc-hero-apr26__img-desktop" loading="eager">
  {%- endif -%}

  {%- comment -%} Mobile hero image {%- endcomment -%}
  {%- if section.settings.hero_image_mobile != blank -%}
    <img src="{{ section.settings.hero_image_mobile | image_url: width: 1080 }}" alt="{{ cc_hero_alt | escape }}" class="cc-hero-apr26__img-mobile" loading="eager">
  {%- else -%}
    <img src="{{ 'cc-hero-mobile-apr.jpg' | asset_url }}" alt="{{ cc_hero_alt | escape }}" class="cc-hero-apr26__img-mobile" loading="eager">
  {%- endif -%}
  {%- endif -%}
  {%- if section.settings.hero_scrim -%}<div class="cc-hero-apr26__scrim" aria-hidden="true"></div>{%- endif -%}

  <div class="cc-hero-content-wrap" style="position:relative;z-index:2;width:100%;">
    <div class="cc-hero-top">
      <p class="cc-hero-label" style="letter-spacing:0.2em;text-transform:uppercase;font-weight:500;">{{ section.settings.hero_label | default: 'THE ULTIMATE LONGEVITY SYSTEM' }}</p>
      <div class="cc-hero-divider" style="width:40px;height:1px;background:rgba(255,255,255,0.4);"></div>
      <h1 class="cc-hero-headline">
        {{ section.settings.hero_headline | default: 'Stay sharp, strong, and energized at every age' }}
      </h1>
    </div>
    <div class="cc-hero-bottom">
      <p class="cc-hero-subheadline" style="line-height:1.8;">
        {{ section.settings.hero_subheadline | default: '13 science-backed ingredients. One simple system. From $2.64/day.' }}
      </p>
      <a href="{{ section.settings.hero_reviews_anchor | default: '#cc-reviews-anchor' }}" class="cc-hero-stars" style="display:flex;align-items:center;gap:8px;cursor:pointer;text-decoration:none;">
        <span style="color:#fff;font-size:14px;letter-spacing:4px;">&#9733;&#9733;&#9733;&#9733;&#9733;</span>
        <span style="font-family:'Inter',sans-serif;font-size:11px;color:rgba(255,255,255,0.6);text-decoration:underline;text-underline-offset:3px;">{{ section.settings.hero_reviews | default: 'Consistent 5-Star Reviews' }}</span>
      </a>
      <div class="cc-hero-ctas">
        <a href="{{ section.settings.hero_cta_link | default: '#cc-home-pricing' }}" class="cc-hero-cta-primary">
          {{ section.settings.hero_cta_text | default: 'START MY LONGEVITY SYSTEM' }}
        </a>
        <a href="{{ section.settings.hero_secondary_link | default: '#cc-home-pricing' }}" class="cc-hero-secondary-link">
          {{ section.settings.hero_secondary_text | default: 'SKIP TO PRICING' }}
        </a>
      </div>
    </div>
  </div>
</section>

<style>
  /* Hero section root */
  .cc-hero-apr26 {
    position: relative;
    min-height: 115vh;
    display: flex;
    align-items: flex-end;
    background-color: #0A0A0A;
    overflow: hidden;
  }
  @media (min-width: 768px) {
    .cc-hero-apr26 {
      min-height: 100vh;
      align-items: center;
    }
  }

  /* Hero images */
  .cc-hero-apr26__img-desktop,
  .cc-hero-apr26__img-mobile {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .cc-hero-apr26__img-desktop { display: none; }
  .cc-hero-apr26__img-mobile { display: block; object-position: center 30%; }
  @media (min-width: 768px) {
    .cc-hero-apr26__img-desktop { display: block; }
    .cc-hero-apr26__img-mobile { display: none; }
  }

  /* Hero content layout — MOBILE: flex column, headline top, copy bottom */
  .cc-hero-apr26 .cc-hero-content-wrap {
    min-height: 115vh;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    padding: 100px 24px 36px;
    text-align: center;
  }
  .cc-hero-apr26 .cc-hero-secondary-link { display: none; }
  .cc-hero-apr26 .cc-hero-label {
    font-family: 'Inter', sans-serif;
    font-size: 10px;
    margin-bottom: 12px;
    color: rgba(255,255,255,0.7);
  }
  .cc-hero-apr26 .cc-hero-divider { display: none; }
  .cc-hero-apr26 .cc-hero-subheadline { margin-bottom: 20px; color: rgba(255,255,255,0.75) !important; }
  .cc-hero-apr26 .cc-hero-stars { justify-content: center; margin-bottom: 20px; }
  .cc-hero-apr26 .cc-hero-ctas { display: flex; flex-direction: column; gap: 12px; align-items: center; }
  .cc-hero-apr26 .cc-hero-secondary-link {
    font-family: 'Space Grotesk', sans-serif;
    font-size: 13px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    text-decoration: underline;
    text-underline-offset: 4px;
    padding: 4px 0;
    transition: opacity 0.3s ease;
    color: rgba(255,255,255,0.6);
  }
  .cc-hero-apr26 .cc-hero-secondary-link:hover { opacity: 0.75; }

  /* Hero content layout — DESKTOP: single block, left-aligned, vertically centered */
  @media (min-width: 768px) {
    .cc-hero-apr26 .cc-hero-content-wrap {
      min-height: auto;
      display: block;
      padding: 0 64px;
      text-align: left;
      max-width: 1280px;
      margin: 0 auto;
    }
    .cc-hero-apr26 .cc-hero-top { max-width: 680px; }
    .cc-hero-apr26 .cc-hero-bottom { max-width: 480px; }
    .cc-hero-apr26 .cc-hero-label {
      font-size: 12px;
      margin-bottom: 20px;
      color: rgba(255,255,255,0.8);
    }
    .cc-hero-apr26 .cc-hero-divider { display: block; margin-bottom: 32px; }
    .cc-hero-apr26 .cc-hero-subheadline { margin-bottom: 24px; color: rgba(255,255,255,0.85) !important; }
    .cc-hero-apr26 .cc-hero-stars { justify-content: flex-start; margin-bottom: 32px; }
    .cc-hero-apr26 .cc-hero-ctas { align-items: flex-start; }
    .cc-hero-apr26 .cc-hero-secondary-link { display: inline-block; color: rgba(255,255,255,0.7); }
  }

  /* Hero responsive typography */
  .cc-hero-apr26 .cc-hero-headline {
    font-family: 'Space Grotesk', system-ui, sans-serif;
    font-weight: 500;
    font-size: clamp(30px, 8.75vw, 50px);
    letter-spacing: -0.02em;
    line-height: 1.15;
    color: #FFFFFF;
    max-width: 100%;
  }
  .cc-hero-apr26 .cc-hero-subheadline {
    font-family: 'Inter', system-ui, sans-serif;
    font-size: clamp(14.5px, 3vw, 16.5px);
    color: rgba(255,255,255,0.85) !important;
    max-width: 380px;
    margin-left: 0;
    margin-right: auto;
  }
  @media (min-width: 768px) {
    .cc-hero-apr26 .cc-hero-headline {
      font-size: clamp(34px, 3.8vw, 56px);
      max-width: 680px;
      margin-left: 0;
      margin-right: auto;
    }
    .cc-hero-apr26 .cc-hero-subheadline {
      font-size: 16px;
      color: rgba(255,255,255,0.85) !important;
      max-width: 440px;
      margin-left: 0;
      margin-right: auto;
    }
  }

  /* Primary CTA button */
  .cc-hero-apr26 .cc-hero-cta-primary {
    display: inline-block;
    background: #E7FF56;
    color: #0A0A0A;
    font-family: 'Space Grotesk', sans-serif;
    font-weight: 500;
    font-size: 12px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    padding: 20px 48px;
    border: none;
    text-decoration: none;
    text-align: center;
    min-width: 200px;
    transition: opacity 0.3s ease;
  }
  .cc-hero-apr26 .cc-hero-cta-primary:hover { opacity: 0.85; }
  /* Desktop-only line break inside hero copy settings */
  .cc-hero-apr26 .cc-br-desk { display: none; }
  .cc-hero-apr26 .cc-hero-headline { text-wrap: balance; }
  @media (min-width: 768px) { .cc-hero-apr26 .cc-br-desk { display: inline; } }
  /* ===== Cliff hero (Oct 2026): brighter image -> scrims + mobile stacked layout ===== */
  .cc-hero-apr26__scrim { position: absolute; inset: 0; z-index: 1; pointer-events: none; display: block !important; }
  /* MOBILE: image anchored top at natural ratio (1536x2688 = 175vw tall); headline over sky,
     copy block sits below the products on the dark background. */
  .cc-hero-apr26--cliff .cc-hero-apr26__img-mobile {
    height: 175vw; bottom: auto; object-fit: cover; object-position: center top;
  }
  .cc-hero-apr26--cliff .cc-hero-apr26__scrim {
    height: 175vw; bottom: auto;
    background:
      linear-gradient(180deg, rgba(4,20,28,0.62) 0%, rgba(4,20,28,0.45) 16%, rgba(4,20,28,0.15) 30%, rgba(4,20,28,0) 40%),
      linear-gradient(180deg, rgba(10,10,10,0) 87.5%, rgba(10,10,10,0.8) 92%, #0A0A0A 96%);
  }
  .cc-hero-apr26--cliff { min-height: 0; align-items: stretch; }
  .cc-hero-apr26--cliff .cc-hero-content-wrap { min-height: 0; justify-content: flex-start; padding: 0 24px 40px; position: relative; }
  .cc-hero-apr26--cliff .cc-hero-top { position: absolute; top: 96px; left: 24px; right: 24px; }
  .cc-hero-apr26--cliff .cc-hero-bottom { margin-top: calc(175vw * 0.905); }
  .cc-hero-apr26--cliff .cc-hero-label { color: rgba(255,255,255,0.92); }
  /* MOBILE v2: label + headline + subhead + stars stacked over the sky; only the CTA sits below the products */
  @media (max-width: 767px) {
    /* Fit the whole hero above the mobile fold: hero = visible screen minus the
       ~119px announcement + header. Products are anchored 16px above the stars/CTA. */
    .cc-hero-apr26--cliff { --cc-hero-h: max(500px, calc(100vh - 119px)); }
    @supports (height: 100svh) {
      .cc-hero-apr26--cliff { --cc-hero-h: max(500px, calc(100svh - 119px)); }
    }
    .cc-hero-apr26--cliff .cc-hero-content-wrap {
      display: flex; flex-direction: column; justify-content: flex-start;
      min-height: var(--cc-hero-h); padding: clamp(40px, calc(var(--cc-hero-h) - 490px), 80px) 24px 28px;
    }
    .cc-hero-apr26--cliff .cc-hero-top { position: static; }
    .cc-hero-apr26--cliff .cc-hero-bottom { display: contents; margin-top: 0; }
    .cc-hero-apr26--cliff .cc-hero-subheadline { margin: 12px auto 0; max-width: 340px; font-size: 14.5px; line-height: 1.6 !important; color: rgba(255,255,255,0.92) !important; text-shadow: 0 1px 12px rgba(0,0,0,0.25); }
    .cc-hero-apr26--cliff .cc-hero-stars { margin-top: auto; margin-bottom: 16px; }
    .cc-hero-apr26--cliff .cc-hero-ctas { margin-top: 0; }
    .cc-hero-apr26--cliff .cc-hero-apr26__img-mobile,
    .cc-hero-apr26--cliff .cc-hero-apr26__scrim { top: min(0px, calc(var(--cc-hero-h) - 136px - clamp(0px, calc(var(--cc-hero-h) - 560px), 60px) - 154vw)); height: calc(175vw + 3px); }
    .cc-hero-apr26--cliff .cc-hero-apr26__img-mobile { -webkit-mask-image: linear-gradient(180deg, #000 90%, transparent 98%); mask-image: linear-gradient(180deg, #000 90%, transparent 98%); }
    .cc-hero-apr26--cliff .cc-hero-apr26__scrim {
      background:
        linear-gradient(180deg, rgba(4,20,28,0.66) 0%, rgba(4,20,28,0.55) 24%, rgba(4,20,28,0.32) 44%, rgba(4,20,28,0) 60%),
        linear-gradient(180deg, rgba(10,10,10,0) 87.5%, rgba(10,10,10,0.85) 91.5%, #0A0A0A 95%);
    }
  }
  @media (min-width: 768px) {
    .cc-hero-apr26--cliff { min-height: min(100vh, 55.8vw); align-items: center; padding: 48px 0; }
    .cc-hero-apr26--cliff .cc-hero-content-wrap { padding: 0 64px; }
    .cc-hero-apr26--cliff .cc-hero-top { position: static; }
    .cc-hero-apr26--cliff .cc-hero-bottom { margin-top: 0; }
    .cc-hero-apr26--cliff .cc-hero-apr26__img-desktop { object-position: 100% center; }
    .cc-hero-apr26--cliff .cc-hero-bottom { max-width: 430px; }
    .cc-hero-apr26--cliff .cc-hero-apr26__scrim {
      height: auto; bottom: 0;
      background:
        linear-gradient(180deg, rgba(4,20,28,0.30) 0%, rgba(4,20,28,0) 35%),
        linear-gradient(90deg, rgba(4,20,28,0.72) 0%, rgba(4,20,28,0.62) 24%, rgba(4,20,28,0.32) 38%, rgba(4,20,28,0) 47%);
    }
    .cc-hero-apr26--cliff .cc-hero-label { color: rgba(255,255,255,0.92); }
  }
  @media (min-width: 1200px) {
    .cc-hero-apr26--cliff .cc-hero-content-wrap { transform: translateY(-4.5vw); }
  }
</style>

{% schema %}
{
  "name": "Hero (apr26)",
  "tag": "section",
  "class": "section-cc-hero-apr26",
  "settings": [
    {
      "type": "header",
      "content": "Images"
    },
    {
      "type": "image_picker",
      "id": "hero_image",
      "label": "Desktop hero image",
      "info": "Defaults to cc-hero-desktop-apr.jpg if empty"
    },
    {
      "type": "image_picker",
      "id": "hero_image_mobile",
      "label": "Mobile hero image",
      "info": "Defaults to cc-hero-mobile-apr.jpg if empty"
    },
    { "type": "text", "id": "hero_desktop_asset", "label": "Desktop hero theme asset (filename)", "info": "Overrides hero image. e.g. cc-hero-desktop-cliff.jpg" },
    { "type": "text", "id": "hero_mobile_asset", "label": "Mobile hero theme asset (filename)" },
    { "type": "text", "id": "hero_alt", "label": "Hero image alt text" },
    { "type": "checkbox", "id": "hero_scrim", "label": "Bright image mode (scrims + stacked mobile layout)", "default": false },
    {
      "type": "header",
      "content": "Copy"
    },
    {
      "type": "text",
      "id": "hero_label",
      "label": "Eyebrow label",
      "default": "THE ULTIMATE LONGEVITY SYSTEM"
    },
    {
      "type": "textarea",
      "id": "hero_headline",
      "label": "Headline",
      "default": "Stay sharp, strong, and energized at every age"
    },
    {
      "type": "textarea",
      "id": "hero_subheadline",
      "label": "Subheadline",
      "default": "13 science-backed ingredients. One simple system. From $2.64/day."
    },
    {
      "type": "text",
      "id": "hero_reviews",
      "label": "Reviews line",
      "default": "Consistent 5-Star Reviews"
    },
    {
      "type": "text",
      "id": "hero_reviews_anchor",
      "label": "Reviews link anchor",
      "default": "#cc-reviews-anchor"
    },
    {
      "type": "header",
      "content": "CTAs"
    },
    {
      "type": "text",
      "id": "hero_cta_text",
      "label": "Primary CTA text",
      "default": "START MY LONGEVITY SYSTEM"
    },
    {
      "type": "text",
      "id": "hero_cta_link",
      "label": "Primary CTA link",
      "info": "Use #cc-home-pricing to scroll to pricing",
      "default": "#cc-home-pricing"
    },
    {
      "type": "text",
      "id": "hero_secondary_text",
      "label": "Secondary CTA text",
      "default": "SKIP TO PRICING"
    },
    {
      "type": "text",
      "id": "hero_secondary_link",
      "label": "Secondary CTA link",
      "default": "#cc-home-pricing"
    },
    {
      "type": "header",
      "content": "Advanced"
    },
    {
      "type": "text",
      "id": "anchor",
      "label": "Section id (anchor)",
      "default": "cc-home-hero"
    }
  ],
  "presets": [
    {
      "name": "Hero (apr26)",
      "category": "Coastline"
    }
  ]
}
{% endschema %}

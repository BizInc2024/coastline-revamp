{%- comment -%}
  cc-email-capture-apr26 — Email Capture
  Extracted from cc-homepage.liquid (Apr 26 rebuild, vanilla re-scope)
{%- endcomment -%}

{% render 'cc-deps' %}

<div class="cc-apr26 cc-email-capture-apr26">
    <section class="reveal" x-init="setTimeout(() => $el.classList.add('visible'), 100)" style="background:#F0EFEC;padding-top:80px;padding-bottom:80px;" x-intersect.once="$el.classList.add('visible')">
      <div style="max-width:560px;margin:0 auto;padding:0 32px;text-align:center;">
        <span style="font-family:'Inter',sans-serif;font-size:11px;letter-spacing:0.15em;text-transform:uppercase;color:var(--warm-gray);display:block;margin-bottom:20px;">
          {{ section.settings.email_label | default: "STAY IN THE KNOW" }}
        </span>
        <h2 style="font-family:'Space Grotesk',sans-serif;font-size:clamp(24px,3.5vw,36px);font-weight:500;color:var(--deep-ink);line-height:1.2;margin:0 0 16px;">
          {{ section.settings.email_headline | default: "Get longevity insights delivered weekly" }}
        </h2>
        <div style="width:48px;height:1px;background:var(--light-gray);margin:24px auto;"></div>
        <p style="font-family:'Inter',sans-serif;font-size:16px;line-height:1.7;color:var(--warm-gray);margin:0 0 32px;max-width:480px;display:inline-block;">
          {{ section.settings.email_body | default: "Join thousands of health-focused readers. Science-backed insights on aging, performance, and vitality -- no spam, no hype." }}
        </p>
  
        {% form 'customer', id: 'cc-homepage-email-form' %}
          <input type="hidden" name="contact[tags]" value="homepage-signup">
          <div style="display:flex;gap:0;max-width:460px;margin:0 auto;border:2px solid var(--deep-ink);overflow:hidden;">
            <input
              type="email"
              name="contact[email]"
              placeholder="Enter your email"
              required
              autocomplete="email"
              style="flex:1;padding:16px 20px;border:none;background:#fff;font-family:'Inter',sans-serif;font-size:14px;color:var(--deep-ink);outline:none;min-width:0;"
            >
            <button
              type="submit"
              style="padding:16px 32px;background:var(--deep-ink);color:var(--parchment);font-family:'Space Grotesk',sans-serif;font-weight:500;font-size:11px;letter-spacing:0.18em;text-transform:uppercase;border:none;cursor:pointer;white-space:nowrap;transition:opacity 0.3s ease;flex-shrink:0;"
            >
              {{ section.settings.email_button_text | default: "SUBSCRIBE" }}
            </button>
          </div>
          {% if form.posted_successfully? %}
            <p style="margin-top:16px;font-size:14px;color:var(--forest);font-weight:500;">Thank you for subscribing.</p>
          {% endif %}
          {% if form.errors %}
            <p style="margin-top:16px;font-size:14px;color:#c00;">{{ form.errors | default_errors }}</p>
          {% endif %}
        {% endform %}
  
        <p style="margin-top:16px;font-size:11px;color:var(--warm-gray);letter-spacing:0.03em;">No spam. Unsubscribe anytime.</p>
      </div>
    </section>
</div>

{% schema %}
{
  "name": "Email Capture (apr26)",
  "tag": "section",
  "class": "section-cc-email-capture-apr26",
  "settings": [],
  "presets": [
    {
      "name": "Email Capture (apr26)",
      "category": "Coastline"
    }
  ]
}
{% endschema %}

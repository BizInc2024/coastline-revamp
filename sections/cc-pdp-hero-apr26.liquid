{%- comment -%}
  cc-pdp-hero-apr26 — Universal PDP hero (image + buy panel)
  Works for any single product. Reads variants + selling plans from
  product.* Liquid vars. Used by product.pdp-apr26.json template.
{%- endcomment -%}

{% render 'cc-deps' %}

{%- assign current_variant = product.selected_or_first_available_variant -%}
{%- comment -%}
  Coastline products use ONE selling plan per group (monthly group +
  2-month group). The render loop below iterates ALL groups, not just
  the first, so every plan shows up.
{%- endcomment -%}
{%- assign sp_group = product.selling_plan_groups | first -%}

<div class="cc-apr26 cc-pdp-hero-apr26">
  <section class="reveal" style="padding-top:{{ section.settings.padding_top | default: 64 }}px;padding-bottom:{{ section.settings.padding_bottom | default: 96 }}px;background:var(--parchment);">
    <div style="max-width:1200px;margin:0 auto;padding:0 24px;">
      <div class="cc-pdp-hero-grid">

        {%- comment -%} ===== LEFT: Image gallery (square hero + thumb grid) ===== {%- endcomment -%}
        <div class="cc-pdp-gallery"
             x-data="{
               active: 0,
               images: [
                 {%- if section.settings.hero_image != blank -%}
                   { src: '{{ section.settings.hero_image | image_url: width: 1200 }}', alt: '{{ product.title | escape }}' },
                 {%- endif -%}
                 {%- for img in product.images -%}
                   { src: '{{ img | image_url: width: 1200 }}', alt: '{{ img.alt | default: product.title | escape }}' }{%- unless forloop.last -%},{%- endunless -%}
                 {%- endfor -%}
               ]
             }">
          <div class="cc-pdp-hero-img">
            <template x-if="images.length > 0">
              <img :src="images[active].src" :alt="images[active].alt" loading="lazy">
            </template>
          </div>
          <div class="cc-pdp-thumbs" x-show="images.length > 1" x-cloak>
            <template x-for="(img, i) in images" :key="i">
              <button type="button"
                      class="cc-pdp-thumb"
                      :class="active === i ? 'is-active' : ''"
                      @click="active = i"
                      :aria-pressed="active === i ? 'true' : 'false'">
                <img :src="img.src" :alt="img.alt" loading="lazy">
              </button>
            </template>
          </div>
        </div>

        {%- comment -%} ===== RIGHT: Buy panel ===== {%- endcomment -%}
        <div class="cc-pdp-buy-panel"
             x-data="ccPdpBuyApr26()"
             style="padding-top:8px;">

          <h1 style="font-family:'Space Grotesk',sans-serif;font-weight:500;font-size:clamp(28px,4vw,40px);margin:0 0 16px;color:var(--deep-ink);">
            {{ section.settings.hero_title | default: product.title }}
          </h1>

          <div style="display:flex;align-items:center;gap:12px;margin-bottom:20px;">
            <span style="letter-spacing:4px;color:var(--deep-ink);font-size:14px;">&#9733;&#9733;&#9733;&#9733;&#9733;</span>
            <span style="font-family:'Inter',sans-serif;font-size:14px;color:var(--warm-gray);">
              {{ section.settings.review_text | default: "200+ five-star reviews" }}
            </span>
          </div>

          {%- assign trust_badges = section.settings.trust_badges | default: "Vegan, Sugar-Free, Caffeine-Free, GMP Certified" -%}
          <p style="margin:0 0 24px;font-family:'Inter',sans-serif;font-size:11px;letter-spacing:0.15em;text-transform:uppercase;color:var(--warm-gray);line-height:1.4;">
            {%- assign badge_list = trust_badges | split: ',' -%}
            {%- for badge in badge_list -%}{{ badge | strip }}{%- unless forloop.last %} &middot; {% endunless -%}{%- endfor -%}
          </p>

          <div style="height:1px;background:var(--light-gray);margin-bottom:28px;"></div>

          <div style="margin-bottom:28px;">
            <p style="font-family:'Inter',sans-serif;font-size:15px;color:var(--warm-gray);line-height:1.6;margin:0 0 12px;">
              {{ section.settings.hero_description | default: product.description | strip_html | truncate: 240 }}
            </p>
            {%- if section.settings.ingredients_line != blank -%}
              <p style="font-family:'Inter',sans-serif;font-size:13px;color:var(--forest);font-weight:500;margin:0 0 12px;">
                {{ section.settings.ingredients_line }}
              </p>
            {%- endif -%}
            {%- if section.settings.supply_line != blank -%}
              <p style="font-family:'Inter',sans-serif;font-size:14px;color:var(--warm-gray);margin:0;line-height:1.6;">
                {{ section.settings.supply_line }}
              </p>
            {%- endif -%}
          </div>

          {%- comment -%} ===== Variant selector (auto-renders if product has options other than Title) ===== {%- endcomment -%}
          {%- if product.has_only_default_variant == false -%}
            {%- for option in product.options_with_values -%}
              <div style="margin-bottom:28px;">
                <p style="font-family:'Inter',sans-serif;font-size:13px;font-weight:500;color:var(--deep-ink);margin:0 0 12px;text-transform:uppercase;letter-spacing:0.1em;">Select your {{ option.name | downcase }}</p>
                <div style="display:flex;gap:10px;flex-wrap:wrap;">
                  {%- for value in option.values -%}
                    {%- assign opt_idx = forloop.parent.index0 -%}
                    <button type="button"
                            data-value="{{ value | escape }}"
                            @click="selectedOption{{ opt_idx }} = '{{ value | escape }}'"
                            :class="selectedOption{{ opt_idx }} === '{{ value | escape }}' ? 'cc-pdp-opt-active' : 'cc-pdp-opt-idle'"
                            class="cc-pdp-opt-btn">
                      {{ value }}
                    </button>
                  {%- endfor -%}
                </div>
              </div>
            {%- endfor -%}
          {%- endif -%}

          {%- comment -%} ===== Selling plan selector ===== {%- endcomment -%}
          {%- if sp_group -%}
            <div style="margin-bottom:28px;">
              <p style="font-family:'Inter',sans-serif;font-size:11px;letter-spacing:0.15em;text-transform:uppercase;color:var(--warm-gray);font-weight:500;margin-bottom:14px;">Select your plan</p>

              {%- for grp in product.selling_plan_groups -%}
              {%- for sp in grp.selling_plans -%}
                {%- comment -%}
                  Try the allocation lookup first (cleanest source of truth for the
                  discounted price). If it doesn't resolve, compute from the
                  price_adjustments[0] — works for percentage / fixed / price types.
                {%- endcomment -%}
                {%- assign sp_alloc = nil -%}
                {%- for alloc in current_variant.selling_plan_allocations -%}
                  {%- if alloc.selling_plan_id == sp.id -%}
                    {%- assign sp_alloc = alloc -%}
                    {%- break -%}
                  {%- endif -%}
                {%- endfor -%}
                {%- if sp_alloc -%}
                  {%- assign sp_display_price = sp_alloc.price -%}
                {%- else -%}
                  {%- assign adj = sp.price_adjustments | first -%}
                  {%- if adj.value_type == 'percentage' -%}
                    {%- assign discount_amount = current_variant.price | times: adj.value | divided_by: 100 -%}
                    {%- assign sp_display_price = current_variant.price | minus: discount_amount -%}
                  {%- elsif adj.value_type == 'fixed_amount' -%}
                    {%- assign sp_display_price = current_variant.price | minus: adj.value -%}
                  {%- elsif adj.value_type == 'price' -%}
                    {%- assign sp_display_price = adj.value -%}
                  {%- else -%}
                    {%- assign sp_display_price = current_variant.price -%}
                  {%- endif -%}
                {%- endif -%}
                {%- comment -%}
                  Friendlier display labels + "BEST VALUE" badge on monthly.
                  Explicit price overrides via section.settings.{monthly,bimonthly}_price
                  beat the computed math — these are populated from ReCharge in the
                  template JSON for each product. Computed value is the fallback.
                {%- endcomment -%}
                {%- assign sp_name_lower = sp.name | downcase -%}
                {%- if sp_name_lower contains '2 month' or sp_name_lower contains '2-month' -%}
                  {%- assign sp_display_name = 'Delivered every 2 months' -%}
                  {%- assign sp_save_label = section.settings.bimonthly_save | default: 'Save 10%' -%}
                  {%- assign sp_price_override = section.settings.bimonthly_price -%}
                  {%- assign show_best_value = false -%}
                {%- elsif sp_name_lower contains '1 month' or sp_name_lower contains 'monthly' -%}
                  {%- assign sp_display_name = 'Monthly subscription' -%}
                  {%- assign sp_save_label = section.settings.monthly_save | default: 'Save 20%' -%}
                  {%- assign sp_price_override = section.settings.monthly_price -%}
                  {%- assign show_best_value = true -%}
                {%- else -%}
                  {%- assign sp_display_name = sp.name -%}
                  {%- assign sp_save_label = sp.description -%}
                  {%- assign sp_price_override = '' -%}
                  {%- assign show_best_value = false -%}
                {%- endif -%}
                <div @click="plan = '{{ sp.id }}'"
                     :class="plan === '{{ sp.id }}' ? 'cc-pdp-plan-active' : 'cc-pdp-plan-idle'"
                     class="cc-pdp-plan-card"
                     style="margin-bottom:10px;position:relative;">
                  {%- if show_best_value -%}
                    <span class="cc-pdp-plan-badge">BEST VALUE</span>
                  {%- endif -%}
                  <div style="display:flex;align-items:center;justify-content:space-between;padding:20px;">
                    <div>
                      <span style="display:block;font-family:'Space Grotesk',sans-serif;font-weight:500;color:var(--deep-ink);font-size:15px;line-height:1.3;">
                        {{ sp_display_name }}
                      </span>
                      {%- if sp_save_label != blank -%}
                        <span style="display:block;font-family:'Inter',sans-serif;font-size:12px;color:var(--forest);font-weight:500;margin-top:3px;">
                          {{ sp_save_label }}
                        </span>
                      {%- endif -%}
                    </div>
                    <div style="text-align:right;flex-shrink:0;margin-left:16px;">
                      <span style="display:block;font-family:'Space Grotesk',sans-serif;font-weight:600;color:var(--deep-ink);font-size:24px;line-height:1;">
                        {%- if sp_price_override != blank -%}{{ sp_price_override }}{%- else -%}{{ sp_display_price | money_without_trailing_zeros }}{%- endif -%}
                      </span>
                      <span style="display:block;font-family:'Inter',sans-serif;font-size:12px;color:var(--warm-gray);margin-top:2px;">
                        {%- if sp.recurring_deliveries -%}/period{%- else -%}one-time{%- endif -%}
                      </span>
                    </div>
                  </div>
                </div>
              {%- endfor -%}
              {%- endfor -%}

              {%- comment -%} One-time option (no selling plan) {%- endcomment -%}
              <div @click="plan = ''"
                   :class="plan === '' ? 'cc-pdp-plan-active' : 'cc-pdp-plan-idle'"
                   class="cc-pdp-plan-card">
                <div style="display:flex;align-items:center;justify-content:space-between;padding:20px;">
                  <div>
                    <span style="display:block;font-family:'Space Grotesk',sans-serif;font-weight:500;color:var(--deep-ink);font-size:15px;line-height:1.3;">One-time purchase</span>
                    <span style="display:block;font-family:'Inter',sans-serif;font-size:12px;color:var(--warm-gray);margin-top:3px;">No subscription</span>
                  </div>
                  <div style="text-align:right;flex-shrink:0;margin-left:16px;">
                    <span style="display:block;font-family:'Space Grotesk',sans-serif;font-weight:600;color:var(--deep-ink);font-size:24px;line-height:1;">
                      {%- if section.settings.onetime_price != blank -%}{{ section.settings.onetime_price }}{%- else -%}{{ current_variant.price | money_without_trailing_zeros }}{%- endif -%}
                    </span>
                    <span style="display:block;font-family:'Inter',sans-serif;font-size:12px;color:var(--warm-gray);margin-top:2px;">one-time</span>
                  </div>
                </div>
              </div>
            </div>
          {%- endif -%}

          {%- comment -%} ===== ATC Form (native ReCharge-compatible) ===== {%- endcomment -%}
          <form id="cc-pdp-cart-form-{{ section.id | replace: '-', '_' }}" action="/cart/add" method="post" is="product-form" data-type="add-to-cart-form">
            <input type="hidden" name="id" :value="variantId" />
            <template x-if="plan">
              <input type="hidden" name="selling_plan" :value="plan" />
            </template>
            <button type="submit"
                    :disabled="loading"
                    style="width:100%;padding:22px 48px;font-size:14px;margin-bottom:20px;background:var(--deep-ink);color:var(--parchment);border:none;font-family:'Space Grotesk',sans-serif;font-weight:500;letter-spacing:0.18em;text-transform:uppercase;cursor:pointer;transition:opacity 0.3s ease;">
              <span class="btn-text">
                <span x-show="!loading">ADD TO CART &mdash; <span x-text="displayPrice"></span></span>
                <span x-show="loading">ADDING&hellip;</span>
              </span>
            </button>
          </form>

          {%- comment -%} ===== Micro-copy ===== {%- endcomment -%}
          <div style="display:flex;justify-content:center;gap:24px;flex-wrap:wrap;">
            <span style="font-family:'Inter',sans-serif;font-size:12px;color:var(--warm-gray);display:flex;align-items:center;gap:6px;">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
              Free shipping
            </span>
            <span style="font-family:'Inter',sans-serif;font-size:12px;color:var(--warm-gray);display:flex;align-items:center;gap:6px;">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><path d="M8 12l3 3 5-5"/></svg>
              Cancel anytime
            </span>
            <span style="font-family:'Inter',sans-serif;font-size:12px;color:var(--warm-gray);display:flex;align-items:center;gap:6px;">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
              60-day guarantee
            </span>
          </div>

          <div style="display:flex;justify-content:center;align-items:center;gap:20px;margin-top:24px;">
            <img src="https://cdn.shopify.com/s/files/1/0619/6861/3445/files/istockphoto-1279030031-612x612_1.png?v=1767983702" alt="Third-party tested" style="height:48px;object-fit:contain;opacity:0.7;" loading="lazy">
            <img src="https://cdn.shopify.com/s/files/1/0619/6861/3445/files/download_1.png?v=1767983648" alt="GMP Certified" style="height:48px;object-fit:contain;opacity:0.7;" loading="lazy">
            <img src="{{ 'cc-made-in-usa.png' | asset_url }}" alt="Made in USA" style="height:88px;object-fit:contain;opacity:0.7;margin-left:-10px;" loading="lazy">
          </div>

        </div>

      </div>
    </div>
  </section>
</div>

<style>
  .cc-pdp-hero-apr26 .cc-pdp-hero-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 32px;
    align-items: start;
  }
  @media (min-width: 1024px) {
    .cc-pdp-hero-apr26 .cc-pdp-hero-grid {
      grid-template-columns: 1fr 480px;
      gap: 64px;
    }
  }
  .cc-pdp-hero-apr26 .cc-pdp-buy-panel { font-family: 'Inter', sans-serif; max-width: 480px; }

  /* Gallery */
  .cc-pdp-hero-apr26 .cc-pdp-gallery { width: 100%; max-width: 600px; margin: 0 auto; }
  .cc-pdp-hero-apr26 .cc-pdp-hero-img {
    aspect-ratio: 1 / 1;
    width: 100%;
    background: #FAF9F6;
    overflow: hidden;
    border: 1px solid rgba(10, 10, 10, 0.08);
  }
  .cc-pdp-hero-apr26 .cc-pdp-hero-img img {
    width: 100%; height: 100%; object-fit: cover; display: block;
  }
  .cc-pdp-hero-apr26 .cc-pdp-thumbs {
    display: grid;
    grid-template-columns: repeat(6, 1fr);
    gap: 6px;
    margin-top: 10px;
  }
  .cc-pdp-hero-apr26 .cc-pdp-thumb {
    aspect-ratio: 1 / 1;
    overflow: hidden;
    padding: 0;
    border: 1px solid rgba(10, 10, 10, 0.08);
    background: #FAF9F6;
    cursor: pointer;
    transition: opacity 0.2s ease, border-color 0.2s ease;
  }
  .cc-pdp-hero-apr26 .cc-pdp-thumb:hover { opacity: 0.85; }
  .cc-pdp-hero-apr26 .cc-pdp-thumb.is-active { border: 2px solid var(--deep-ink); }
  .cc-pdp-hero-apr26 .cc-pdp-thumb img {
    width: 100%; height: 100%; object-fit: cover; display: block;
  }
  .cc-pdp-hero-apr26 .cc-pdp-opt-btn {
    flex: 1;
    min-width: 120px;
    padding: 14px 16px;
    font-family: 'Inter', sans-serif;
    font-size: 14px;
    cursor: pointer;
    transition: all 0.2s;
    background: transparent;
    border: 1px solid var(--light-gray);
    color: var(--warm-gray);
  }
  .cc-pdp-hero-apr26 .cc-pdp-opt-idle {
    border: 1px solid var(--light-gray);
    color: var(--warm-gray);
    background: transparent;
  }
  .cc-pdp-hero-apr26 .cc-pdp-opt-idle:hover {
    border-color: var(--deep-ink);
    color: var(--deep-ink);
  }
  .cc-pdp-hero-apr26 .cc-pdp-opt-active {
    border: 1px solid var(--deep-ink);
    background: var(--deep-ink);
    color: var(--parchment);
  }

  /* Flavor-specific FILL colors (background only — no border conflict). */
  .cc-pdp-hero-apr26 .cc-pdp-opt-btn[data-value*="Unflavored" i] {
    background: #EDE8DF !important;
  }
  .cc-pdp-hero-apr26 .cc-pdp-opt-btn[data-value*="Lemonade" i] {
    background: #F5E0E4 !important;
  }
  /* Active state — uses outline (sits OUTSIDE border, never overridden by
     specificity battles with data-value rules). Mirrors the plan selector
     active treatment. */
  .cc-pdp-hero-apr26 .cc-pdp-opt-active {
    outline: 3px solid #0A0A0A !important;
    outline-offset: -3px !important;
    color: #0A0A0A !important;
    font-weight: 700 !important;
  }
  .cc-pdp-hero-apr26 .cc-pdp-opt-active::before {
    content: "✓ ";
    font-weight: 700;
    color: inherit;
  }
  .cc-pdp-hero-apr26 .cc-pdp-plan-card {
    cursor: pointer;
    transition: border-color 0.2s;
    border: 1px solid var(--light-gray);
    background: var(--parchment);
  }
  .cc-pdp-hero-apr26 .cc-pdp-plan-idle {
    border: 1px solid var(--light-gray);
    background: var(--parchment);
  }
  .cc-pdp-hero-apr26 .cc-pdp-plan-idle:hover {
    border-color: var(--warm-gray);
  }
  .cc-pdp-hero-apr26 .cc-pdp-plan-active {
    border: 2px solid var(--deep-ink);
    background: #FFFFFF;
  }
  .cc-pdp-hero-apr26 .cc-pdp-plan-badge {
    position: absolute;
    top: -10px;
    left: 16px;
    background: var(--forest-light);
    color: #FAF9F6;
    font-family: 'Space Grotesk', sans-serif;
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    padding: 4px 10px;
    line-height: 1;
  }
</style>

<script>
  function ccPdpBuyApr26() {
    var initialOpts = {{ current_variant.options | json }};
    return {
      loading: false,
      selectedOption0: initialOpts[0] || '',
      selectedOption1: initialOpts[1] || '',
      selectedOption2: initialOpts[2] || '',
      plan: '{%- if sp_group -%}{{ sp_group.selling_plans.first.id }}{%- endif -%}',
      variantsData: {{ product.variants | json }},
      sellingPlanAllocations: {},

      init() {
        // Build a map: variantId -> { sellingPlanId -> price }
        var self = this;
        this.variantsData.forEach(function(v) {
          self.sellingPlanAllocations[v.id] = {};
          (v.selling_plan_allocations || []).forEach(function(a) {
            self.sellingPlanAllocations[v.id][a.selling_plan_id] = a.price;
          });
        });
      },

      get currentVariant() {
        var self = this;
        var picks = [self.selectedOption0, self.selectedOption1, self.selectedOption2];
        return this.variantsData.find(function(v) {
          return v.options.every(function(opt, i) { return opt === picks[i]; });
        }) || this.variantsData[0];
      },

      get variantId() {
        return this.currentVariant ? this.currentVariant.id : '';
      },

      get currentPriceCents() {
        var v = this.currentVariant;
        if (!v) return 0;
        if (this.plan && this.sellingPlanAllocations[v.id] && this.sellingPlanAllocations[v.id][this.plan] != null) {
          return this.sellingPlanAllocations[v.id][this.plan];
        }
        return v.price;
      },

      get displayPrice() {
        var cents = this.currentPriceCents;
        return '$' + (cents / 100).toFixed(2);
      }
    };
  }
</script>

{% schema %}
{
  "name": "PDP Hero (apr26)",
  "tag": "section",
  "class": "section-cc-pdp-hero-apr26",
  "settings": [
    { "type": "image_picker", "id": "hero_image", "label": "Hero image override", "info": "Defaults to product featured image" },
    { "type": "text", "id": "hero_title", "label": "Title override", "info": "Defaults to product title" },
    { "type": "text", "id": "review_text", "label": "Review count text", "default": "200+ five-star reviews" },
    { "type": "text", "id": "trust_badges", "label": "Trust badges (comma-separated)", "default": "Vegan, Sugar-Free, Caffeine-Free, GMP Certified" },
    { "type": "textarea", "id": "hero_description", "label": "Hero description", "info": "Defaults to product.description" },
    { "type": "textarea", "id": "ingredients_line", "label": "Ingredients line (forest accent)" },
    { "type": "text", "id": "supply_line", "label": "Supply line", "default": "30-day supply. Fully dosed." },
    { "type": "header", "content": "Pricing overrides (optional — overrides computed selling-plan math)" },
    { "type": "text", "id": "monthly_price", "label": "Monthly price override", "info": "e.g. $55.20 — leave blank to compute from selling plan" },
    { "type": "text", "id": "monthly_save", "label": "Monthly save label", "default": "Save 20%" },
    { "type": "text", "id": "bimonthly_price", "label": "2-month price override" },
    { "type": "text", "id": "bimonthly_save", "label": "2-month save label", "default": "Save 10%" },
    { "type": "text", "id": "onetime_price", "label": "One-time price override" },
    { "type": "range", "id": "padding_top", "label": "Padding top (px)", "min": 0, "max": 200, "step": 4, "default": 32 },
    { "type": "range", "id": "padding_bottom", "label": "Padding bottom (px)", "min": 0, "max": 200, "step": 4, "default": 80 }
  ],
  "presets": [
    { "name": "PDP Hero (apr26)", "category": "Coastline" }
  ]
}
{% endschema %}

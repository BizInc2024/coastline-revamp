{% comment %}
  cc-parents-clone -- Coastline "for parents playing the long game" narrative.
  Pairs with SHARED sections (cc-pricing-product-apr26, cc-guarantee-final, cc-ugc-apr26,
  cc-testimonials-apr26, cc-faq-apr26, cc-final-cta-apr26, cc-email-capture-apr26) +
  the cc-ingredients-accordion snippet, inside templates/product.lp-parents-jun20.json.
  Angle: longevity for parents 35-65 — be around for all of it. Energy, strength, a clear mind.
  Structure/function claims only. FDA disclaimer integrated in the experts section.
  Hero (cc-par-hero.jpg) + card images are AI-generated -> carry in-image AI disclosure.
{% endcomment %}

{% render 'cc-deps' %}

<style>
  html { scroll-behavior: smooth; }
  .cc-par * { box-sizing: border-box; }
  .cc-par { font-family: 'Inter', sans-serif; color: #0A0A0A; }
  .cc-par .wrap { max-width: 1120px; margin: 0 auto; padding: 0 24px; }
  .cc-par h1, .cc-par h2 { font-family: 'Space Grotesk', sans-serif; font-weight: 500; letter-spacing: -0.03em; line-height: 1.0; text-wrap: balance; }

  /* HERO (brand indigo, 2-col) */
  .cc-par .hero { background: #062F3D; color: #FAF9F6; }
  .cc-par .hero-grid { display: grid; grid-template-columns: 1fr 1fr; align-items: stretch; }
  .cc-par .hero-img { position: relative; height: 780px; overflow: hidden; }
  .cc-par .hero-img img { width: 100%; height: 100%; object-fit: cover; object-position: center 58%; display: block; }
  .cc-par .ai-disc { position: absolute; bottom: 7px; right: 8px; font-size: 9px; line-height: 1; letter-spacing: 0.03em; color: rgba(255,255,255,0.72); background: rgba(0,0,0,0.30); padding: 3px 5px; border-radius: 2px; }
  .cc-par .hero-copy { padding: 56px 72px 96px; display: flex; flex-direction: column; justify-content: flex-end; }
  .cc-par .hero-cutout { width: 176px; height: 104px; background-repeat: no-repeat; background-position: left center; background-size: contain; display: block; margin: 0 0 24px; }
  .cc-par .hero-eyebrow { font-family: 'Space Grotesk', sans-serif; font-size: 12px; font-weight: 500; letter-spacing: 0.18em; text-transform: uppercase; color: #A3C7D0; margin: 0 0 20px; }
  .cc-par .stars { display: inline-flex; align-items: center; gap: 11px; font-size: 15px; letter-spacing: 0.04em; color: rgba(250,249,246,0.82); }
  .cc-par .stars .s { color: #E7FF56; letter-spacing: 3px; font-size: 21px; }
  .cc-par .hero h1 { font-size: clamp(38px, 3.8vw, 56px); line-height: 1.0; margin: 8px 0 0; color: #FAF9F6; }
  .cc-par .hero h1 em { font-style: normal; color: #E7FF56; }
  .cc-par .hero p.sub { font-size: clamp(15px, 1.15vw, 17px); line-height: 1.65; color: rgba(250,249,246,0.74); margin: 24px 0 0; max-width: 430px; letter-spacing: 0.004em; }
  .cc-par .btn { display: inline-block; background: #E7FF56; color: #062F3D; font-family: 'Space Grotesk', sans-serif; font-weight: 600; font-size: 14px; letter-spacing: 0.16em; text-transform: uppercase; padding: 22px 52px; text-decoration: none; }
  .cc-par .btn.dark { background: #0A0A0A; color: #FAF9F6; }
  .cc-par .cta-row { display: flex; flex-direction: column; align-items: flex-start; gap: 10px; margin-top: 26px; }
  .cc-par .price-anchor { font-size: 13px; color: rgba(250,249,246,0.6); margin: 4px 0 4px; }
  .cc-par .skip { font-family: 'Space Grotesk', sans-serif; font-size: 13px; font-weight: 500; letter-spacing: 0.14em; text-transform: uppercase; color: rgba(250,249,246,0.72); text-decoration: underline; text-underline-offset: 5px; }

  /* PILLARS (parchment) */
  .cc-par .pillars { background: #FAF9F6; padding: 110px 0; }
  .cc-par .pillars h2 { font-size: clamp(34px, 4.8vw, 52px); text-align: center; max-width: 760px; margin: 0 auto 14px; }
  .cc-par .pillars .lede { text-align: center; color: #6B6B6B; font-size: 19px; max-width: 600px; margin: 0 auto 64px; }
  .cc-par .grid3 { display: grid; grid-template-columns: repeat(3, 1fr); gap: 36px; }
  .cc-par .card { display: flex; flex-direction: column; }
  .cc-par .card-imgwrap { position: relative; margin-bottom: 22px; }
  .cc-par .card-img { width: 100%; aspect-ratio: 16 / 11; object-fit: cover; object-position: center 20%; display: block; }
  .cc-par .card .pnum { font-family: 'Space Grotesk', sans-serif; font-size: 12px; font-weight: 500; letter-spacing: 0.16em; text-transform: uppercase; color: #6B6B6B; margin: 0 0 10px; }
  .cc-par .card .phead { font-family: 'Space Grotesk', sans-serif; font-weight: 500; font-size: clamp(24px, 2.6vw, 30px); letter-spacing: -0.02em; line-height: 1.12; color: #0A0A0A; margin: 0 0 12px; }
  .cc-par .card .pbody { font-size: 15.5px; line-height: 1.62; color: #444; margin: 0; }
  .cc-par .pillars .cta-center { text-align: center; margin-top: 56px; }

  /* INGREDIENTS / TRANSPARENCY (pale blue Mist, flows into accordion) */
  .cc-par .band { background: #CCD7DA; color: #062F3D; padding: 96px 0 56px; }
  .cc-par .band-grid { max-width: 1120px; margin: 0 auto; padding: 0 24px; display: grid; grid-template-columns: 1.05fr 0.95fr; gap: 64px; align-items: center; }
  .cc-par .band h2 { font-size: clamp(32px, 3.8vw, 50px); margin: 0; }
  .cc-par .band p { font-size: 18px; line-height: 1.55; color: rgba(6,47,61,0.80); margin: 18px 0 0; }
  .cc-par .band-trust { font-family: 'Space Grotesk', sans-serif; font-size: 11px; letter-spacing: 0.16em; text-transform: uppercase; color: #062F3D; opacity: 0.72; margin: 22px 0 0; }
  .cc-par .band-img { position: relative; }
  .cc-par .band-img img { width: 100%; display: block; }

  /* TEAM (dark) */
  .cc-par .team { background: #0A0A0A; color: #FAF9F6; padding: 110px 0; text-align: center; }
  .cc-par .team h2 { font-size: clamp(34px, 4.8vw, 52px); max-width: 760px; margin: 0 auto; color: #FAF9F6; }
  .cc-par .team h2 em { font-style: normal; color: #E7FF56; }
  .cc-par .team .lede { font-size: 19px; line-height: 1.6; color: #9A9A9A; max-width: 620px; margin: 24px auto 0; }
  .cc-par .experts { display: grid; grid-template-columns: repeat(4, 1fr); gap: 36px 28px; max-width: 1000px; margin: 56px auto 46px; }
  .cc-par .exp { text-align: center; }
  .cc-par .exp-photo { width: 118px; height: 118px; border-radius: 50%; object-fit: cover; display: block; margin: 0 auto 18px; }
  .cc-par .exp-quote { font-size: 14.5px; line-height: 1.55; color: #D8D8D8; margin: 0 0 16px; }
  .cc-par .exp-name { font-family: 'Space Grotesk', sans-serif; font-weight: 500; font-size: 15px; color: #FAF9F6; margin: 0; }
  .cc-par .exp-role { font-size: 10px; letter-spacing: 0.14em; text-transform: uppercase; color: #6E6E6E; margin: 6px 0 0; }
  .cc-par .team .disc-in { margin: 56px auto 0; max-width: 720px; font-size: 12px; line-height: 1.55; color: #6A6A6A; text-align: center; border-top: 1px solid #2A2A2A; padding-top: 30px; }

  @media (max-width: 749px) {
    .cc-par .hero-grid { grid-template-columns: 1fr; }
    .cc-par .hero-img { height: 340px; order: -1; }
    .cc-par .hero-copy { padding: 56px 28px 64px; }
    .cc-par .hero-cutout { width: 122px; height: 72px; margin-bottom: 18px; }
    .cc-par .grid3 { grid-template-columns: 1fr; gap: 40px; }
    .cc-par .card-img { aspect-ratio: 16 / 9; }
    .cc-par .pillars, .cc-par .team, .cc-par .band { padding: 72px 0; }
    .cc-par .band-grid { grid-template-columns: 1fr; gap: 40px; }
    .cc-par .experts { grid-template-columns: repeat(2, 1fr); gap: 40px 20px; }
  }
</style>

<section class="cc-par cc-landingpage-v6">


    <!-- SECTION 11: Blueprint-SPECIFIC FAQ -->
    <section class="py-20 lg:py-28 bg-parchment">
        <div class="max-w-3xl mx-auto px-8 lg:px-16">
            <div class="text-center mb-16">
                <p class="section-counter mb-6">{{ section.settings.faq_counter | default: 'Questions & Answers' }}</p>
                <div class="editorial-divider mx-auto mb-10"></div>
                <h2 class="text-3xl lg:text-4xl font-grotesk font-medium">{{ section.settings.faq_headline | default: 'Frequently asked questions.' }}</h2>
            </div>
            <div class="space-y-4" x-data="{ openFaq: null }">
                <div class="border border-light-gray bg-white">
                    <button class="w-full flex justify-between items-center p-6 text-left" @click="openFaq = openFaq === 1 ? null : 1">
                        <span class="font-grotesk text-deep-ink pr-8">{{ section.settings.faq_1_question | default: 'How is Coastline different from Blueprint?' }}</span>
                        <svg class="w-5 h-5 text-warm-gray transition-transform" :class="{ 'rotate-180': openFaq === 1 }" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/></svg>
                    </button>
                    <div class="accordion-content" :class="{ 'open': openFaq === 1 }">
                        <div class="px-6 pb-6 text-warm-gray">{{ section.settings.faq_1_answer | default: '<p>Coastline uses 13 clinically dosed ingredients with full transparency. Blueprint uses 75 ingredients in proprietary blends, meaning you cannot verify what dose of each ingredient you are actually getting. Coastline also includes an AM/PM system optimized for your circadian rhythm.</p>' }}</div>
                    </div>
                </div>

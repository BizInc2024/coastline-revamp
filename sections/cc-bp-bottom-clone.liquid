                    </button>
                    <div class="accordion-content" :class="{ 'open': openFaq === 2 }">
                        <div class="px-6 pb-6 text-warm-gray">{{ section.settings.faq_2_answer | default: '<p>Blueprint spreads $79 across 75 ingredients at trace amounts (~$1.05 per ingredient per month). Coastline invests $99 in 13 ingredients at clinical doses (~$7.62 per ingredient per month). You are paying for doses that match actual clinical trials, not a long ingredient list.</p>' }}</div>
                    </div>
                </div>
                <div class="border border-light-gray bg-white">
                    <button class="w-full flex justify-between items-center p-6 text-left" @click="openFaq = openFaq === 3 ? null : 3">
                        <span class="font-grotesk text-deep-ink pr-8">{{ section.settings.faq_3_question | default: 'Does Coastline include a greens blend?' }}</span>

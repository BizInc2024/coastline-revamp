                            <p class="text-sm tracking-widest uppercase" style="color: #FAF9F6;">{{ section.settings.expert_4_name | default: '- Chris Pollock, MD' }}</p>
                            <p class="text-xs tracking-wider" style="color: rgba(250,249,246,0.5);">{{ section.settings.expert_4_credential | default: 'Physician & Coastline Co-Founder' }}</p>

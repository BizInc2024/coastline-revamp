                    <div class="flex items-center gap-4 mb-6">
                        <img src="https://cdn.shopify.com/s/files/1/0619/6861/3445/files/Nic_Portrait.webp?v=1767053015" alt="Dr. Nicolas Verhoeven" class="w-16 h-16 rounded-full object-cover">
                        <div>
                            <p class="text-sm tracking-widest uppercase" style="color: #FAF9F6;">{{ section.settings.expert_3_name | default: '- Dr. Nicolas Verhoeven' }}</p>
                            <p class="text-xs tracking-wider" style="color: rgba(250,249,246,0.5);">{{ section.settings.expert_3_credential | default: 'Ph.D. in Molecular Medicine' }}</p>

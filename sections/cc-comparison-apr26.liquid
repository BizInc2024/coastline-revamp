{%- comment -%}
  cc-comparison-apr26 — Comparison table
  Extracted from cc-homepage.liquid (Apr 26 rebuild, vanilla re-scope)
{%- endcomment -%}

{% render 'cc-deps' %}

<div class="cc-apr26 cc-comparison-apr26">
    <section class="bg-parchment reveal" style="padding-top:{{ section.settings.section9_padding_top | default: 80 }}px;padding-bottom:{{ section.settings.section9_padding_bottom | default: 80 }}px;" x-intersect.once="$el.classList.add('visible')">
      <div class="max-w-6xl mx-auto px-8 lg:px-16 text-center">
  
        {%- assign comparison_label = section.settings.comparison_label | default: "HOW COASTLINE COMPARES" -%}
        {%- assign comparison_headline = section.settings.comparison_headline | default: "More targeted. More transparent. More trusted." -%}
        {%- if comparison_label != blank -%}
          <span class="badge-minimal">{{ comparison_label }}</span>
        {%- endif -%}
        {%- if comparison_headline != blank -%}
          <h2 class="text-deep-ink max-w-2xl mx-auto mt-4 mb-12 leading-snug" style="font-size:clamp(1.25rem,3.2vw,2.4rem);">
            {{ comparison_headline }}
          </h2>
        {%- endif -%}
  
        {%- comment -%} SVG icon captures for comparison table {%- endcomment -%}
        {%- capture svg_check -%}<svg width="22" height="22" viewBox="0 0 24 24" fill="none" style="display:inline-block;"><circle cx="12" cy="12" r="12" fill="#1A3A2F"/><path d="M7 12.5L10.5 16L17 9" stroke="white" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>{%- endcapture -%}
        {%- capture svg_empty -%}<svg width="22" height="22" viewBox="0 0 24 24" fill="none" style="display:inline-block;"><circle cx="12" cy="12" r="11" stroke="#E8E8E8" stroke-width="2" fill="none"/></svg>{%- endcapture -%}
  
        <p class="text-center mb-4 md:hidden" style="font-size:11px;color:var(--warm-gray);letter-spacing:0.1em;">SCROLL RIGHT TO COMPARE &rarr;</p>
        <div class="overflow-x-auto" style="-webkit-overflow-scrolling:touch;">
          <table style="min-width:520px;width:100%;border-collapse:collapse;">
            <thead>
              <tr>
                <th style="padding:20px 12px;text-align:left;min-width:140px;font-weight:400;color:var(--warm-gray);font-size:12px;letter-spacing:0.03em;"></th>
                <th style="padding:20px 12px;background:var(--deep-ink);color:var(--parchment);font-family:'Space Grotesk',sans-serif;font-weight:500;font-size:13px;letter-spacing:0.05em;min-width:90px;text-align:center;">COASTLINE</th>
                <th style="padding:20px 12px;font-weight:400;color:var(--warm-gray);font-size:12px;letter-spacing:0.03em;min-width:80px;text-align:center;">NOVOS</th>
                <th style="padding:20px 12px;font-weight:400;color:var(--warm-gray);font-size:12px;letter-spacing:0.03em;min-width:80px;text-align:center;">BLUEPRINT</th>
                <th style="padding:20px 12px;font-weight:400;color:var(--warm-gray);font-size:12px;letter-spacing:0.03em;min-width:80px;text-align:center;">AG1</th>
                <th style="padding:20px 12px;font-weight:400;color:var(--warm-gray);font-size:12px;letter-spacing:0.03em;min-width:80px;text-align:center;">MITOPURE</th>
              </tr>
            </thead>
            <tbody>
              <tr style="border-top:1px solid var(--light-gray);">
                <td style="padding:16px 12px;font-size:14px;font-weight:500;color:var(--deep-ink);">Active ingredients</td>
                <td style="padding:16px 12px;background:#F5F5F2;text-align:center;font-family:'Space Grotesk',sans-serif;font-weight:600;">13</td>
                <td style="padding:16px 12px;text-align:center;color:var(--warm-gray);">12</td>
                <td style="padding:16px 12px;text-align:center;color:var(--warm-gray);">40+</td>
                <td style="padding:16px 12px;text-align:center;color:var(--warm-gray);">75</td>
                <td style="padding:16px 12px;text-align:center;color:var(--warm-gray);">1</td>
              </tr>
              <tr style="border-top:1px solid var(--light-gray);">
                <td style="padding:16px 12px;font-size:14px;font-weight:500;color:var(--deep-ink);">Clinical dosing</td>
                <td style="padding:16px 12px;background:#F5F5F2;text-align:center;">{{ svg_check }}</td>
                <td style="padding:16px 12px;text-align:center;">{{ svg_check }}</td>
                <td style="padding:16px 12px;text-align:center;">{{ svg_check }}</td>
                <td style="padding:16px 12px;text-align:center;">{{ svg_empty }}</td>
                <td style="padding:16px 12px;text-align:center;">{{ svg_check }}</td>
              </tr>
              <tr style="border-top:1px solid var(--light-gray);">
                <td style="padding:16px 12px;font-size:14px;font-weight:500;color:var(--deep-ink);">Full transparency</td>
                <td style="padding:16px 12px;background:#F5F5F2;text-align:center;">{{ svg_check }}</td>
                <td style="padding:16px 12px;text-align:center;">{{ svg_check }}</td>
                <td style="padding:16px 12px;text-align:center;">{{ svg_check }}</td>
                <td style="padding:16px 12px;text-align:center;">{{ svg_empty }}</td>
                <td style="padding:16px 12px;text-align:center;">{{ svg_check }}</td>
              </tr>
              <tr style="border-top:1px solid var(--light-gray);">
                <td style="padding:16px 12px;font-size:14px;font-weight:500;color:var(--deep-ink);">All 12 hallmarks</td>
                <td style="padding:16px 12px;background:#F5F5F2;text-align:center;">{{ svg_check }}</td>
                <td style="padding:16px 12px;text-align:center;">{{ svg_check }}</td>
                <td style="padding:16px 12px;text-align:center;">{{ svg_check }}</td>
                <td style="padding:16px 12px;text-align:center;">{{ svg_empty }}</td>
                <td style="padding:16px 12px;text-align:center;">{{ svg_empty }}</td>
              </tr>
              <tr style="border-top:1px solid var(--light-gray);">
                <td style="padding:16px 12px;font-size:14px;font-weight:500;color:var(--deep-ink);">AM/PM system</td>
                <td style="padding:16px 12px;background:#F5F5F2;text-align:center;">{{ svg_check }}</td>
                <td style="padding:16px 12px;text-align:center;">{{ svg_empty }}</td>
                <td style="padding:16px 12px;text-align:center;">{{ svg_empty }}</td>
                <td style="padding:16px 12px;text-align:center;">{{ svg_empty }}</td>
                <td style="padding:16px 12px;text-align:center;">{{ svg_empty }}</td>
              </tr>
              <tr style="border-top:1px solid var(--light-gray);">
                <td style="padding:16px 12px;font-size:14px;font-weight:500;color:var(--deep-ink);">All 11 body systems</td>
                <td style="padding:16px 12px;background:#F5F5F2;text-align:center;">{{ svg_check }}</td>
                <td style="padding:16px 12px;text-align:center;">{{ svg_empty }}</td>
                <td style="padding:16px 12px;text-align:center;">{{ svg_empty }}</td>
                <td style="padding:16px 12px;text-align:center;">{{ svg_empty }}</td>
                <td style="padding:16px 12px;text-align:center;">{{ svg_empty }}</td>
              </tr>
              <tr style="border-top:1px solid var(--light-gray);border-bottom:1px solid var(--light-gray);">
                <td style="padding:16px 12px;font-size:14px;font-weight:500;color:var(--deep-ink);">Price/month</td>
                <td style="padding:16px 12px;background:#F5F5F2;text-align:center;font-family:'Space Grotesk',sans-serif;font-weight:600;color:var(--deep-ink);">$99</td>
                <td style="padding:16px 12px;text-align:center;color:var(--warm-gray);">$109</td>
                <td style="padding:16px 12px;text-align:center;color:var(--warm-gray);">$179+</td>
                <td style="padding:16px 12px;text-align:center;color:var(--warm-gray);">$79</td>
                <td style="padding:16px 12px;text-align:center;color:var(--warm-gray);">$125</td>
              </tr>
            </tbody>
          </table>
        </div>
        <p style="text-align:center;max-width:520px;margin:24px auto 0;font-size:15px;color:var(--deep-ink);line-height:1.6;">
          {{ section.settings.comparison_footnote | default: "More ingredients doesn't mean better science. Every Coastline ingredient is dosed at the level proven effective in clinical trials -- not included at trace amounts to pad a label." }}
        </p>
        <p style="text-align:center;margin-top:16px;font-size:11px;color:var(--warm-gray);letter-spacing:0.05em;">
          Comparison based on publicly available product information. Prices reflect monthly subscription rates.
        </p>
      </div>
    </section>
</div>

{% schema %}
{
  "name": "Comparison table (apr26)",
  "tag": "section",
  "class": "section-cc-comparison-apr26",
  "settings": [
    { "type": "text", "id": "comparison_label", "label": "Eyebrow label", "default": "HOW COASTLINE COMPARES" },
    { "type": "text", "id": "comparison_headline", "label": "Headline", "default": "More targeted. More transparent. More trusted." }
  ],
  "presets": [
    {
      "name": "Comparison table (apr26)",
      "category": "Coastline"
    }
  ]
}
{% endschema %}

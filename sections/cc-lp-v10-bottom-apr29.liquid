            <tr><td class="attr">Cost per day</td><td class="coastline">$3.30</td><td class="typical">$2.60</td><td class="typical">$6-10+</td></tr>
            <tr><td class="attr">60-day guarantee</td><td class="coastline"><span class="check">&#10003;</span></td><td class="typical">30 days</td><td class="typical">Varies</td></tr>

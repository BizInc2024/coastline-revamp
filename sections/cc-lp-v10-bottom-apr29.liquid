            <tr><td class="attr">Every dose published</td><td class="coastline"><span class="check">&#10003;</span></td><td class="typical"><span class="miss">&times;</span> Hidden</td><td class="typical"><span class="check">&#10003;</span></td></tr>
            <tr><td class="attr">Mystery ingredient blends</td><td class="coastline">None</td><td class="typical">50+</td><td class="typical">Varies</td></tr>

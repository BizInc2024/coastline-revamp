{
  "name": "Our approach (deep blue)",
  "tag": "section",
  "class": "section-cc-expert-apr26",
  "settings": [],
  "presets": [
    {
      "name": "Our approach (deep blue)",
      "category": "Coastline"
    }
  ]
}
{% endschema %}

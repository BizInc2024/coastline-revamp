{%- comment -%}
  cc-expert-db — Expert Narrative (deep blue copy of cc-expert-apr26)
  Extracted from cc-homepage.liquid (Apr 26 rebuild, vanilla re-scope)
{%- endcomment -%}

{% render 'cc-deps' %}

<div class="cc-apr26 cc-expert-apr26">
    <section class="reveal" x-init="setTimeout(() => $el.classList.add('visible'), 100)" style="background-color:#062F3D;background-image:linear-gradient(rgba(6,47,61,.82),rgba(6,47,61,.82)),url({{ 'cc-beach-day.jpg' | asset_url }});background-size:cover;background-position:center;padding-top:{{ section.settings.section11_padding_top | default: 80 }}px;padding-bottom:{{ section.settings.section11_padding_bottom | default: 80 }}px;" x-intersect.once="$el.classList.add('visible')">
      <div class="cc-ap">
        <p class="cc-ap__eyebrow">{{ section.settings.founder_label | default: "Our approach" }}</p>
        <h2 class="cc-ap__headline">{{ section.settings.founder_headline | default: "Rigorously built by researchers, not marketers" | replace: 'researchers, ', 'researchers,<br> ' }}</h2>
        <div class="cc-ap__body">{{ section.settings.founder_body | default: "The wellness industry is loud, contradictory, and exhausting. One expert swears by this. Another says it is worthless. You are left with a cabinet full of half-used bottles and more questions than answers." | newline_to_br }}</div>
        <div class="cc-ap__people">
          <figure class="cc-ap__person">
            {%- if section.settings.expert_image_1 != blank -%}<img src="{{ section.settings.expert_image_1 | image_url: width: 400 }}" alt="Greg Potter, PhD" width="400" height="400" loading="lazy">{%- else -%}<img src="https://cdn.shopify.com/s/files/1/0619/6861/3445/files/Greg_Portrait.webp?v=1767053015&width=400" alt="Greg Potter, PhD" width="400" height="400" loading="lazy">{%- endif -%}
            <figcaption>Greg Potter, PhD</figcaption>
          </figure>
          <figure class="cc-ap__person">
            {%- if section.settings.expert_image_2 != blank -%}<img src="{{ section.settings.expert_image_2 | image_url: width: 400 }}" alt="Dr. Jacqueline Jacques, ND" width="400" height="400" loading="lazy">{%- else -%}<img src="https://cdn.shopify.com/s/files/1/0619/6861/3445/files/Jessicabodasphotography-jacques.webp?v=1767053015&width=400" alt="Dr. Jacqueline Jacques, ND" width="400" height="400" loading="lazy">{%- endif -%}
            <figcaption>Dr. Jacqueline Jacques, ND</figcaption>
          </figure>
          <figure class="cc-ap__person">
            {%- if section.settings.expert_image_3 != blank -%}<img src="{{ section.settings.expert_image_3 | image_url: width: 400 }}" alt="Dr. Nicolas Verhoeven, PhD" width="400" height="400" loading="lazy">{%- else -%}<img src="https://cdn.shopify.com/s/files/1/0619/6861/3445/files/Nic_Portrait.webp?v=1767053015&width=400" alt="Dr. Nicolas Verhoeven, PhD" width="400" height="400" loading="lazy">{%- endif -%}
            <figcaption>Dr. Nicolas Verhoeven, PhD</figcaption>
          </figure>
          <figure class="cc-ap__person">
            {%- if section.settings.expert_image_4 != blank -%}<img src="{{ section.settings.expert_image_4 | image_url: width: 400 }}" alt="Chris Pollock, MD" width="400" height="400" loading="lazy">{%- else -%}<img src="https://cdn.shopify.com/s/files/1/0619/6861/3445/files/CL-ChrisP-Scientist.webp?v=1767053015&width=400" alt="Chris Pollock, MD" width="400" height="400" loading="lazy">{%- endif -%}
            <figcaption>Chris Pollock, MD</figcaption>
          </figure>
        </div>
        {%- if section.settings.founder_link_text != blank and section.settings.founder_link_url != blank -%}
          {%- assign _furl = section.settings.founder_link_url -%}
          {%- assign _furl_start = _furl | slice: 0 -%}
          {%- assign _furl_proto = _furl | slice: 0, 4 -%}
          {%- if _furl_start != '/' and _furl_start != '#' and _furl_proto != 'http' -%}
            {%- assign _furl = 'https://' | append: _furl -%}
          {%- endif -%}
          <a href="{{ _furl }}" style="display:inline-block;padding:16px 40px;font-family:'Space Grotesk',sans-serif;font-weight:500;font-size:12px;letter-spacing:0.18em;text-transform:uppercase;color:#FAF9F6;border:1px solid #FAF9F6;text-decoration:none;transition:all 0.3s ease;background:transparent;">
            {{ section.settings.founder_link_text }}
          </a>
        {%- endif -%}
      </div>
    </section>
</div>

<style>
  .cc-ap { max-width: 1080px; margin: 0 auto; padding: 0 24px; text-align: center; }
  .cc-ap__eyebrow { font-family: 'Inter', system-ui, sans-serif; font-size: 12px; font-weight: 600; letter-spacing: .16em; text-transform: uppercase; color: rgba(243,238,229,.7); margin: 0 0 20px; }
  .cc-ap__headline { font-family: 'Space Grotesk', system-ui, sans-serif; font-weight: 500; font-size: clamp(30px, 4vw, 52px); line-height: 1.1; letter-spacing: -.02em; color: #F3EEE5 !important; margin: 0 0 28px; text-wrap: balance; }
  .cc-ap__body a { color: inherit; text-decoration: underline; text-decoration-color: #E7FF56; text-underline-offset: 4px; text-decoration-thickness: 1px; }
  .cc-ap__body a:hover { opacity: .8; }
  .cc-ap__body { font-family: 'Inter', system-ui, sans-serif; font-weight: 400; font-size: clamp(17px, 1.5vw, 20px); line-height: 1.6; color: rgba(255,255,255,.88); max-width: 600px; margin: 0 auto 64px; text-wrap: pretty; }
  .cc-ap__people { display: grid; grid-template-columns: repeat(2, 1fr); gap: 40px 16px; margin: 0 auto 56px; }
  .cc-ap__person { margin: 0; }
  .cc-ap__person img { width: 132px; height: 132px; border-radius: 50%; object-fit: cover; display: block; margin: 0 auto 16px; box-shadow: 0 0 0 1px rgba(243,238,229,.45), 0 0 0 6px rgba(243,238,229,.08); }
  .cc-ap__person figcaption { font-family: 'Space Grotesk', sans-serif; font-weight: 500; font-size: 15px; line-height: 1.35; color: #fff; }
  @media (min-width: 900px) {
    .cc-ap__people { grid-template-columns: repeat(4, 1fr); gap: 24px; }
    .cc-ap__person img { width: 180px; height: 180px; margin-bottom: 20px; }
    .cc-ap__person figcaption { font-size: 16px; white-space: nowrap; }
  }
</style>
<style>
@media (max-width: 639px) {
    .cc-expert-apr26 .cc-expert-grid {
      grid-template-columns: repeat(2, 1fr) !important;
      gap: 20px !important;
    }
  }
</style>


{% comment %}
  cc-blueprint-comparison — Coastline vs Blueprint narrative section
  Extracted from sections/cc-landingpage-v11-blueprint.liquid (Apr 26 rebuild).
  Pairs with cc-pricing-product-apr26 (cart) + cc-email-capture-apr26 inside
  templates/product.lp-blueprint-apr26.json. Live LP (page.cc-landingpage-v11-blueprint)
  remains untouched.
{% endcomment %}

{% render 'cc-deps' %}

<style>
    html { scroll-behavior: smooth; }
    .cc-blueprint-comparison p { max-width: none !important; }
    .cc-blueprint-comparison h1, .cc-blueprint-comparison h2 { text-wrap: balance; }

    .editorial-divider { width: 60px; height: 1px; background: #0A0A0A; }
    .section-counter { font-family: 'Inter', sans-serif; font-size: 11px; font-weight: 400; letter-spacing: 0.15em; text-transform: uppercase; color: #6B6B6B; }

    .accordion-content { max-height: 0; overflow: hidden; transition: max-height 0.5s cubic-bezier(0.4, 0, 0.2, 1); }
    .accordion-content.open { max-height: 2000px; }

    .cc-blueprint-comparison footer .cc-v6-footer-cta {
        display: inline-block !important; width: auto !important; min-width: 0 !important; min-height: 0 !important;
        padding: 20px 48px !important; margin: 0 !important; box-shadow: none !important; border-radius: 0 !important; border: none !important; box-sizing: border-box !important;
    }

    .v6-blockquote { font-family: 'Space Grotesk', sans-serif; font-size: clamp(28px, 5vw, 48px); font-weight: 500; line-height: 1.2; letter-spacing: -0.02em; color: #FAF9F6; }
    .v6-study-card { background: rgba(255,255,255,0.05); border: 1px solid rgba(255,255,255,0.1); padding: 32px; margin-top: 40px; }
    .v6-study-card li { display: flex; align-items: flex-start; gap: 12px; padding: 10px 0; font-size: 15px; color: #9A9A9A; }

    .v6-table-scroll { overflow-x: auto; display: block; }
    .v6-comparison-table { width: 100%; border-collapse: collapse; }
    .v6-comparison-table th, .v6-comparison-table td { padding: 16px 12px; text-align: left; border-bottom: 1px solid #E8E8E8; font-size: 14px; }
    .v6-comparison-table th { font-weight: 500; color: #0A0A0A; font-family: 'Space Grotesk', sans-serif; font-size: 12px; letter-spacing: 0.1em; text-transform: uppercase; }
    .v6-comparison-table td:first-child { color: #6B6B6B; min-width: 140px; }
    .v6-comparison-table .v6-check { color: #2D5A47; font-weight: 600; }
    .v6-comparison-table .v6-x { color: #C0392B; font-weight: 600; }

    .v6-star-table { width: 100%; border-collapse: collapse; }
    .v6-star-table th, .v6-star-table td { padding: 16px 12px; text-align: center; border-bottom: 1px solid #E8E8E8; }
    .v6-star-table th { font-weight: 500; font-family: 'Space Grotesk', sans-serif; font-size: 12px; letter-spacing: 0.1em; text-transform: uppercase; color: #0A0A0A; }
    .v6-star-table td:first-child { text-align: left; color: #6B6B6B; font-size: 14px; }
    .v6-star-table .v6-stars { letter-spacing: 2px; font-size: 16px; color: #0A0A0A; }
    .v6-star-table-dark th, .v6-star-table-dark td { border-bottom-color: rgba(250,249,246,0.1); }
    .v6-star-table-dark th { color: rgba(250,249,246,0.5); }
    .v6-star-table-dark td:first-child { color: rgba(250,249,246,0.6); }
    .v6-star-table-dark .v6-stars { color: #FAF9F6; }

    .v6-ingredient-card { border: 1px solid #E8E8E8; padding: 20px; text-align: center; }
    .v6-ingredient-card p:first-of-type { font-family: 'Space Grotesk', sans-serif; font-weight: 500; font-size: 15px; color: #0A0A0A; margin-bottom: 4px; }
    .v6-ingredient-card p:last-of-type { font-size: 12px; color: #6B6B6B; }

    .cc-blueprint-comparison .btn-primary {
        display: inline-block;
        background-color: #0A0A0A;
        color: #FAF9F6;
        font-family: 'Space Grotesk', sans-serif;
        font-weight: 500;
        font-size: 12px;
        letter-spacing: 0.18em;
        text-transform: uppercase;
        padding: 20px 48px;
        text-decoration: none;
        transition: opacity 0.3s ease;
        cursor: pointer;
        border: none;
    }
    .cc-blueprint-comparison .btn-primary:hover { opacity: 0.8; }

    /* Flavor selector active state */
    .cc-blueprint-comparison .v6-flavor-btn { border: 1px solid #E8E8E8; padding: 16px; text-align: center; cursor: pointer; transition: all 0.2s ease; }
    .cc-blueprint-comparison .v6-flavor-btn.active { border-color: #0A0A0A; box-shadow: 0 0 0 2px #0A0A0A; }

    /* Plan selector active state */
    .cc-blueprint-comparison .v6-plan-btn { width: 100%; text-align: left; cursor: pointer; transition: all 0.2s ease; border: 1px solid #E8E8E8; padding: 16px; }
    .cc-blueprint-comparison .v6-plan-btn.active { border: 2px solid #0A0A0A; }@media (prefers-reduced-motion: reduce) { .reveal { opacity: 1; transform: none; } }
</style>

<div class="cc-apr26 cc-blueprint-comparison" x-data="{ visibleBatches: 2 }">
    <!-- SECTION 1: EDITORIAL HERO -->
    <section id="hero" class="pt-2 pb-12 lg:pt-4 lg:pb-16 bg-parchment">
        <div class="max-w-3xl mx-auto px-6 sm:px-8 text-center">
            <div class="reveal" x-init="setTimeout(() => $el.classList.add('visible'), 100)" x-intersect="$el.classList.add('visible')">
                <p class="section-counter mb-6">{{ section.settings.hero_eyebrow | default: 'SUPPLEMENT COMPARISON - UPDATED APRIL 2026' }}</p>
                <div class="editorial-divider mx-auto mb-10"></div>
                <h1 class="text-3xl md:text-4xl lg:text-5xl xl:text-6xl font-grotesk font-medium mb-8 leading-tight text-deep-ink">
                    {{ section.settings.hero_headline | default: 'Coastline vs Blueprint: Same Goal. Very Different Approach.' }}
                </h1>
                <p class="text-lg lg:text-xl text-warm-gray mb-8 max-w-2xl mx-auto leading-relaxed">
                    {{ section.settings.hero_subheadline | default: 'Blueprint sells 7 products with 74 compounds for $361/month. Coastline uses 13 clinically dosed ingredients for $99/month. We compared the science, the doses, and the value.' }}
                </p>
                <div class="flex flex-col items-center gap-4 mt-6">
                    <a href="#v6-comparison" class="btn-primary">{{ section.settings.hero_cta_text | default: 'See the Full Comparison' }}</a>
                    <a href="#v6-takeaways" class="link-underline" style="font-size:12px; color:var(--warm-gray);">SKIP TO THE KEY TAKEAWAYS</a>
                </div>

                <!-- Side-by-side product images -->
                <div class="grid grid-cols-2 gap-8 mt-16 max-w-3xl mx-auto">
                    <div style="text-align: center;">
                        <div style="height: 240px; display: flex; align-items: flex-end; justify-content: center;">
                            <img src="{{ 'cc-coastline-family-cutout.png' | asset_url }}" alt="Coastline" style="max-height: 165px; max-width: 75%; width: auto; object-fit: contain;" loading="lazy">
                        </div>
                        <p class="text-xs tracking-widest uppercase text-deep-ink mt-4">Coastline</p>
                        <p class="text-xs text-warm-gray mt-1">13 clinical-dose ingredients</p>
                    </div>
                    <div style="text-align: center;">
                        <div style="height: 240px; display: flex; align-items: flex-end; justify-content: center;">
                            <img src="{{ 'cc-v6-blueprint-product.webp' | asset_url }}" alt="Blueprint" style="max-height: 220px; max-width: 100%; width: auto; object-fit: contain;" loading="lazy">
                        </div>
                        <p class="text-xs tracking-widest uppercase text-warm-gray mt-4">Blueprint</p>
                        <p class="text-xs text-warm-gray mt-1">74 compounds across 7 products</p>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- THE BLUEPRINT PROBLEM -->
    <section class="py-16 lg:py-24" style="background-color: #0A0A0A;">
        <div class="max-w-2xl mx-auto px-6 sm:px-8">
            <div class="reveal" x-init="setTimeout(() => $el.classList.add('visible'), 100)" x-intersect="$el.classList.add('visible')">
                <div class="flex items-center gap-4 mb-8">
                    <img src="{{ 'cc-v6-bryan-johnson.jpg' | asset_url }}" alt="Bryan Johnson" style="width: 64px; height: 64px; border-radius: 50%; object-fit: cover; border: 1px solid rgba(250,249,246,0.2);" loading="lazy">
                    <div>
                        <p class="text-xs tracking-widest uppercase" style="color: rgba(250,249,246,0.5);">The Background</p>
                        <p style="color: rgba(250,249,246,0.4); font-size: 13px; margin-top: 2px;">Bryan Johnson, Blueprint founder</p>
                    </div>
                </div>
                <div style="width:60px; height:1px; background:rgba(250,249,246,0.2); margin-bottom:40px;"></div>
                <h2 class="font-grotesk text-2xl lg:text-3xl font-medium mb-8" style="color: #FAF9F6;">Blueprint was built around one person's experimental protocol.</h2>
                <p style="color: #9A9A9A; font-size: 17px; line-height: 1.7; margin-bottom: 24px;">Bryan Johnson spent millions testing longevity interventions on himself -- bloodwork every month, dozens of experimental compounds, a protocol that once included rapamycin and growth hormone. He turned that personal experiment into a consumer brand called Blueprint.</p>
                <p style="color: #9A9A9A; font-size: 17px; line-height: 1.7; margin-bottom: 24px;">The retail stack: 7 products, 74 compounds, $361 per month. Several of those compounds have limited human trial data &mdash; some are experimental, others are drawn from animal studies. In 2024, Johnson dropped rapamycin after admitting it probably did more harm than good. He stopped growth hormone after side effects including elevated blood glucose.</p>
                <p style="color: #FAF9F6; font-size: 17px; line-height: 1.7; font-weight: 500;">Coastline takes a different approach: 13 ingredients, each backed by published human clinical trials, at the doses those trials used. No experimental compounds. No guesswork.</p>
            </div>
        </div>
    </section>

    <!-- COMPARISON SECTION -->
    <section id="v6-comparison" class="py-20 lg:py-28 bg-white">
        <div class="max-w-5xl mx-auto px-6 sm:px-8">

            <!-- INGREDIENT COMPARISON (first) -->
            <div class="text-center mb-16 reveal" x-init="setTimeout(() => $el.classList.add('visible'), 100)" x-intersect="$el.classList.add('visible')">
                <p class="section-counter mb-6">Comparison</p>
                <div class="editorial-divider mx-auto mb-10"></div>
                <h2 class="text-3xl lg:text-4xl font-grotesk font-medium mb-4">Side by side product comparison</h2>
            </div>

            <div class="mb-20 reveal" x-init="setTimeout(() => $el.classList.add('visible'), 100)" x-intersect="$el.classList.add('visible')">

                <div class="v6-table-scroll">
                    <table class="v6-comparison-table" style="min-width: 520px;">
                        <thead>
                            <tr>
                                <th style="min-width:160px;"></th>
                                <th style="text-align:center;">Coastline</th>
                                <th style="text-align:center;">Blueprint</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr><td>Daily cost</td><td class="v6-check" style="text-align:center;">$3.30/day</td><td class="v6-x" style="text-align:center;">$12/day</td></tr>
                            <tr><td>Ingredients</td><td style="text-align:center; color:#0A0A0A;">13 (clinically dosed)</td><td style="text-align:center; color:#6B6B6B;">74 compounds</td></tr>
                            <tr><td>Products to manage</td><td class="v6-check" style="text-align:center;">1 system, 2 moments</td><td class="v6-x" style="text-align:center;">7 separate products</td></tr>
                            <tr><td>Creatine</td><td class="v6-check" style="text-align:center;">5.25g (clinical dose)</td><td class="v6-x" style="text-align:center;">2.5g (half dose)</td></tr>
                            <tr><td>Taurine</td><td class="v6-check" style="text-align:center;">3g</td><td style="text-align:center; color:#6B6B6B;">1.5g (half the clinical dose)</td></tr>
                            <tr><td>CoQ10</td><td class="v6-check" style="text-align:center;">200mg</td><td style="text-align:center; color:#6B6B6B;">Present (as ubiquinol)</td></tr>
                            <tr><td>Ergothioneine</td><td class="v6-check" style="text-align:center;">5mg</td><td class="v6-x" style="text-align:center;">Not included</td></tr>
                            <tr><td>Astaxanthin</td><td class="v6-check" style="text-align:center;">12mg</td><td class="v6-x" style="text-align:center;">Not included</td></tr>
                            <tr><td>Human trial evidence</td><td class="v6-check" style="text-align:center;">Every ingredient backed by published human trials</td><td class="v6-x" style="text-align:center;">Several ingredients lack human data</td></tr>
                            <tr><td>Vitamin E safety</td><td class="v6-check" style="text-align:center;">Not included (by design)</td><td class="v6-x" style="text-align:center;">447% DV (potential concern)</td></tr>
                            <tr><td>Caffeine-free</td><td class="v6-check" style="text-align:center;">&#10003;</td><td class="v6-check" style="text-align:center;">&#10003;</td></tr>
                            <tr><td>Vegan</td><td class="v6-check" style="text-align:center;">&#10003;</td><td class="v6-check" style="text-align:center;">&#10003;</td></tr>
                            <tr><td>Designed for</td><td style="text-align:center; color:#0A0A0A;">Evidence-based population health</td><td style="text-align:center; color:#6B6B6B;">One person's bloodwork</td></tr>
                        </tbody>
                    </table>
                </div>
            </div>

            <!-- PRICE CARDS (below ingredient table) -->
            <div class="grid md:grid-cols-2 gap-6 mb-12 max-w-4xl mx-auto reveal" x-init="setTimeout(() => $el.classList.add('visible'), 100)" x-intersect="$el.classList.add('visible')">
                <div style="border: 1px solid #0A0A0A; padding: 40px 32px; position: relative; display: flex; flex-direction: column;">
                    <span style="position: absolute; top: -10px; left: 50%; transform: translateX(-50%); background: #2D5A47; color: white; font-size: 10px; font-weight: 500; letter-spacing: 0.12em; padding: 5px 14px; text-transform: uppercase;">Better Value</span>
                    <div style="height: 140px; display: flex; align-items: center; justify-content: center; margin-bottom: 24px;">
                        <img src="{{ 'cc-coastline-family-cutout.png' | asset_url }}" alt="Coastline" style="max-height: 120px; max-width: 100%; object-fit: contain;" loading="lazy">
                    </div>
                    <p class="text-xs tracking-widest uppercase text-warm-gray mb-3" style="text-align: center;">Coastline</p>
                    <p style="text-align: center; font-family: 'Space Grotesk', sans-serif; font-size: 40px; font-weight: 500; color: #0A0A0A; line-height: 1; margin-bottom: 20px;">$99<span style="font-size: 16px; color: #6B6B6B; font-weight: 400;">/mo</span></p>
                    <div style="border-top: 1px solid #E8E8E8; padding-top: 20px; text-align: center; flex: 1;">
                        <p style="font-size: 14px; color: #6B6B6B; margin-bottom: 8px;">13 ingredients at clinical doses</p>
                        <p style="font-size: 14px; color: #6B6B6B; margin-bottom: 8px;">$3.30/day &middot; $1,188/year</p>
                        <p style="font-size: 12px; color: #2D5A47; margin-top: 16px; line-height: 1.5;">Every ingredient at its clinical dose</p>
                    </div>
                </div>
                <div style="border: 1px solid #E8E8E8; padding: 40px 32px; display: flex; flex-direction: column;">
                    <div style="height: 140px; display: flex; align-items: center; justify-content: center; margin-bottom: 24px;">
                        <img src="{{ 'cc-v6-blueprint-product.webp' | asset_url }}" alt="Blueprint" style="max-height: 120px; max-width: 100%; object-fit: contain;" loading="lazy">
                    </div>
                    <p class="text-xs tracking-widest uppercase text-warm-gray mb-3" style="text-align: center;">Blueprint Core Stack</p>
                    <p style="text-align: center; font-family: 'Space Grotesk', sans-serif; font-size: 40px; font-weight: 500; color: #0A0A0A; line-height: 1; margin-bottom: 20px;">$361<span style="font-size: 16px; color: #6B6B6B; font-weight: 400;">/mo</span></p>
                    <div style="border-top: 1px solid #E8E8E8; padding-top: 20px; text-align: center; flex: 1;">
                        <p style="font-size: 14px; color: #6B6B6B; margin-bottom: 8px;">74 compounds across 7 products</p>
                        <p style="font-size: 14px; color: #6B6B6B; margin-bottom: 8px;">$12/day &middot; $4,332/year</p>
                        <p style="font-size: 12px; color: #C0392B; margin-top: 16px; line-height: 1.5;">Several ingredients have limited human data</p>
                    </div>
                </div>
            </div>

            <!-- CTA after comparison -->
            <div class="text-center mt-12">
                <a href="#pricing-product-apr26" class="btn-primary">Start the System &mdash; $99/mo</a>
            </div>

        </div>
    </section>


    <!-- SECTION 5: INGREDIENT DEEP DIVE -->
    <section class="py-20 lg:py-28 bg-white">
        <div class="max-w-5xl mx-auto px-6 sm:px-8">
            <div class="text-center mb-16 reveal" x-init="setTimeout(() => $el.classList.add('visible'), 100)" x-intersect="$el.classList.add('visible')">
                <p class="section-counter mb-6">The Coastline Formula</p>
                <div class="editorial-divider mx-auto mb-10"></div>
                <h2 class="text-3xl lg:text-4xl font-grotesk font-medium mb-4">13 ingredients. All clinically dosed. All backed by human trials.</h2>
                <p class="text-warm-gray text-lg max-w-xl mx-auto">{{ section.settings.ingredients_subheadline | default: 'Three products. One system. Optimized for your circadian rhythm.' }}</p>
            </div>

            <!-- Morning Blend -->
            <div class="mb-12 reveal" x-init="setTimeout(() => $el.classList.add('visible'), 100)" x-intersect="$el.classList.add('visible')">
                <div class="flex items-center gap-4 mb-6">
                    <div style="width: 64px; height: 64px; border-radius: 50%; overflow: hidden; background: #F5F4F0; flex-shrink: 0; display: flex; align-items: center; justify-content: center;">
                        <img src="https://cdn.shopify.com/s/files/1/0619/6861/3445/files/Creatine_Front2.png?v=1769024194" alt="Morning Blend" style="width: 100%; height: 100%; object-fit: cover;" loading="lazy">
                    </div>
                    <div>
                        <p class="text-xs tracking-widest uppercase text-warm-gray mb-1">Morning</p>
                        <p class="font-grotesk text-lg text-deep-ink font-medium">Morning Blend &mdash; 7 Ingredients</p>
                    </div>
                </div>
                <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
                    <div class="v6-ingredient-card"><img src="https://cdn.shopify.com/s/files/1/0619/6861/3445/files/CL-13IngredientImages-v1_10_2.png?v=1767986277" alt="Ergothioneine" class="w-12 h-12 mx-auto mb-3 object-cover" loading="lazy"><p>Ergothioneine</p><p>5 mg -- crosses blood-brain barrier</p></div>
                    <div class="v6-ingredient-card"><img src="https://cdn.shopify.com/s/files/1/0619/6861/3445/files/CL-13IngredientImages-v1_16_2.png?v=1767986425" alt="Taurine" class="w-12 h-12 mx-auto mb-3 object-cover" loading="lazy"><p>Taurine</p><p>3.05 g -- cardiovascular and lifespan support</p></div>
                    <div class="v6-ingredient-card"><img src="https://cdn.shopify.com/s/files/1/0619/6861/3445/files/CL-13IngredientImages-v1_2_a9a90961-637d-402f-856b-17493e2fe0d7.png?v=1767985945" alt="Creatine Monohydrate" class="w-12 h-12 mx-auto mb-3 object-cover" loading="lazy"><p>Creatine Monohydrate</p><p>5.25 g -- muscle strength and cognition</p></div>
                    <div class="v6-ingredient-card"><img src="https://cdn.shopify.com/s/files/1/0619/6861/3445/files/CL-13IngredientImages-v1_2_2.png?v=1767987227" alt="Glycine" class="w-12 h-12 mx-auto mb-3 object-cover" loading="lazy"><p>Glycine</p><p>5 g -- sleep quality and blood sugar</p></div>
                    <div class="v6-ingredient-card"><img src="https://cdn.shopify.com/s/files/1/0619/6861/3445/files/CL-13IngredientImages-v1_15_2.png?v=1767986618" alt="Inulin" class="w-12 h-12 mx-auto mb-3 object-cover" loading="lazy"><p>Inulin</p><p>4 g -- prebiotic gut health</p></div>
                    <div class="v6-ingredient-card"><img src="https://cdn.shopify.com/s/files/1/0619/6861/3445/files/CL-13IngredientImages-v1_12_2.png?v=1767986678" alt="Magnesium Citrate" class="w-12 h-12 mx-auto mb-3 object-cover" loading="lazy"><p>Magnesium (Citrate)</p><p>150 mg -- 300+ enzyme cofactor</p></div>
                    <div class="v6-ingredient-card"><img src="https://cdn.shopify.com/s/files/1/0619/6861/3445/files/CL-13IngredientImages-v1_14_2.png?v=1767986502" alt="Glucosamine Sulfate" class="w-12 h-12 mx-auto mb-3 object-cover" loading="lazy"><p>Glucosamine Sulfate</p><p>750 mg -- joint health (AM dose)</p></div>
                </div>
            </div>

            <!-- Softgels -->
            <div class="mb-12 reveal" x-init="setTimeout(() => $el.classList.add('visible'), 100)" x-intersect="$el.classList.add('visible')">
                <div class="flex items-center gap-4 mb-6">
                    <div style="width: 64px; height: 64px; border-radius: 50%; overflow: hidden; background: #F5F4F0; flex-shrink: 0; display: flex; align-items: center; justify-content: center;">
                        <img src="https://cdn.shopify.com/s/files/1/0619/6861/3445/files/SOFTGELBOTTLEW_CAPSULE.jpg?v=1764011188" alt="Softgels" style="width: 100%; height: 100%; object-fit: cover;" loading="lazy">
                    </div>
                    <div>
                        <p class="text-xs tracking-widest uppercase text-warm-gray mb-1">Morning</p>
                        <p class="font-grotesk text-lg text-deep-ink font-medium">Softgels &mdash; 4 Ingredients</p>
                    </div>
                </div>
                <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
                    <div class="v6-ingredient-card"><img src="https://cdn.shopify.com/s/files/1/0619/6861/3445/files/CL-13IngredientImages-v1_8_2.png?v=1767987168" alt="Astaxanthin" class="w-12 h-12 mx-auto mb-3 object-cover" loading="lazy"><p>Astaxanthin</p><p>6 mg -- potent antioxidant</p></div>

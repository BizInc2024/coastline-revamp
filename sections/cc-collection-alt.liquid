{% comment %}
  CC Collection Alt — Clean collection page with product info + subscription pricing
  No filtering, no sorting. Just products with details.
{% endcomment %}

{% render 'cc-deps' %}

<style>
  :where(.cc-coll) {
    --cc-bg: #FAF9F6;
    --cc-dark: #1a1a1a;
    --cc-muted: #6b7280;
    --cc-green: #1A3A2F;
    --cc-border: #e5e5e5;
    font-family: 'Space Grotesk', sans-serif;
    color: var(--cc-dark);
  }
  :where(.cc-coll) .cc-coll__hero {
    text-align: center;
    padding: 64px 24px 40px;
    max-width: 720px;
    margin: 0 auto;
  }
  :where(.cc-coll) .cc-coll__hero h1 {
    font-size: 2.25rem;
    font-weight: 600;
    letter-spacing: -0.02em;
    line-height: 1.15;
    margin: 0 0 12px;
  }
  :where(.cc-coll) .cc-coll__hero .cc-coll__desc {
    font-family: 'Inter', sans-serif;
    font-size: 0.95rem;
    line-height: 1.55;
    color: var(--cc-muted);
    margin: 0;
  }
  :where(.cc-coll) .cc-coll__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 48px;
    max-width: 1100px;
    margin: 0 auto;
    padding: 0 24px 80px;
  }
  :where(.cc-coll) .cc-coll__item {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0;
    align-items: stretch;
    background: #fff;
    border: 1px solid var(--cc-border);
    overflow: hidden;
  }
  :where(.cc-coll) .cc-coll__img-wrap {
    overflow: hidden;
    background: var(--cc-bg);
  }
  :where(.cc-coll) .cc-coll__img-wrap img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  :where(.cc-coll) .cc-coll__info {
    padding: 40px 36px;
    display: flex;
    flex-direction: column;
    justify-content: center;
  }
  :where(.cc-coll) .cc-coll__info h2 {
    font-size: 1.6rem;
    font-weight: 500;
    letter-spacing: -0.02em;
    margin: 0 0 6px;
    line-height: 1.2;
  }
  :where(.cc-coll) .cc-coll__tagline {
    font-family: 'Inter', sans-serif;
    font-size: 0.88rem;
    line-height: 1.65;
    color: var(--cc-muted);
    margin: 0 0 20px;
    font-weight: 400;
  }
  :where(.cc-coll) .cc-coll__divider {
    width: 40px;
    height: 1px;
    background: var(--cc-border);
    margin: 0 0 20px;
  }
  :where(.cc-coll) .cc-coll__ingredients {
    font-family: 'Inter', sans-serif;
    font-size: 0.78rem;
    color: var(--cc-green);
    font-weight: 500;
    line-height: 1.6;
    letter-spacing: 0.01em;
    margin: 0 0 24px;
  }
  :where(.cc-coll) .cc-coll__pricing {
    margin: 0 0 28px;
  }
  :where(.cc-coll) .cc-coll__price-row {
    display: flex;
    align-items: baseline;
    gap: 10px;
    margin-bottom: 5px;
  }
  :where(.cc-coll) .cc-coll__price-label {
    font-family: 'Inter', sans-serif;
    font-size: 0.72rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--cc-muted);
    min-width: 140px;
    font-weight: 400;
  }
  :where(.cc-coll) .cc-coll__price-label--sub {
    color: var(--cc-green);
    font-weight: 600;
  }
  :where(.cc-coll) .cc-coll__price-val {
    font-size: 1.15rem;
    font-weight: 600;
  }
  :where(.cc-coll) .cc-coll__price-val--sub {
    color: var(--cc-green);
    font-weight: 600;
  }
  :where(.cc-coll) .cc-coll__price-save {
    font-family: 'Inter', sans-serif;
    font-size: 0.72rem;
    color: var(--cc-green);
    font-weight: 500;
    letter-spacing: 0.02em;
  }
  :where(.cc-coll) .cc-coll__cta {
    display: inline-block;
    background: var(--cc-dark);
    color: #fff;
    padding: 14px 32px;
    text-decoration: none;
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    transition: opacity 0.2s;
    align-self: flex-start;
  }
  :where(.cc-coll) .cc-coll__cta:hover {
    opacity: 0.85;
  }

  /* Mobile */
  @media (max-width: 767px) {
    :where(.cc-coll) .cc-coll__hero {
      padding: 48px 20px 32px;
    }
    :where(.cc-coll) .cc-coll__hero h1 {
      font-size: 1.75rem;
    }
    :where(.cc-coll) .cc-coll__grid {
      gap: 32px;
      padding: 0 16px 60px;
    }
    :where(.cc-coll) .cc-coll__item {
      grid-template-columns: 1fr;
    }
    :where(.cc-coll) .cc-coll__info {
      padding: 28px 24px;
    }
    :where(.cc-coll) .cc-coll__info h2 {
      font-size: 1.4rem;
    }
  }
</style>

<div class="cc-coll">
  {%- comment -%} Collection Header {%- endcomment -%}
  <div class="cc-coll__hero">
    <h1>{{ collection.title }}</h1>
    <p class="cc-coll__desc">Every dose backed by science. Every ingredient fully transparent.<br>Choose individual products or get the complete system.</p>
  </div>

  {%- comment -%} Product List {%- endcomment -%}
  <div class="cc-coll__grid">
    {%- for product in collection.products -%}
      {%- assign featured = product.featured_image -%}
      {%- assign first_variant = product.selected_or_first_available_variant -%}
      {%- assign one_time_price = first_variant.price -%}
      {%- assign has_sub = false -%}
      {%- assign sub_price = 0 -%}
      {%- assign sub_save_pct = 0 -%}

      {%- for alloc in first_variant.selling_plan_allocations -%}
        {%- if has_sub == false or alloc.price < sub_price -%}
          {%- assign sub_price = alloc.price -%}
          {%- assign has_sub = true -%}
        {%- endif -%}
      {%- endfor -%}

      {%- if has_sub and sub_price > 0 -%}
        {%- assign saved = one_time_price | minus: sub_price -%}
        {%- if one_time_price > 0 -%}
          {%- assign sub_save_pct = saved | times: 100 | divided_by: one_time_price -%}
        {%- endif -%}
      {%- endif -%}

      {%- assign p_title = product.title | downcase -%}
      {%- assign p_handle = product.handle | downcase -%}
      {%- assign ing_text = '' -%}
      {%- assign romance_text = '' -%}

      {%- if p_title contains 'blend' or p_handle contains 'blend' -%}
        {%- assign romance_text = '7 science-backed ingredients in one easy-scoop powder. Take with your first meal to support energy, focus, and recovery.' -%}
        {%- assign ing_text = 'Ergothioneine 5 mg · Taurine 3.05 g · Creatine 5.25 g · Glycine 5 g · Inulin 4 g · Magnesium Citrate 150 mg · Glucosamine Sulfate 750 mg' -%}
      {%- elsif p_title contains 'softgel' or p_handle contains 'softgel' -%}
        {%- assign romance_text = '4 fat-soluble ingredients for cellular protection, eye health, and mitochondrial energy. One softgel with your first meal.' -%}
        {%- assign ing_text = 'Astaxanthin 6 mg · Lutein 10 mg · Zeaxanthin 2 mg · CoQ10 200 mg' -%}
      {%- elsif p_title contains 'capsule' or p_title contains 'evening' or p_handle contains 'evening' or p_handle contains 'capsule' -%}
        {%- assign romance_text = "3 targeted compounds timed for your body's overnight repair cycle. Take before bed to support deep sleep and calm the nervous system." -%}
        {%- assign ing_text = 'Lithium Orotate 400 mcg · L-Theanine 200 mg · Glucosamine Sulfate 750 mg' -%}
      {%- elsif p_title contains 'complete' or p_title contains 'welcome' or p_title contains 'system' or p_handle contains 'complete' or p_handle contains 'welcome' or p_handle contains 'system' or p_handle contains 'pack' -%}
        {%- assign romance_text = 'All 13 clinically dosed ingredients across 3 products. Morning and evening — timed for how your body actually works.' -%}
        {%- assign ing_text = 'Ergothioneine · Taurine · Creatine · Glycine · Inulin · Magnesium · Glucosamine · Astaxanthin · Lutein · Zeaxanthin · CoQ10 · L-Theanine · Lithium Orotate' -%}
      {%- endif -%}

      <div class="cc-coll__item">
        <div class="cc-coll__img-wrap">
          {%- if featured -%}
            <img
              src="{{ featured | image_url: width: 800 }}"
              alt="{{ product.title | escape }}"
              width="{{ featured.width }}"
              height="{{ featured.height }}"
              loading="{% if forloop.index <= 2 %}eager{% else %}lazy{% endif %}"
            />
          {%- endif -%}
        </div>

        <div class="cc-coll__info">
          <h2>{{ product.title }}</h2>

          {%- if romance_text != blank -%}
            <p class="cc-coll__tagline">{{ romance_text }}</p>
          {%- endif -%}

          <div class="cc-coll__divider"></div>

          {%- if ing_text != blank -%}
            <p class="cc-coll__ingredients">{{ ing_text }}</p>
          {%- endif -%}

          <div class="cc-coll__pricing">
            {%- if has_sub and sub_price -%}
              <div class="cc-coll__price-row">
                <span class="cc-coll__price-label cc-coll__price-label--sub">Subscribe & save</span>
                <span class="cc-coll__price-val cc-coll__price-val--sub">{{ sub_price | money }}/mo</span>
                {%- if sub_save_pct > 0 -%}
                  <span class="cc-coll__price-save">Save {{ sub_save_pct }}%</span>
                {%- endif -%}
              </div>
            {%- endif -%}
            <div class="cc-coll__price-row">
              <span class="cc-coll__price-label">One-time</span>
              <span class="cc-coll__price-val">{{ one_time_price | money }}</span>
            </div>
          </div>

          <a href="{{ product.url }}" class="cc-coll__cta">View Product</a>
        </div>
      </div>
    {%- endfor -%}
  </div>
</div>

{% schema %}
{
  "name": "CC Collection Alt",
  "tag": "section",
  "settings": []
}
{% endschema %}

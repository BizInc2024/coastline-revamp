{%- comment -%}
  cc-math-apr26 — Do the Math
  Extracted from cc-homepage.liquid (Apr 26 rebuild, vanilla re-scope)
{%- endcomment -%}

{% render 'cc-deps' %}

<div class="cc-apr26 cc-math-apr26">
    <section class="reveal" x-init="setTimeout(() => $el.classList.add('visible'), 100)" style="background-color:#0A0A0A;padding-top:80px;padding-bottom:80px;" x-intersect.once="$el.classList.add('visible')">
      <div class="max-w-3xl mx-auto px-8 lg:px-16 text-center">
        <span style="font-family:'Inter',sans-serif;font-size:11px;letter-spacing:0.15em;text-transform:uppercase;color:#555555;display:block;margin-bottom:20px;">THE VALUE</span>
        <div style="width:60px;height:1px;background:#333333;margin:0 auto 40px;"></div>
        <h2 style="font-family:'Space Grotesk',sans-serif;font-weight:500;color:#FAF9F6;line-height:1.15;letter-spacing:-0.02em;font-size:clamp(22px,4vw,44px);margin-bottom:16px;">Incredible value.<br>Premium system.</h2>
        <p style="font-family:'Inter',sans-serif;font-size:17px;color:#9A9A9A;line-height:1.7;max-width:32rem;margin:0 auto 48px;">What would it actually cost to buy all 13 clinical-dose ingredients individually?</p>
  
        <div x-data="{ showBreakdown: false }" style="max-width:480px;margin:0 auto;">
          <button id="cc-dothemath-toggle" type="button" @click="showBreakdown = !showBreakdown; if(!showBreakdown) { $nextTick(() => { document.getElementById('cc-dothemath-toggle').scrollIntoView({ behavior: 'smooth', block: 'center' }) }) }" style="display:block;width:100%;background:none;border:none;cursor:pointer;padding:24px 0;font-family:'Space Grotesk',sans-serif;text-align:center;">
            <span style="display:block;font-size:16px;font-weight:500;color:#E7FF56;margin-bottom:14px;" x-text="showBreakdown ? 'Hide breakdown' : 'See the full breakdown'"></span>
            <span style="display:flex;justify-content:center;"><svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="#E7FF56" stroke-width="2.5" style="transition:transform 0.3s ease;" :style="showBreakdown ? 'transform:rotate(180deg)' : ''"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/></svg></span>
          </button>
  
          <div x-show="showBreakdown" x-collapse x-cloak>
            <div style="text-align:left;padding:0;">
              <div style="display:flex;justify-content:space-between;padding:12px 0;border-bottom:1px solid #222222;"><span style="font-family:'Inter',sans-serif;font-size:14px;color:#9A9A9A;">Creatine Monohydrate <span style="color:#555555;font-size:12px;">5.25g/day</span></span><span style="font-family:'Space Grotesk',sans-serif;font-size:14px;color:#FAF9F6;">$25</span></div>
              <div style="display:flex;justify-content:space-between;padding:12px 0;border-bottom:1px solid #222222;"><span style="font-family:'Inter',sans-serif;font-size:14px;color:#9A9A9A;">Glycine <span style="color:#555555;font-size:12px;">5g/day</span></span><span style="font-family:'Space Grotesk',sans-serif;font-size:14px;color:#FAF9F6;">$15</span></div>
              <div style="display:flex;justify-content:space-between;padding:12px 0;border-bottom:1px solid #222222;"><span style="font-family:'Inter',sans-serif;font-size:14px;color:#9A9A9A;">Inulin <span style="color:#555555;font-size:12px;">4g/day</span></span><span style="font-family:'Space Grotesk',sans-serif;font-size:14px;color:#FAF9F6;">$12</span></div>
              <div style="display:flex;justify-content:space-between;padding:12px 0;border-bottom:1px solid #222222;"><span style="font-family:'Inter',sans-serif;font-size:14px;color:#9A9A9A;">Taurine <span style="color:#555555;font-size:12px;">3.05g/day</span></span><span style="font-family:'Space Grotesk',sans-serif;font-size:14px;color:#FAF9F6;">$18</span></div>
              <div style="display:flex;justify-content:space-between;padding:12px 0;border-bottom:1px solid #222222;"><span style="font-family:'Inter',sans-serif;font-size:14px;color:#9A9A9A;">Magnesium Citrate <span style="color:#555555;font-size:12px;">150mg/day</span></span><span style="font-family:'Space Grotesk',sans-serif;font-size:14px;color:#FAF9F6;">$10</span></div>
              <div style="display:flex;justify-content:space-between;padding:12px 0;border-bottom:1px solid #222222;"><span style="font-family:'Inter',sans-serif;font-size:14px;color:#9A9A9A;">Ergothioneine <span style="color:#555555;font-size:12px;">5mg/day</span></span><span style="font-family:'Space Grotesk',sans-serif;font-size:14px;color:#FAF9F6;">$35</span></div>
              <div style="display:flex;justify-content:space-between;padding:12px 0;border-bottom:1px solid #222222;"><span style="font-family:'Inter',sans-serif;font-size:14px;color:#9A9A9A;">CoQ10 <span style="color:#555555;font-size:12px;">200mg/day</span></span><span style="font-family:'Space Grotesk',sans-serif;font-size:14px;color:#FAF9F6;">$30</span></div>
              <div style="display:flex;justify-content:space-between;padding:12px 0;border-bottom:1px solid #222222;"><span style="font-family:'Inter',sans-serif;font-size:14px;color:#9A9A9A;">Lutein <span style="color:#555555;font-size:12px;">10mg/day</span></span><span style="font-family:'Space Grotesk',sans-serif;font-size:14px;color:#FAF9F6;">$15</span></div>
              <div style="display:flex;justify-content:space-between;padding:12px 0;border-bottom:1px solid #222222;"><span style="font-family:'Inter',sans-serif;font-size:14px;color:#9A9A9A;">Astaxanthin <span style="color:#555555;font-size:12px;">6mg/day</span></span><span style="font-family:'Space Grotesk',sans-serif;font-size:14px;color:#FAF9F6;">$20</span></div>
              <div style="display:flex;justify-content:space-between;padding:12px 0;border-bottom:1px solid #222222;"><span style="font-family:'Inter',sans-serif;font-size:14px;color:#9A9A9A;">Zeaxanthin <span style="color:#555555;font-size:12px;">2mg/day</span></span><span style="font-family:'Space Grotesk',sans-serif;font-size:14px;color:#FAF9F6;">$12</span></div>
              <div style="display:flex;justify-content:space-between;padding:12px 0;border-bottom:1px solid #222222;"><span style="font-family:'Inter',sans-serif;font-size:14px;color:#9A9A9A;">Glucosamine <span style="color:#555555;font-size:12px;">750mg/day</span></span><span style="font-family:'Space Grotesk',sans-serif;font-size:14px;color:#FAF9F6;">$15</span></div>
              <div style="display:flex;justify-content:space-between;padding:12px 0;border-bottom:1px solid #222222;"><span style="font-family:'Inter',sans-serif;font-size:14px;color:#9A9A9A;">L-Theanine <span style="color:#555555;font-size:12px;">200mg/day</span></span><span style="font-family:'Space Grotesk',sans-serif;font-size:14px;color:#FAF9F6;">$12</span></div>
              <div style="display:flex;justify-content:space-between;padding:12px 0;"><span style="font-family:'Inter',sans-serif;font-size:14px;color:#9A9A9A;">Lithium Orotate <span style="color:#555555;font-size:12px;">400mcg/day</span></span><span style="font-family:'Space Grotesk',sans-serif;font-size:14px;color:#FAF9F6;">$10</span></div>
  
              <div style="display:flex;justify-content:space-between;align-items:center;padding:20px 0;border-top:2px solid #333333;margin-top:8px;">
                <span style="font-family:'Space Grotesk',sans-serif;font-size:16px;font-weight:500;color:#FAF9F6;">Total bought separately</span>
                <span style="font-family:'Space Grotesk',sans-serif;font-size:24px;font-weight:600;color:#FAF9F6;text-decoration:line-through;text-decoration-color:#555555;">$229/mo</span>
              </div>
  
              <div style="text-align:center;padding:16px 0 8px;">
                <a href="#cc-home-pricing" style="display:inline-block;padding:16px 40px;font-family:'Space Grotesk',sans-serif;font-weight:500;font-size:12px;letter-spacing:0.18em;text-transform:uppercase;color:#FAF9F6;border:1px solid #FAF9F6;text-decoration:none;transition:all 0.3s ease;background:transparent;">SEE PRICING</a>
              </div>
              <div style="text-align:center;padding:12px 0 24px;">
                <button type="button" @click="showBreakdown = false; $nextTick(() => { document.getElementById('cc-dothemath-toggle').scrollIntoView({ behavior: 'smooth', block: 'center' }) })" style="background:none;border:none;cursor:pointer;font-family:'Inter',sans-serif;font-size:13px;color:#9A9A9A;text-decoration:underline;text-underline-offset:3px;transition:color 0.2s ease;" onmouseover="this.style.color='#FAF9F6'" onmouseout="this.style.color='#9A9A9A'">Close breakdown</button>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>
</div>


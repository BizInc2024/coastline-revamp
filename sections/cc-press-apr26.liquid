<style>
.cc-press-apr26 .cc-press-marquee { overflow: hidden; width: 100%; opacity: 0.4; filter: grayscale(100%); }
.cc-press-apr26 .cc-press-track { display: flex; gap: 48px; align-items: center; animation: cc-marquee 30s linear infinite; width: max-content; }
.cc-press-apr26 .cc-press-track a { flex-shrink: 0; text-decoration: none; display: flex; align-items: center; }
.cc-press-apr26 .cc-press-track:hover { animation-play-state: paused; }
@media (max-width: 767px) {
    .cc-press-apr26 .cc-press-track { animation-duration: 18s; gap: 32px; }
  }
</style>


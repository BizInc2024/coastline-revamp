        <img src="{% if section.settings.breaker_image_2 != blank %}{{ section.settings.breaker_image_2 | image_url: width: 1600 }}{% else %}https://cdn.shopify.com/s/files/1/0619/6861/3445/files/CL-Landing_Page_Images-11_2_1.png?v=1769557907{% endif %}" alt="" class="w-full" style="max-height: 50vh; object-fit: cover;" loading="lazy">
    </div>

    <!-- SECTION 12: EMAIL CAPTURE -->
    <section class="py-20 lg:py-28 reveal" style="background-color: #062F3D;" x-init="setTimeout(() => $el.classList.add('visible'), 100)" x-intersect="$el.classList.add('visible')">
        <div class="max-w-2xl mx-auto px-6 sm:px-8 text-center">
            <p class="text-xs tracking-widest uppercase mb-4" style="color: rgba(250,249,246,0.5);">{{ section.settings.email_capture_label | default: 'Not Ready Yet?' }}</p>
            <h3 class="font-grotesk font-medium mb-4 leading-tight" style="color: #FAF9F6; font-size: clamp(24px, 4vw, 36px);">
                {{ section.settings.email_capture_headline | default: "We will send you the research." }}
            </h3>
            <p class="mb-10 mx-auto" style="color: rgba(250,249,246,0.6); font-size: 15px; max-width: 460px; line-height: 1.7;">
                {{ section.settings.email_capture_body | default: "No pressure. We will send you the science behind our 13 ingredients so you can decide on your own time." }}
            </p>
            <form class="flex flex-col sm:flex-row gap-3 max-w-xl mx-auto" @submit.prevent="
                var email = $event.target.querySelector('input[type=email]').value;
                if (email) {
                    $event.target.querySelector('button').textContent = 'SENDING...';
                    fetch('/contact', { method: 'POST', headers: { 'Content-Type': 'application/x-www-form-urlencoded' }, body: 'form_type=customer&utf8=%E2%9C%93&contact%5Bemail%5D=' + encodeURIComponent(email) + '&contact%5Btags%5D=newsletter%2Cnurture-blueprint-comparison' })
                    .then(function(response) { if (response.ok || response.redirected) { $event.target.innerHTML = '<p style=&quot;color: #FAF9F6; font-size: 17px; font-weight: 500;&quot;>You are in. Check your inbox.</p>'; } else { $event.target.querySelector('button').textContent = 'TRY AGAIN'; } })
                    .catch(function() { $event.target.querySelector('button').textContent = 'SOMETHING WENT WRONG'; });
                }
            ">
                <input type="email" placeholder="Your email address" required class="flex-1 px-6 py-5 text-base" style="background: rgba(255,255,255,0.08); border: 1px solid rgba(250,249,246,0.2); color: #FAF9F6; font-family: 'Inter', sans-serif; outline: none; min-width: 0;">
                <button type="submit" class="whitespace-nowrap" style="background-color: #FAF9F6; color: #062F3D; font-family: 'Space Grotesk', sans-serif; font-weight: 500; font-size: 12px; letter-spacing: 0.18em; text-transform: uppercase; padding: 20px 40px; border: none; cursor: pointer; transition: opacity 0.3s ease;">
                    {{ section.settings.email_capture_cta | default: 'Send Me The Research' }}
                </button>
            </form>
        </div>
    </section>

    <!-- SECTION 13: FOOTER -->
    <footer class="py-32 lg:py-40 bg-deep-ink">
        <div class="max-w-4xl mx-auto px-8 lg:px-16 text-center">
            <img src="{% if section.settings.footer_logo != blank %}{{ section.settings.footer_logo | image_url: width: 800 }}{% else %}{{ 'cc-v3-logo-white.png' | asset_url }}{% endif %}" alt="Coastline Longevity" class="h-48 lg:h-60 mx-auto mb-12">
            <p class="text-lg lg:text-xl text-gray-400 max-w-xl mx-auto leading-relaxed mb-16">{{ section.settings.footer_tagline | default: 'Science-backed longevity, simplified. 13 ingredients optimized for morning, day, and night.' }}</p>
            <a href="#v6-plan-selector" class="cc-v6-footer-cta" style="display: inline-block !important; width: auto !important; background-color: var(--parchment) !important; color: var(--deep-ink) !important; font-family: 'Space Grotesk', sans-serif; font-weight: 500; font-size: 12px; letter-spacing: 0.18em; text-transform: uppercase; padding: 20px 48px !important; text-decoration: none; transition: opacity 0.3s ease; line-height: 1; border: none; border-radius: 0;">
                {{ section.settings.footer_cta_text | default: 'Switch from Blueprint - $99/mo' }}
            </a>
            <div style="padding-top: 80px;"><div style="height: 1px; background-color: #333; max-width: 400px; margin: 0 auto;"></div></div>
            <div style="height: 40px;"></div>
            <p style="font-size: 11px; color: #666; line-height: 1.8; max-width: 500px; margin: 0 auto;">{{ section.settings.footer_disclaimer | default: 'These statements have not been evaluated by the Food and Drug Administration. This product is not intended to diagnose, treat, cure, or prevent any disease. Individual results may vary.' }}</p>
            <p style="font-size: 10px; color: #444; line-height: 1.6; margin-top: 16px;">Individual testimonials are not representative of typical outcomes.</p>
            <p style="font-size: 10px; color: #444; line-height: 1.6; margin-top: 8px;">{{ section.settings.ag1_disclaimer | default: 'Blueprint is a trademark of Bryan Johnson. Coastline is not affiliated with, endorsed by, or connected to Blueprint or Bryan Johnson. All comparisons are based on publicly available information.' }}</p>
        </div>
    </footer>


</div>

<!-- Anchor scrolling -->
<script>
  document.addEventListener('DOMContentLoaded', function() {
    document.querySelectorAll('.cc-landing-v6 a[href^="#"]').forEach(function(link) {
      link.addEventListener('click', function(e) {
        var targetId = this.getAttribute('href');
        if (!targetId || targetId === '#') return;
        var target = document.querySelector(targetId);
        if (target) {
          e.preventDefault();
          var wrapper = document.querySelector('.cc-landing-v6');
          if (wrapper) { wrapper.querySelectorAll('img[loading="lazy"]').forEach(function(img) { if (img.getBoundingClientRect().top < target.getBoundingClientRect().top) { img.loading = 'eager'; } }); }
          var reveals = []; var el = target;
          while (el && !el.classList.contains('cc-landing-v6')) { if (el.classList.contains('reveal')) reveals.push(el); el = el.parentElement; }
          if (target.classList.contains('reveal')) reveals.push(target);
          reveals.forEach(function(r) { r.style.transition = 'none'; r.classList.add('visible'); r.style.opacity = '1'; r.style.transform = 'none'; });
          void target.offsetHeight;
          var rect = target.getBoundingClientRect();
          var scrollTop = window.pageYOffset || document.documentElement.scrollTop;
          var dest = scrollTop + rect.top; var start = scrollTop; var distance = dest - start; var duration = 600; var startTime = null;
          function smoothStep(time) {
            if (!startTime) startTime = time;
            var progress = Math.min((time - startTime) / duration, 1);
            var ease = progress < 0.5 ? 2 * progress * progress : -1 + (4 - 2 * progress) * progress;
            window.scrollTo(0, start + distance * ease);
            if (progress < 1) { requestAnimationFrame(smoothStep); }
            else { reveals.forEach(function(r) { r.style.transition = ''; }); setTimeout(function() { var finalRect = target.getBoundingClientRect(); if (Math.abs(finalRect.top) > 5) { window.scrollTo(0, window.pageYOffset + finalRect.top); } }, 100); }
          }
          requestAnimationFrame(smoothStep);
        }
      });
    });
  });
</script>


{%- comment -%}
  cc-pdp-experts-apr26 — Expert quote 2-col grid
  Block-based: each block = one expert (quote, name, credential, portrait).
{%- endcomment -%}

{% render 'cc-deps' %}

<div class="cc-apr26 cc-pdp-experts-apr26">
  <section class="reveal" style="padding-top:80px;padding-bottom:80px;background:var(--parchment);">
    <div class="cc-exp-wrap">

      <div class="cc-exp-head">
        <p class="cc-exp-eyebrow">{{ section.settings.label | default: "EXPERT VALIDATION" }}</p>
        <h2 class="cc-exp-h2">{{ section.settings.headline | default: "Trusted by leading health researchers" }}</h2>
      </div>

      {%- assign fb_portraits = 'https://cdn.shopify.com/s/files/1/0619/6861/3445/files/Greg_Portrait.webp?v=1767053015,https://cdn.shopify.com/s/files/1/0619/6861/3445/files/Jessicabodasphotography-jacques.webp?v=1767053015,https://cdn.shopify.com/s/files/1/0619/6861/3445/files/Nic_Portrait.webp?v=1767053015,https://cdn.shopify.com/s/files/1/0619/6861/3445/files/CL-ChrisP-Scientist.webp?v=1767053015' | split: ',' -%}

      <div class="cc-exp-grid">
        {%- for block in section.blocks -%}
          {%- if block.type == 'expert' -%}
            {%- assign fb_idx = forloop.index0 | modulo: 4 -%}
            <article class="cc-exp-card" {{ block.shopify_attributes }}>
              <span class="cc-exp-quote-mark">&ldquo;</span>
              <p class="cc-exp-quote">{{ block.settings.quote }}</p>
              <div class="cc-exp-byline">
                {%- if block.settings.portrait != blank -%}
                  <img src="{{ block.settings.portrait | image_url: width: 144 }}" alt="{{ block.settings.name | escape }}" class="cc-exp-portrait" loading="lazy">
                {%- else -%}
                  <img src="{{ fb_portraits[fb_idx] }}" alt="{{ block.settings.name | escape }}" class="cc-exp-portrait" loading="lazy">
                {%- endif -%}
                <div>
                  <p class="cc-exp-name">{{ block.settings.name }}</p>
                  <p class="cc-exp-cred">{{ block.settings.credential }}</p>
                </div>
              </div>
            </article>
          {%- endif -%}
        {%- endfor -%}
      </div>

    </div>
  </section>
</div>

<style>
  .cc-pdp-experts-apr26 .cc-exp-wrap { max-width: 1000px; margin: 0 auto; padding: 0 24px; }
  .cc-pdp-experts-apr26 .cc-exp-head { text-align: center; margin-bottom: 48px; }
  .cc-pdp-experts-apr26 .cc-exp-eyebrow {
    font-family: 'Inter', sans-serif; font-size: 12px; font-weight: 600; letter-spacing: 0.12em; text-transform: uppercase; color: var(--warm-gray); margin: 0 0 20px; display: inline-block;
  }
  .cc-pdp-experts-apr26 .cc-exp-h2 {
    font-family: 'Space Grotesk', sans-serif; font-size: clamp(26px, 4.5vw, 44px); font-weight: 500; letter-spacing: -0.02em; line-height: 1.15; color: var(--deep-ink); margin: 0;
  }
  .cc-pdp-experts-apr26 .cc-exp-grid {
    display: grid; grid-template-columns: 1fr; gap: 24px;
  }
  @media (min-width: 768px) {
    .cc-pdp-experts-apr26 .cc-exp-grid { grid-template-columns: repeat(2, 1fr); }
  }
  .cc-pdp-experts-apr26 .cc-exp-card { padding: 40px; border: 1px solid var(--light-gray); background: #fff; }
  .cc-pdp-experts-apr26 .cc-exp-quote-mark {
    font-family: Georgia, serif; font-size: 48px; line-height: 1; color: var(--light-gray); display: block; margin-bottom: 16px;
  }
  .cc-pdp-experts-apr26 .cc-exp-quote {
    font-family: 'Inter', sans-serif; font-size: 17px; color: var(--deep-ink); line-height: 1.65; margin: 0 0 24px; font-style: italic;
  }
  .cc-pdp-experts-apr26 .cc-exp-byline { display: flex; align-items: center; gap: 16px; }
  .cc-pdp-experts-apr26 .cc-exp-portrait {
    width: 72px; height: 72px; border-radius: 9999px; object-fit: cover; flex-shrink: 0;
  }
  .cc-pdp-experts-apr26 .cc-exp-name {
    font-family: 'Space Grotesk', sans-serif; font-weight: 600; font-size: 16px; color: var(--deep-ink); margin: 0 0 2px; line-height: 1.3;
  }
  .cc-pdp-experts-apr26 .cc-exp-cred {
    font-family: 'Inter', sans-serif; font-size: 13px; color: var(--warm-gray); margin: 0; line-height: 1.4;
  }
</style>

{% schema %}
{
  "name": "PDP Experts (apr26)",
  "tag": "section",
  "class": "section-cc-pdp-experts-apr26",
  "settings": [
    { "type": "text", "id": "label", "label": "Eyebrow label", "default": "EXPERT VALIDATION" },
    { "type": "text", "id": "headline", "label": "Headline", "default": "Trusted by leading health researchers" }
  ],
  "blocks": [
    {
      "type": "expert",
      "name": "Expert",
      "settings": [
        { "type": "textarea", "id": "quote", "label": "Quote" },
        { "type": "text", "id": "name", "label": "Name" },
        { "type": "text", "id": "credential", "label": "Credential / role" },
        { "type": "image_picker", "id": "portrait", "label": "Portrait (optional)" }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [
    { "name": "PDP Experts (apr26)", "category": "Coastline" }
  ]
}
{% endschema %}
